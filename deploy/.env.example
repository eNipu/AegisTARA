# Copy to deploy/.env and fill in. Never commit the real file.

# Letters, digits, `-`, `_`, `.` only: it is placed in a connection URL.
POSTGRES_PASSWORD=

# The company identity provider (OIDC).
AEGIS_OIDC_ISSUER=https://login.example.com/realms/aegis
AEGIS_OIDC_AUDIENCE=aegistara
# The URL clients use to reach this server. DPoP proofs are bound to it.
AEGIS_PUBLIC_URL=https://aegis.example.com

# Offline sites: the server image loaded from the offline bundle (docs/deployment.md).
# AEGIS_SERVER_IMAGE=aegistara-server:1.0.0

# RUST_LOG=info
