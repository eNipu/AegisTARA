// Small building blocks shared by the pages (job 040).
//
// Every widget here only shows what it is given and reports what the user
// did; the client core decides everything else.
import { Button, ComboBox, CheckBox, LineEdit, StandardTableView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ProjectItem {
    id: string,
    name: string,
    methodology: string,
}

// One translation of a description (FND-04): a language tag and the text.
export struct TranslationItem {
    lang: string,
    text: string,
}

// One description box of the page: which element it is for, its text, and
// who wrote it.
export struct DescriptionItem {
    kind: string,
    text: string,
    by: string,
    translations: [TranslationItem],
}

export struct ThreatItem {
    name: string,
    asset: string,
    inherent: string,
    residual: string,
    // 0 not rated, 1 very low ... 4 high (colors of the rating buckets)
    inherent-tone: int,
    residual-tone: int,
    selected: bool,
}

// A labelled drop-down: label, choices, the chosen position.
export struct FactorItem {
    label: string,
    // "Not rated" (or "None") first, then the choices
    options: [string],
    selected: int,
}

export struct NoticeItem {
    id: int,
    // 0 info, 1 warning, 2 error
    severity: int,
    text: string,
    // 0 none, 1 Undo, 2 Redo
    action: int,
}

// A related entity: a click leads to it.
export struct LinkItem {
    label: string,
    detail: string,
    tone: int,
}

export struct CheckItem {
    label: string,
    checked: bool,
}

export struct MitigationItem {
    name: string,
    // position in the feasibility levels
    level: int,
}

export struct CountItem {
    label: string,
    count: int,
    tone: int,
}

export struct DiffItem {
    kind: string,
    text: string,
}

export struct ProblemItem {
    error: bool,
    text: string,
}

export struct SuggestionItem {
    label: string,
    detail: string,
    kind: string,
    selected: bool,
}

// A drop-down whose shown choice always follows the view model. A plain
// ComboBox loses its binding once the user picks something, so a later change
// from the engine (an undo, another editor) would not show.
export component Choice inherits VerticalLayout {
    in property <[string]> options;
    in property <int> index;
    in property <bool> editable: true;
    in property <string> label;
    callback picked(int);

    box := ComboBox {
        model: root.options;
        current-index: root.index;
        enabled: root.editable;
        accessible-label: root.label;
        selected(v) => { root.picked(self.current-index); }
    }
    changed index => { box.current-index = root.index; }
    changed options => { box.current-index = root.index; }
}

// A table whose selected row follows the view model.
export component Table inherits VerticalLayout {
    in property <[TableColumn]> columns;
    in property <[[StandardListViewItem]]> rows;
    in property <int> selected: -1;
    in property <string> label;
    callback picked(int);

    tv := StandardTableView {
        vertical-stretch: 1;
        // The style gives a table a minimum width of 400px, which clips it in
        // a narrow panel (the attack tree list is 290px). The columns share
        // the width they get; a table that is too narrow scrolls sideways.
        min-width: 0px;
        columns: root.columns;
        rows: root.rows;
        accessible-label: root.label;
        current-row-changed(r) => {
            if (r != root.selected) { root.picked(r); }
        }
    }
    changed selected => { tv.set-current-row(root.selected); }
    init => { tv.set-current-row(root.selected); }
}

// The main button of a confirmation that cannot be undone (UI-12): red, so it
// is not mistaken for a safe default. It is not focused first, so Enter does
// not trigger it unless the user has moved focus to it.
export component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width: 96px;
    height: 32px;
    border-radius: 4px;
    background: ta.has-hover || fs.has-focus ? #8F1D17 : #B3261E;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.ink;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: #FFFFFF;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A field error: next to the field, in the error colour with an icon, never in a
// dialog (UI-10.11). The icon means the message does not rely on colour alone.
export component FieldError inherits HorizontalLayout {
    in property <string> text;
    spacing: 6px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Image {
        source: @image-url("icons/circle-alert.svg");
        width: 14px;
        height: 14px;
        y: 1px;
        colorize: Theme.high;
    }
    Text {
        text: root.text;
        color: Theme.high;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component SectionTitle inherits Text {
    font-size: Theme.font-label;
    font-weight: Theme.weight-bold;
    letter-spacing: Theme.tracking-label;
    color: Theme.ink;
}

export component PageTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    spacing: 10px;
    padding-bottom: 4px;
    Image {
        source: root.icon;
        width: 22px;
        height: 22px;
        y: 4px;
        colorize: Theme.accent;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Theme.font-display;
            font-weight: Theme.weight-heavy;
            letter-spacing: Theme.tracking-tight;
            color: Theme.ink;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: Theme.font-body;
            font-weight: Theme.weight-medium;
            color: Theme.graphite;
            wrap: word-wrap;
        }
    }
    @children
}

// Dark-mode tactical obsidian splash screen window header banner.
// Uses the brand color system (#14181D -> #0B0D10 obsidian gradient,
// #E04F26 -> #C83E1B tungsten crimson-amber reticle bar, #8C99A6 tactical
// slate datum telemetry, and the wide AegisTARA splash header graphic).
export component SplashHeader inherits Rectangle {
    in property <string> badge-text: @tr("ISO/SAE 21434 · UN R155");
    in property <string> status-text: @tr("");
    in property <color> status-color: Theme.crimson-bright;
    in property <length> banner-height: 136px;

    height: root.banner-height;
    clip: true;
    background: @linear-gradient(180deg, Theme.obsidian-core 0%, Theme.obsidian-edge 100%);

    // Top tungsten crimson-amber precision accent bar.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 2px;
        background: @linear-gradient(90deg, Theme.crimson-deep 0%, Theme.crimson-bright 50%, Theme.crimson-deep 100%);
    }

    // Subtle horizontal tactical datum hairline across the obsidian field.
    Rectangle {
        x: 16px;
        y: 26px;
        width: parent.width - 32px;
        height: 1px;
        background: #28313B80;
    }

    // Telemetry header micro-bar (left standard badge, right live status).
    Text {
        x: 16px;
        y: 6px;
        height: 16px;
        text: root.badge-text;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-bold;
        letter-spacing: Theme.tracking-header;
        color: Theme.slate-light;
        vertical-alignment: center;
    }
    if root.status-text != "": HorizontalLayout {
        x: parent.width - self.preferred-width - 16px;
        y: 6px;
        height: 16px;
        spacing: 6px;
        Rectangle {
            width: 6px;
            height: 6px;
            y: 5px;
            border-radius: 3px;
            background: root.status-color;
        }
        Text {
            text: root.status-text;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-heavy;
            letter-spacing: Theme.tracking-header;
            color: Theme.platinum;
            vertical-alignment: center;
        }
    }

    // Hero reticle + AegisTARA wordmark + subtitle.
    Image {
        x: 12px;
        y: 24px;
        width: parent.width - 24px;
        height: parent.height - 28px;
        source: @image-url("brand/AegisTARA_Splash_Header_960x360.png");
        image-fit: contain;
    }

    // Bottom datum hairline with centered tungsten reticle tick.
    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.obsidian-rule;
    }
    Rectangle {
        x: (parent.width - 72px) / 2;
        y: parent.height - 2px;
        width: 72px;
        height: 2px;
        background: Theme.crimson-bright;
    }
}

// A framed area with padding.
// The description of an element (or the notes of the project), shown as
// text. It is edited in a window of its own: a text box on the page would
// keep the Tab key for itself and trap a keyboard user.
export component DescriptionBox inherits VerticalLayout {
    in property <string> label: @tr("Description");
    in property <string> text;
    in property <string> by;
    in property <bool> editable;
    callback edit-requested();
    spacing: 4px;
    HorizontalLayout {
        height: 30px;
        spacing: 6px;
        SectionTitle { text: root.label; vertical-alignment: center; horizontal-stretch: 1; }
        Button {
            width: 64px;
            text: root.text == "" ? "Add" : "Edit";
            enabled: root.editable;
            accessible-label: (root.text == "" ? "Add " : "Edit ") + root.label;
            clicked => { root.edit-requested(); }
        }
    }
    // Long text is cut here; the edit window shows all of it.
    Text {
        text: root.text == "" ? "None yet." : root.text;
        color: root.text == "" ? Theme.graphite : Theme.ink;
        font-size: Theme.font-body;
        font-weight: root.text == "" ? Theme.weight-regular : Theme.weight-medium;
        wrap: word-wrap;
        overflow: elide;
        max-height: 110px;
        accessible-role: AccessibleRole.text;
        accessible-label: root.label + ": " + (root.text == "" ? "none yet" : root.text);
    }
    if root.by != "": Text { text: root.by; color: Theme.graphite; font-size: Theme.font-caption; font-weight: Theme.weight-medium; wrap: word-wrap; }
    @children
}

// Inline translation editor under a description (job 069, FND-04): shows the
// existing translations and adds or clears one. No dialog; the draft saves on
// the button, and an empty text clears the translation.
export component TranslationEditor inherits VerticalLayout {
    in property <[TranslationItem]> items;
    in property <bool> editable;
    in-out property <string> draft-lang: "ja";
    in-out property <string> draft-text;
    callback save(string, string);
    callback remove(string);
    spacing: 4px;
    for t in root.items: HorizontalLayout {
        spacing: 6px;
        Text {
            text: t.lang + ": " + t.text;
            color: Theme.ink;
            font-size: Theme.font-body;
            wrap: word-wrap;
            horizontal-stretch: 1;
            accessible-role: AccessibleRole.text;
            accessible-label: @tr("Translation") + " " + t.lang;
        }
        Button {
            text: @tr("Remove");
            width: 76px;
            enabled: root.editable;
            clicked => { root.remove(t.lang); }
        }
    }
    if root.editable: HorizontalLayout {
        spacing: 6px;
        LineEdit {
            width: 80px;
            text <=> root.draft-lang;
            accessible-label: @tr("Language tag");
        }
        LineEdit {
            horizontal-stretch: 1;
            placeholder-text: @tr("Translation text");
            text <=> root.draft-text;
            accessible-label: @tr("Translation text");
            accepted(t) => { root.save(root.draft-lang, t); root.draft-text = ""; }
        }
        Button {
            text: @tr("Save");
            enabled: root.draft-text != "";
            clicked => { root.save(root.draft-lang, root.draft-text); root.draft-text = ""; }
        }
    }
}

export component Panel inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.rule;
    border-radius: 2px;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        @children
    }
}

export component Swatch inherits Rectangle {
    in property <int> tone;
    width: 12px;
    height: 12px;
    background: Theme.tone(root.tone);
}

// A vertical list of related entities; a click reports the position.
export component LinkList inherits VerticalLayout {
    in property <[LinkItem]> items;
    in property <string> empty-text: @tr("None.");
    callback clicked(int);
    spacing: 2px;
    if root.items.length == 0: Text { text: root.empty-text; color: Theme.graphite; font-size: Theme.font-label; }
    for item[i] in root.items: Rectangle {
        height: 30px;
        background: area.has-hover ? Theme.wash : transparent;
        border-radius: 2px;
        accessible-role: button;
        accessible-label: item.label;
        accessible-action-default => { root.clicked(i); }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            if item.tone > 0: Swatch { tone: item.tone; y: 9px; }
            Text { text: item.label; color: Theme.accent; font-size: Theme.font-body; font-weight: Theme.weight-semibold; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: item.detail; color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-medium; vertical-alignment: center; overflow: elide; }
        }
        area := TouchArea { clicked => { root.clicked(i); } }
    }
}

// Check boxes for a set of choices.
export component CheckList inherits VerticalLayout {
    in property <[CheckItem]> items;
    in property <bool> editable: true;
    in property <string> empty-text: @tr("None.");
    callback toggled(int, bool);
    spacing: 2px;
    if root.items.length == 0: Text { text: root.empty-text; color: Theme.graphite; font-size: Theme.font-label; }
    for item[i] in root.items: CheckBox {
        text: item.label;
        checked: item.checked;
        enabled: root.editable;
        toggled => { root.toggled(i, self.checked); }
    }
}

// Count tiles for the overview.
export component Tile inherits Rectangle {
    in property <string> label;
    in property <int> count;
    min-width: 120px;
    height: 70px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.rule;
    border-radius: 2px;
    VerticalLayout {
        padding: 10px;
        Text { text: root.count; font-size: 24px; font-weight: Theme.weight-heavy; letter-spacing: Theme.tracking-tight; color: Theme.ink; }
        Text { text: root.label; font-size: Theme.font-label; font-weight: Theme.weight-semibold; color: Theme.graphite; overflow: elide; }
    }
}

// Horizontal bars of a distribution.
export component Bars inherits VerticalLayout {
    in property <[CountItem]> items;
    in property <string> title;
    // The largest count, which gets the full width.
    in property <int> most: 1;
    spacing: 4px;
    SectionTitle { text: root.title; }
    for item in root.items: HorizontalLayout {
        spacing: 8px;
        Text { text: item.label; width: 90px; font-size: Theme.font-label; font-weight: Theme.weight-medium; color: Theme.ink; overflow: elide; }
        Rectangle {
            horizontal-stretch: 1;
            height: 14px;
            Rectangle {
                x: 0;
                width: item.count == 0 ? 2px : parent.width * min(1.0, item.count / max(1.0, root.most));
                background: item.tone == 0 ? Theme.rule : Theme.tone(item.tone);
            }
        }
        Text { text: item.count; width: 32px; font-size: Theme.font-label; font-weight: Theme.weight-bold; color: Theme.ink; horizontal-alignment: right; }
    }
}
