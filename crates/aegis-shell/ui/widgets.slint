// Small building blocks shared by the pages (job 040).
//
// Every widget here only shows what it is given and reports what the user
// did; the client core decides everything else.
import { StandardTableView, ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ProjectItem {
    id: string,
    name: string,
    methodology: string,
}

// One translation of a description (FND-04): a language tag and the text.
export struct TranslationItem {
    lang: string,
    text: string,
}

// One description box of the page: which element it is for, its text, and
// who wrote it.
export struct DescriptionItem {
    kind: string,
    text: string,
    by: string,
    translations: [TranslationItem],
}

export struct ThreatItem {
    name: string,
    asset: string,
    inherent: string,
    residual: string,
    // 0 not rated, 1 very low ... 4 high (colors of the rating buckets)
    inherent-tone: int,
    residual-tone: int,
    selected: bool,
}

// A labelled drop-down: label, choices, the chosen position.
// The rows picked together in a table (UI-04): one flag per row, and how many.
export struct Marks {
    rows: [bool],
    count: int,
}

export struct FactorItem {
    label: string,
    // "Not rated" (or "None") first, then the choices
    options: [string],
    selected: int,
}

export struct NoticeItem {
    id: int,
    // 0 info, 1 warning, 2 error
    severity: int,
    text: string,
    // 0 none, 1 Undo, 2 Redo
    action: int,
}

// A related entity: a click leads to it.
export struct LinkItem {
    label: string,
    detail: string,
    tone: int,
}

export struct CheckItem {
    label: string,
    checked: bool,
}

export struct MitigationItem {
    name: string,
    // position in the feasibility levels
    level: int,
}

export struct CountItem {
    label: string,
    count: int,
    tone: int,
}

export struct DiffItem {
    kind: string,
    text: string,
}

export struct ProblemItem {
    error: bool,
    text: string,
}

export struct SuggestionItem {
    label: string,
    detail: string,
    kind: string,
    selected: bool,
}

export struct SettingItem {
    label: string,
    rules: string,
    inherited: bool,
    from-component: string,
}

export struct ControlRuleItem {
    label: string,
    // 0 = No ceiling, 1.. = feasibility levels
    level: int,
}

// ---- Controls ----
// The window draws its own buttons, fields and boxes from the Theme tokens
// instead of the platform style's, so the dark and light themes look like one
// product on every OS. Each keeps the std-widgets API the pages use. A
// FocusScope of zero width takes keys but not clicks, so a click on a button
// does not take the focus from a text field (as with std-widgets).

// The ring drawn around a control that has the keyboard focus.
component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius: Theme.radius-control;
    // The parent sets the size: its own plus 6px.
    x: -3px;
    y: -3px;
    border-radius: self.radius + 3px;
    border-width: self.shown ? 2px : 0px;
    border-color: Theme.focus-ring;
}

// A push button. `primary` is the one main action of a form (accent fill);
// `ghost` is a quiet text-only action such as a row action (no frame
// until hovered). Anything else is a secondary button.
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> ghost;
    // A line of a menu: ghost, but in the ordinary text colour, not the accent.
    in property <bool> menu-item;
    out property <bool> has-focus: fs.has-focus;
    out property <bool> pressed: root.enabled && ta.pressed;
    callback clicked();
    property <color> ink: root.primary ? #FFFFFF : (root.ghost && !root.menu-item ? Theme.accent : Theme.ink);

    min-width: max(28px, row.min-width);
    preferred-width: max(28px, row.preferred-width);
    min-height: Theme.control-height;
    preferred-height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: fs;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    // A row taller than a button (a header, a title) gets a button of the
    // usual height in its middle, not a stretched slab.
    face := Rectangle {
        y: (parent.height - self.height) / 2;
        height: min(parent.height, Theme.control-height);
        border-radius: Theme.radius-control;
        opacity: root.enabled ? 1 : Theme.disabled-opacity;
        background: root.primary ? (root.pressed ? Theme.accent-pressed : (ta.has-hover && root.enabled ? Theme.accent-hover : Theme.accent))
            : root.ghost ? (root.pressed ? Theme.pressed : (ta.has-hover && root.enabled ? Theme.wash : transparent))
            : (root.pressed ? Theme.pressed : (ta.has-hover && root.enabled ? Theme.raised-hover : Theme.raised));
        border-width: root.primary || root.ghost ? 0px : 1px;
        border-color: ta.has-hover && root.enabled ? Theme.line-strong : Theme.line;
        FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; }
        row := HorizontalLayout {
            padding-left: root.ghost ? 8px : 12px;
            padding-right: self.padding-left;
            spacing: 6px;
            alignment: root.ghost ? start : center;
            if root.icon.width > 0: Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                colorize: root.ink;
                accessible-role: none;
            }
            if root.text != "": Text {
                text: root.text;
                color: root.ink;
                font-weight: root.primary ? Theme.weight-semibold : Theme.weight-medium;
                vertical-alignment: center;
                horizontal-alignment: center;
                accessible-role: none;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    fs := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            reject
        }
    }
}

// The frame of a text field: sunk below the panel, accent border with focus.
component FieldFrame inherits Rectangle {
    in property <bool> enabled;
    in property <bool> focused;
    in property <bool> hovered;
    background: root.enabled ? Theme.field : transparent;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.focused ? Theme.accent : (root.hovered && root.enabled ? Theme.line-strong : Theme.line);
    FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: root.focused; }
}

// The edit commands of a text field's right-click menu.
component EditMenu inherits ContextMenuArea {
    in property <bool> writable;
    in property <bool> has-text;
    callback cut();
    callback copy();
    callback paste();
    callback select-all();
    Menu {
        MenuItem { title: @tr("Cut"); enabled: root.writable && root.has-text; activated => { root.cut(); } }
        MenuItem { title: @tr("Copy"); enabled: root.has-text; activated => { root.copy(); } }
        MenuItem { title: @tr("Paste"); enabled: root.writable; activated => { root.paste(); } }
        MenuItem { title: @tr("Select all"); enabled: root.has-text; activated => { root.select-all(); } }
    }
}

// A one-line text field.
export component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled <=> input.enabled;
    in property <bool> read-only <=> input.read-only;
    in property <InputType> input-type <=> input.input-type;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    public function select-all() { input.select-all(); }

    min-width: 40px;
    preferred-width: 160px;
    min-height: Theme.control-height;
    horizontal-stretch: 1;
    preferred-height: Theme.control-height;
    max-height: Theme.control-height;
    vertical-stretch: 0;
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;
    accessible-action-set-value(v) => { root.text = v; root.edited(v); }

    FieldFrame { enabled: root.enabled; focused: input.has-focus; hovered: menu.has-hover; }
    menu := TouchArea {
        // Only for the hover border; the text input below takes the clicks.
        enabled: false;
    }
    EditMenu {
        x: 10px;
        width: parent.width - 20px;
        writable: root.enabled && !root.read-only;
        has-text: root.text != "";
        cut => { input.cut(); }
        copy => { input.copy(); }
        paste => { input.paste(); }
        select-all => { input.select-all(); }
        Rectangle {
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
                color: Theme.graphite;
                accessible-role: none;
            }
            input := TextInput {
                property <length> computed-x;
                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                color: Theme.ink;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.ink;
                accessible-role: none;
                cursor-position-changed(position) => {
                    if (position.x + self.computed-x < 0px) {
                        self.computed-x = -position.x;
                    } else if (position.x + self.computed-x > parent.width - self.text-cursor-width) {
                        self.computed-x = parent.width - position.x - self.text-cursor-width;
                    }
                }
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }
    }
}

// A multi-line text box. Like std-widgets' TextEdit it lets Tab through.
export component TextEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled <=> input.enabled;
    in property <bool> read-only <=> input.read-only;
    in property <TextWrap> wrap <=> input.wrap;
    in property <length> font-size <=> input.font-size;
    in property <string> font-family <=> input.font-family;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);

    min-width: 60px;
    min-height: 56px;
    preferred-height: 96px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;
    accessible-action-set-value(v) => { root.text = v; root.edited(v); }

    FieldFrame { enabled: root.enabled; focused: input.has-focus; hovered: false; }
    EditMenu {
        writable: root.enabled && !root.read-only;
        has-text: root.text != "";
        cut => { input.cut(); }
        copy => { input.copy(); }
        paste => { input.paste(); }
        select-all => { input.select-all(); }
        scroll := ScrollView {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            content-width: input.wrap == TextWrap.no-wrap ? max(self.visible-width, input.preferred-width + 20px) : self.visible-width;
            content-height: max(self.visible-height, input.preferred-height + 12px);
            input := TextInput {
                x: 10px;
                y: 6px;
                width: parent.width - 20px;
                single-line: false;
                wrap: word-wrap;
                color: Theme.ink;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.ink;
                page-height: scroll.visible-height;
                accessible-role: none;
                edited => { root.edited(self.text); }
                cursor-position-changed(position) => {
                    // Keep the caret in view (20px: about one line).
                    if (position.y + scroll.content-y < 0px) {
                        scroll.content-y = min(0px, -position.y);
                    } else if (position.y + 20px + scroll.content-y > scroll.visible-height) {
                        scroll.content-y = min(0px, scroll.visible-height - position.y - 20px - 12px);
                    }
                    if (position.x + scroll.content-x < 0px) {
                        scroll.content-x = min(0px, -position.x);
                    } else if (position.x + 20px + scroll.content-x > scroll.visible-width) {
                        scroll.content-x = min(0px, scroll.visible-width - position.x - 20px - 20px);
                    }
                }
            }
        }
    }
    Text {
        x: 11px;
        y: 7px;
        width: parent.width - 22px;
        text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
        color: Theme.graphite;
        font-size: input.font-size;
        wrap: word-wrap;
        overflow: elide;
        accessible-role: none;
    }
}

// A drop-down list. Up and Down change the choice on the closed box; Return,
// Space or a click opens the list.
export component ComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    out property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    // Shown dimmed while nothing is chosen (a command drop-down in a bar).
    in property <string> placeholder;
    in property <bool> enabled: true;
    out property <bool> has-focus: fs.has-focus;
    callback selected(string);
    property <length> item-height: 28px;
    property <int> visible-items: min(8, root.model.length);

    function select(index: int) {
        if (!root.enabled || index < 0 || index >= root.model.length) { return; }
        root.current-index = index;
        root.selected(root.current-value);
    }

    min-width: max(160px, row.min-width);
    min-height: Theme.control-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    preferred-height: Theme.control-height;
    max-height: Theme.control-height;
    forward-focus: fs;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    background: ta.pressed ? Theme.pressed : (ta.has-hover && root.enabled ? Theme.raised-hover : Theme.raised);
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.line-strong : Theme.line;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-value: root.current-value;
    accessible-expandable: true;
    accessible-action-expand => { popup.show(); }

    FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; }
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.current-value != "" ? root.current-value : root.placeholder;
            color: root.current-value != "" ? Theme.ink : Theme.graphite;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            accessible-role: none;
        }
        Image {
            source: @image-url("icons/chevron-down.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.graphite;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { fs.focus(); popup.show(); }
    }
    fs := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.select(max(0, root.current-index - 1)); return accept; }
            if (event.text == Key.DownArrow) { root.select(min(root.model.length - 1, root.current-index + 1)); return accept; }
            if (event.text == Key.Return || event.text == Key.Space) { popup.show(); return accept; }
            reject
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.visible-items * root.item-height + 10px;
        close-policy: close-on-click-outside;
        forward-focus: list-keys;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
        }
        list-keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.UpArrow) { root.select(max(0, root.current-index - 1)); return accept; }
                if (event.text == Key.DownArrow) { root.select(min(root.model.length - 1, root.current-index + 1)); return accept; }
                if (event.text == Key.Return || event.text == Key.Escape || event.text == Key.Space) { popup.close(); return accept; }
                reject
            }
        }
        ScrollView {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            content-y: -max(0, root.current-index - root.visible-items + 1) * root.item-height;
            VerticalLayout {
                padding: 4px;
                for value[index] in root.model: Rectangle {
                    height: root.item-height;
                    border-radius: 4px;
                    background: index == root.current-index ? Theme.selection : (item.has-hover ? Theme.wash : transparent);
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: value;
                        color: Theme.ink;
                        font-weight: index == root.current-index ? Theme.weight-semibold : Theme.weight-regular;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item := TouchArea {
                        clicked => { root.select(index); popup.close(); }
                    }
                }
            }
        }
    }
}

// A drop-down with a filter (job 122b): the box looks like a ComboBox; Return,
// Space, Down or a click opens a list under it with a text field on top. What
// is typed narrows the list (the caller filters: it gets `filter-changed` and
// answers with `shown`, the labels to list, and `shown-at`, their positions
// in `model`). Up and Down move, Return picks, Escape closes and changes
// nothing. It is a popup under the field, not a dialog (UI-12).
export component FilterPicker inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index: 0;
    in property <bool> enabled: true;
    in property <string> label;
    in property <[string]> shown;
    in property <[int]> shown-at;
    in-out property <bool> has-focus: false;
    in-out property <bool> open: false;
    in-out property <int> highlight: 0;
    in-out property <string> query-text: "";
    callback filter-changed(string);
    callback picked(int);
    property <length> item-height: 28px;
    property <length> input-height: 34px;
    property <int> visible-items: max(1, min(8, root.shown.length));
    property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";

    function show() {
        if (!root.enabled) { return; }
        root.query-text = "";
        root.filter-changed("");
        root.highlight = max(0, min(root.current-index, root.shown.length - 1));
        root.open = true;
        popup.show();
    }
    function pick(position: int) {
        if (position < 0 || position >= root.shown.length || position >= root.shown-at.length) { return; }
        root.open = false;
        popup.close();
        root.picked(root.shown-at[position]);
    }

    min-width: max(160px, row.min-width);
    min-height: Theme.control-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    preferred-height: Theme.control-height;
    max-height: Theme.control-height;
    forward-focus: fs;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    background: ta.pressed ? Theme.pressed : (ta.has-hover && root.enabled ? Theme.raised-hover : Theme.raised);
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.line-strong : Theme.line;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.current-value;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-expand => { root.show(); }

    FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; }
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.current-value;
            color: Theme.ink;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            accessible-role: none;
        }
        Image {
            source: @image-url("icons/chevron-down.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.graphite;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { fs.focus(); root.show(); }
    }
    fs := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        changed has-focus => { root.has-focus = self.has-focus; if (self.has-focus) { root.open = false; } }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) { root.show(); return accept; }
            reject
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.input-height + root.visible-items * root.item-height + 14px;
        close-policy: close-on-click-outside;
        forward-focus: keys;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
        }
        keys := FocusScope {
            forward-focus: query;
            capture-key-pressed(event) => {
                if (event.text == Key.UpArrow) { root.highlight = max(0, root.highlight - 1); return accept; }
                if (event.text == Key.DownArrow) { root.highlight = max(0, min(root.shown.length - 1, root.highlight + 1)); return accept; }
                if (event.text == Key.Return) { root.pick(root.highlight); return accept; }
                if (event.text == Key.Escape) { root.open = false; popup.close(); return accept; }
                reject
            }
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: root.input-height;
                    query := TextInput {
                        text <=> root.query-text;
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        single-line: true;
                        vertical-alignment: center;
                        color: Theme.ink;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: Theme.ink;
                        accessible-role: text-input;
                        accessible-label: root.label;
                        edited => {
                            root.filter-changed(self.text);
                            // The first match, not "None", is what Return picks.
                            root.highlight = max(0, min(self.text == "" ? root.current-index : 1, root.shown.length - 1));
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                }
                ScrollView {
                    height: root.visible-items * root.item-height + 8px;
                    content-y: -max(0, root.highlight - root.visible-items + 1) * root.item-height;
                    VerticalLayout {
                        padding: 4px;
                        for value[position] in root.shown: Rectangle {
                            height: root.item-height;
                            border-radius: 4px;
                            background: position == root.highlight ? Theme.selection : (item.has-hover ? Theme.wash : transparent);
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                text: value;
                                color: Theme.ink;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            item := TouchArea { clicked => { root.pick(position); } }
                        }
                    }
                }
            }
        }
    }
}

// The box-and-label row shared by CheckBox and Switch.
component Toggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    out property <bool> has-focus: fs.has-focus;
    out property <bool> hovered: ta.has-hover && root.enabled;
    callback toggled();
    function flip() {
        if (!root.enabled) { return; }
        root.checked = !root.checked;
        root.toggled();
    }
    min-height: 24px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    vertical-stretch: 0;
    forward-focus: fs;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => { root.flip(); }
    ta := TouchArea { enabled: root.enabled; clicked => { root.flip(); } }
    fs := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space) { root.flip(); return accept; }
            reject
        }
    }
    row := HorizontalLayout {
        spacing: 8px;
        @children
        if root.text != "": Text {
            text: root.text;
            color: Theme.ink;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
            accessible-role: none;
        }
    }
}

export component CheckBox inherits Toggle {
    accessible-role: checkbox;
    Rectangle {
        width: 16px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: root.checked ? Theme.accent : Theme.field;
        border-width: root.checked ? 0px : 1px;
        border-color: root.hovered ? Theme.line-strong : Theme.line;
        FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: root.has-focus; radius: 4px; }
        if root.checked: Image {
            source: @image-url("icons/check.svg");
            width: 12px;
            height: 12px;
            colorize: #FFFFFF;
        }
    }
}

export component Switch inherits Toggle {
    accessible-role: switch;
    Rectangle {
        width: 30px;
        height: 18px;
        y: (parent.height - self.height) / 2;
        border-radius: 9px;
        background: root.checked ? Theme.accent : Theme.line;
        FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: root.has-focus; radius: 9px; }
        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: #FFFFFF;
            animate x { duration: 120ms; }
        }
    }
}

// A drop-down whose shown choice always follows the view model. A plain
// ComboBox loses its binding once the user picks something, so a later change
// from the engine (an undo, another editor) would not show.
export component Choice inherits VerticalLayout {
    in property <[string]> options;
    in property <int> index;
    in property <bool> editable: true;
    in property <string> label;
    in-out property <bool> has-focus: false;
    // Shown while nothing is chosen.
    in property <string> placeholder;
    callback picked(int);
    public function focus-box() { box.focus(); }
    // Shows `index` again, for a drop-down that is a command, not a value.
    public function reset() { box.current-index = root.index; }

    box := ComboBox {
        model: root.options;
        placeholder: root.placeholder;
        current-index: root.index;
        enabled: root.editable;
        accessible-label: root.label;
        selected(v) => { root.picked(self.current-index); }
        changed has-focus => { root.has-focus = self.has-focus; }
    }
    changed index => { box.current-index = root.index; }
    changed options => { box.current-index = root.index; }
}

// A table built on Slint's `ListView` so each row can carry real buttons, a
// fixed 28/32 px row height and a tooltip on the elided name (UI-09). It keeps
// the API of the `StandardTableView` wrapper it replaced (columns, rows, selected, picked) and adds opt-in row
// actions. The header stays above the scroll; the name column elides and shows
// the full name in a tooltip. `Control` in the key handler is the platform
// command key (the shortcut table's convention).
export component DataTable inherits Rectangle {
    in property <[TableColumn]> columns;
    in property <[[StandardListViewItem]]> rows;
    in property <int> selected: -1;
    in property <string> label;
    // Whether the user may act on rows (no actions for a read-only user).
    in property <bool> editable: true;
    // 28 px rows in compact density, 32 px otherwise (UI-09.5).
    in property <bool> compact: false;
    // Row actions. `add-verb` is the prefix of the + accessible name
    // ("Add asset to" + " " + the row name). A table with no `show-add` and
    // no menu items shows no action column.
    in property <bool> show-add: false;
    in property <string> add-verb;
    in property <bool> show-open: false;
    in property <bool> show-duplicate: false;
    in property <bool> show-remove: false;
    // Rows picked together with ctrl or shift (UI-04). The controller keeps
    // them by element ID, so a table that re-sorts keeps the right rows. The
    // bar below the rows shows only for an editing user and two or more rows.
    in property <Marks> marks;
    // Whether the table takes bulk edits: select all (Control or Command
    // with A) picks every row and shift with an arrow extends the picks
    // from the selected row.
    in property <bool> bulk: false;
    // Optional drop-downs in the bar (the risk table's treatment; an asset
    // property to add or remove; an impact rating; a threat's goal or claim).
    in property <[string]> bulk-choices;
    in property <string> bulk-choice-label;
    in property <[string]> bulk-choices-2;
    in property <string> bulk-choice-2-label;
    callback picked(int);
    callback activated(int);
    callback mark-click(int, bool);
    callback mark-all();
    callback clear-marks();
    callback remove-marked();
    callback bulk-choice(int);
    callback bulk-choice-2(int);
    callback add-child(int);
    callback open-row(int);
    callback duplicate-row(int);
    callback remove-row(int);
    // Where the table sits in the window, so a test (or a screen reader
    // bridge) can aim a real click at a row.
    callback laid-out(length, length, length);

    property <length> row-height: root.compact ? 28px : 32px;
    property <length> header-height: 28px;
    // A column never squeezes below this; a table wider than its window
    // scrolls sideways instead.
    pure function col-min(column: TableColumn) -> length {
        return column.width >= 1px ? max(column.min-width, column.width) : max(column.min-width, 120px);
    }
    property <bool> has-actions: root.editable && (root.show-add || root.show-open || root.show-duplicate || root.show-remove);
    property <int> current-row: -1;
    property <bool> settling: true;
    property <int> menu-row: -1;
    property <bool> menu-open: false;
    // The modifiers held when the last press went down.
    property <bool> press-ctrl: false;
    property <bool> press-shift: false;
    property <bool> bulk-bar: root.editable && root.marks.count >= 2;

    min-width: 0px;
    min-height: 200px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: focus-scope;
    accessible-role: AccessibleRole.table;
    accessible-label: root.label;

    public function set-current-row(index: int) {
        if (index < 0 || index >= root.rows.length) { return; }
        root.current-row = index;
        root.bring-into-view(index);
        if (index != root.selected) { root.picked(index); }
    }

    public function move-by(delta: int) {
        if (root.rows.length == 0) { return; }
        if (root.marks.count > 0) { root.clear-marks(); }
        let target = root.current-row < 0 ? (delta > 0 ? 0 : root.rows.length - 1) : root.current-row + delta;
        root.set-current-row(max(0, min(root.rows.length - 1, target)));
    }

    // Shift+arrow: moves the cursor one row and picks every row from the
    // selected one to it. With no row selected the first press selects one.
    public function extend-by(delta: int) {
        if (root.rows.length == 0) { return; }
        let from = root.current-row < 0 ? root.selected : root.current-row;
        let target = max(0, min(root.rows.length - 1, from + delta));
        if (root.selected < 0) { root.set-current-row(target); return; }
        root.current-row = target;
        root.bring-into-view(target);
        root.mark-click(target, true);
    }

    public function bring-into-view(index: int) {
        if (index < 0 || index >= root.rows.length) { return; }
        let y = scroll.content-y + index * root.row-height;
        if (y < 0) { scroll.content-y += 0 - y; }
        if (y + root.row-height > scroll.visible-height) {
            scroll.content-y -= y + root.row-height - scroll.visible-height;
        }
    }

    changed selected => {
        root.set-current-row(root.selected);
        root.settling = true;
    }
    init => { root.set-current-row(root.selected); }
    changed height => { root.laid-out(root.absolute-position.x, root.absolute-position.y, root.width); }
    changed width => { root.laid-out(root.absolute-position.x, root.absolute-position.y, root.width); }

    Timer {
        interval: 60ms;
        running: root.settling;
        triggered => {
            root.settling = false;
            root.set-current-row(root.selected);
        }
    }

    focus-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        accessible-role: AccessibleRole.table;
        accessible-label: root.label;
        key-pressed(event) => {
            if (root.bulk && root.editable && event.modifiers.shift && event.text == Key.UpArrow) { root.extend-by(-1); return accept; }
            else if (root.bulk && root.editable && event.modifiers.shift && event.text == Key.DownArrow) { root.extend-by(1); return accept; }
            else if (root.bulk && root.editable && event.modifiers.control && (event.text == "a" || event.text == "A")) { root.mark-all(); return accept; }
            else if (event.text == Key.UpArrow) { root.move-by(-1); return accept; }
            else if (event.text == Key.DownArrow) { root.move-by(1); return accept; }
            else if (event.text == Key.Home) { if (root.marks.count > 0) { root.clear-marks(); } root.set-current-row(0); return accept; }
            else if (event.text == Key.End) { if (root.marks.count > 0) { root.clear-marks(); } root.set-current-row(root.rows.length - 1); return accept; }
            else if (event.text == Key.Escape && root.marks.count > 0) { root.clear-marks(); return accept; }
            else if (event.text == Key.PageUp) { root.move-by(-10); return accept; }
            else if (event.text == Key.PageDown) { root.move-by(10); return accept; }
            else if (event.text == Key.Return && event.modifiers.control) { if (root.selected >= 0 && root.editable && root.show-add) { root.add-child(root.selected); } return accept; }
            else if (event.text == Key.Return) { if (root.selected >= 0) { root.activated(root.selected); } return accept; }
            else if ((event.text == Key.Backspace || event.text == Key.Delete) && root.bulk-bar && root.show-remove) { root.remove-marked(); return accept; }
            else if ((event.text == Key.Backspace || event.text == Key.Delete) && root.selected >= 0 && root.editable && root.show-remove) { root.remove-row(root.selected); return accept; }
            else if (event.modifiers.control && event.text == "d" && root.selected >= 0 && root.editable && root.show-duplicate) { root.duplicate-row(root.selected); return accept; }
            reject
        }
    }

    // Not drawn: only its width, the sum of the column minimums, is read.
    probe := HorizontalLayout {
        height: 0px;
        visible: false;
        for column in root.columns : Rectangle { min-width: root.col-min(column); }
    }

    VerticalLayout {
        spacing: 0px;
        header := Rectangle {
            height: root.header-height;
            clip: true;
            background: Theme.panel;
            HorizontalLayout {
                x: scroll.content-x;
                width: max(scroll.visible-width, self.preferred-width);
                for column[index] in root.columns : Rectangle {
                    horizontal-stretch: column.horizontal-stretch;
                    min-width: root.col-min(column);
                    preferred-width: self.min-width;
                    max-width: (index < root.columns.length && column.width >= 1px) ? max(column.min-width, column.width) : 100000px;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: column.title;
                        color: Theme.graphite;
                        font-size: Theme.font-label;
                        font-weight: Theme.weight-semibold;
                        overflow: elide;
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.rule;
            }
        }

        scroll := ListView {
            vertical-stretch: 1;
            content-width: max(self.width, probe.min-width);
            for row[row-index] in root.rows : Rectangle {
                width: scroll.content-width;
                height: root.row-height;
                clip: true;
                background: (row-index == root.selected || root.marks.rows[row-index]) ? Theme.selection
                    : (row-touch.has-hover ? Theme.wash : transparent);
                // The selected and picked rows also carry an accent bar, so they do not rely on colour alone.
                if row-index == root.selected || root.marks.rows[row-index]: Rectangle {
                    x: 0px;
                    width: 3px;
                    background: Theme.accent;
                }
                // A thin line under every row, so neighbouring rows read as separate.
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.rule;
                }
                row-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            focus-scope.focus();
                            root.press-ctrl = e.modifiers.control;
                            root.press-shift = e.modifiers.shift;
                        }
                    }
                    clicked => {
                        focus-scope.focus();
                        // Shift picks the range from the selected row; ctrl adds or drops one row.
                        if (root.editable && root.press-shift) { root.mark-click(row-index, true); }
                        else if (root.editable && root.press-ctrl) { root.mark-click(row-index, false); root.set-current-row(row-index); }
                        else { if (root.marks.count > 0) { root.clear-marks(); } root.set-current-row(row-index); }
                    }
                }
                HorizontalLayout {
                    for cell[cell-index] in row : Rectangle {
                        clip: true;
                        horizontal-stretch: root.columns[cell-index].horizontal-stretch;
                        min-width: root.col-min(root.columns[cell-index]);
                        preferred-width: self.min-width;
                        max-width: (cell-index < root.columns.length && root.columns[cell-index].width >= 1px) ? max(root.columns[cell-index].min-width, root.columns[cell-index].width) : 100000px;
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: cell.text;
                            color: Theme.ink;
                            overflow: elide;
                            if cell-index == 1 && cell.text != "": Tooltip {
                                Text { text: cell.text; }
                            }
                        }
                    }
                }
                // A draft row (an element being created) has no ID yet and no actions.
            if root.has-actions && row[0].text != "" && (row-index == root.selected || row-touch.has-hover): HorizontalLayout {
                    // Pinned to the visible right edge, so they stay reachable when the table is scrolled sideways.
                    x: scroll.visible-width - scroll.content-x - self.preferred-width - 8px;
                    y: (parent.height - self.preferred-height) / 2;
                    spacing: 4px;
                    if root.show-add: Button {
                        text: "+";
                        width: 24px;
                        height: 24px;
                        accessible-label: root.add-verb + " " + row[1].text;
                        clicked => { root.add-child(row-index); }
                        Tooltip { Text { text: root.add-verb + " " + row[1].text; } }
                    }
                    if root.show-open || root.show-duplicate || root.show-remove: Button {
                        text: "\u{2026}";
                        width: 24px;
                        height: 24px;
                        accessible-label: @tr("More actions for {}", row[1].text);
                        clicked => {
                            root.menu-row = row-index;
                            root.menu-open = !root.menu-open;
                        }
                        Tooltip { Text { text: @tr("Open, duplicate or remove"); } }
                    }
                }
            }
        }

        if root.bulk-bar: Rectangle {
            // One row for the count and the buttons; the drop-downs, when the
            // table has any, get a row of their own so a narrow window still
            // shows every control.
            property <bool> has-choices: root.bulk-choices.length > 0 || root.bulk-choices-2.length > 0;
            height: self.has-choices ? 80px : 40px;
            background: Theme.panel;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: @tr("{} selected", root.marks.count);
            Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.rule; }
            VerticalLayout {
                padding-left: 12px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("{} selected", root.marks.count);
                        color: Theme.ink;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.show-remove: Button {
                        text: @tr("Remove selected");
                        accessible-label: @tr("Remove {} selected", root.marks.count);
                        clicked => { root.remove-marked(); }
                    }
                    Button {
                        ghost: true;
                        text: @tr("Clear selection");
                        clicked => { root.clear-marks(); }
                    }
                }
                if parent.has-choices: HorizontalLayout {
                    spacing: 8px;
                    // Commands, not values: each shows its label until picked
                    // and goes back to it afterwards.
                    if root.bulk-choices.length > 0: Choice {
                        options: root.bulk-choices;
                        index: -1;
                        label: root.bulk-choice-label;
                        placeholder: root.bulk-choice-label;
                        picked(i) => { root.bulk-choice(i); self.reset(); }
                    }
                    if root.bulk-choices-2.length > 0: Choice {
                        options: root.bulk-choices-2;
                        index: -1;
                        label: root.bulk-choice-2-label;
                        placeholder: root.bulk-choice-2-label;
                        picked(i) => { root.bulk-choice-2(i); self.reset(); }
                    }
                }
            }
        }
    }

    if root.menu-open: TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        clicked => { root.menu-open = false; }
    }
    if root.menu-open && root.menu-row >= 0: Rectangle {
        x: parent.width - 156px - 8px;
        y: root.header-height + (root.menu-row + 1) * root.row-height - scroll.content-y;
        width: 156px;
        height: menu-items.preferred-height;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius-control;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        menu-items := VerticalLayout {
            padding: 4px;
            spacing: 2px;
            if root.show-open: Button {
                ghost: true;
                menu-item: true;
                text: @tr("Open");
                accessible-label: @tr("Open {}", root.rows[root.menu-row][1].text);
                clicked => { root.menu-open = false; root.open-row(root.menu-row); }
            }
            if root.show-duplicate: Button {
                ghost: true;
                menu-item: true;
                text: @tr("Duplicate");
                accessible-label: @tr("Duplicate {}", root.rows[root.menu-row][1].text);
                clicked => { root.menu-open = false; root.duplicate-row(root.menu-row); }
            }
            if root.show-remove: Button {
                ghost: true;
                menu-item: true;
                text: @tr("Remove");
                accessible-label: @tr("Remove {}", root.rows[root.menu-row][1].text);
                clicked => { root.menu-open = false; root.remove-row(root.menu-row); }
            }
        }
    }

}

// The main button of a confirmation that cannot be undone (UI-12): red, so it
// is not mistaken for a safe default. It is not focused first, so Enter does
// not trigger it unless the user has moved focus to it.
export component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width: max(96px, label.min-width + 24px);
    min-height: Theme.control-height;
    preferred-height: Theme.control-height;
    max-height: Theme.control-height;
    border-radius: Theme.radius-control;
    background: ta.has-hover ? Theme.danger-hover : Theme.danger;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    label := Text {
        text: root.text;
        color: #FFFFFF;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A field error: next to the field, in the error colour with an icon, never in a
// dialog (UI-10.11). The icon means the message does not rely on colour alone.
export component FieldError inherits HorizontalLayout {
    in property <string> text;
    spacing: 6px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Image {
        source: @image-url("icons/circle-alert.svg");
        width: 14px;
        height: 14px;
        y: 1px;
        colorize: Theme.high;
    }
    Text {
        text: root.text;
        color: Theme.high;
        font-size: Theme.font-label;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component SectionTitle inherits Text {
    font-size: Theme.font-label;
    font-weight: Theme.weight-bold;
    letter-spacing: Theme.tracking-label;
    color: Theme.ink;
}

export component PageTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    spacing: 10px;
    padding-bottom: 4px;
    Image {
        source: root.icon;
        width: 22px;
        height: 22px;
        y: 4px;
        colorize: Theme.accent;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Theme.font-display;
            font-weight: Theme.weight-heavy;
            letter-spacing: Theme.tracking-tight;
            color: Theme.ink;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: Theme.font-body;
            font-weight: Theme.weight-medium;
            color: Theme.graphite;
            wrap: word-wrap;
        }
    }
    @children
}

// Dark-mode tactical obsidian splash screen window header banner.
// Uses the brand color system (#14181D -> #0B0D10 obsidian gradient,
// #E04F26 -> #C83E1B tungsten crimson-amber reticle bar, #8C99A6 tactical
// slate datum telemetry, and the wide AegisTARA splash header graphic).
export component SplashHeader inherits Rectangle {
    in property <string> badge-text: @tr("ISO/SAE 21434 · EU CRA · STRIDE");
    in property <string> status-text: @tr("");
    in property <color> status-color: Theme.crimson-bright;
    in property <length> banner-height: 136px;

    height: root.banner-height;
    clip: true;
    background: @linear-gradient(180deg, Theme.obsidian-core 0%, Theme.obsidian-edge 100%);

    // Top tungsten crimson-amber precision accent bar.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 2px;
        background: @linear-gradient(90deg, Theme.crimson-deep 0%, Theme.crimson-bright 50%, Theme.crimson-deep 100%);
    }

    // Subtle horizontal tactical datum hairline across the obsidian field.
    Rectangle {
        x: 16px;
        y: 26px;
        width: parent.width - 32px;
        height: 1px;
        background: #28313B80;
    }

    // Telemetry header micro-bar (left standard badge, right live status).
    Text {
        x: 16px;
        y: 6px;
        height: 16px;
        text: root.badge-text;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-bold;
        letter-spacing: Theme.tracking-header;
        color: Theme.slate-light;
        vertical-alignment: center;
    }
    if root.status-text != "": HorizontalLayout {
        x: parent.width - self.preferred-width - 16px;
        y: 6px;
        height: 16px;
        spacing: 6px;
        Rectangle {
            width: 6px;
            height: 6px;
            y: 5px;
            border-radius: 3px;
            background: root.status-color;
        }
        Text {
            text: root.status-text;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-heavy;
            letter-spacing: Theme.tracking-header;
            color: Theme.platinum;
            vertical-alignment: center;
        }
    }

    // Hero reticle + AegisTARA wordmark + subtitle.
    Image {
        x: 12px;
        y: 24px;
        width: parent.width - 24px;
        height: parent.height - 28px;
        source: @image-url("brand/AegisTARA_Splash_Header_960x360.png");
        image-fit: contain;
    }

    // Bottom datum hairline with centered tungsten reticle tick.
    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.obsidian-rule;
    }
    Rectangle {
        x: (parent.width - 72px) / 2;
        y: parent.height - 2px;
        width: 72px;
        height: 2px;
        background: Theme.crimson-bright;
    }
}

// The description of an element (or the notes of the project), edited in
// place. Slint's multi-line text box ignores Tab, so Tab still leaves it:
// leaving the box or the save shortcut saves, Escape puts the saved text back.
export component DescriptionBox inherits VerticalLayout {
    in property <string> label: @tr("Description");
    in property <string> text;
    in property <string> by;
    in property <bool> editable;
    // The save shortcut as the keyboard shows it (for the hint).
    in property <string> save-label;
    in property <string> placeholder: @tr("Add a description. {0} or leaving the box saves.", root.save-label);
    callback save(string);
    spacing: 4px;
    SectionTitle { text: root.label; }
    if !root.editable: Text {
        text: root.text == "" ? @tr("None yet.") : root.text;
        color: root.text == "" ? Theme.graphite : Theme.ink;
        font-size: Theme.font-body;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
        accessible-label: root.label + ": " + (root.text == "" ? @tr("none yet") : root.text);
    }
    if root.editable: FocusScope {
        height: 96px;
        // Only catches keys on their way to the text box; never a Tab stop itself.
        focus-on-tab-navigation: false;
        focus-on-click: false;
        // A new element (or a save from elsewhere) replaces the text.
        property <string> saved: root.text;
        changed saved => { edit.text = self.saved; }
        function commit() {
            if (edit.text != root.text) { root.save(edit.text); }
        }
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) { edit.text = root.text; return accept; }
            if (event.text == Key.Return && event.modifiers.control) { self.commit(); return accept; }
            reject
        }
        edit := TextEdit {
            width: parent.width;
            height: parent.height;
            text: root.text;
            wrap: word-wrap;
            font-size: Theme.font-body;
            placeholder-text: root.placeholder;
            accessible-label: root.label;
            changed has-focus => { if (!self.has-focus) { parent.commit(); } }
        }
    }
    if root.by != "": Text { text: root.by; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
    @children
}

// The open project's translation languages (L10N-08), set by the controller:
// the tags, and the same as the text the Overview field shows.
export global ProjectLanguages {
    in property <[string]> langs;
    in property <string> text;
}

// Inline translation editor under a description (job 069, FND-04): shows the
// existing translations and adds or clears one. No dialog; the draft saves on
// the button, and an empty text clears the translation. The add row offers
// only the project's languages, so a single-language project shows none.
export component TranslationEditor inherits VerticalLayout {
    in property <[TranslationItem]> items;
    in property <bool> editable;
    in-out property <int> lang-index;
    in-out property <string> draft-text;
    property <string> draft-lang: ProjectLanguages.langs[root.lang-index];
    callback save(string, string);
    callback remove(string);
    spacing: 4px;
    for t in root.items: HorizontalLayout {
        spacing: 6px;
        Text {
            text: t.lang + ": " + t.text;
            color: Theme.ink;
            font-size: Theme.font-body;
            wrap: word-wrap;
            horizontal-stretch: 1;
            accessible-role: AccessibleRole.text;
            accessible-label: @tr("Translation") + " " + t.lang;
        }
        Button {
            text: @tr("Remove");
            width: 76px;
            enabled: root.editable;
            clicked => { root.remove(t.lang); }
        }
    }
    if root.editable && ProjectLanguages.langs.length > 0: HorizontalLayout {
        spacing: 6px;
        ComboBox {
            width: 80px;
            model: ProjectLanguages.langs;
            current-index <=> root.lang-index;
            accessible-label: @tr("Language tag");
        }
        LineEdit {
            horizontal-stretch: 1;
            placeholder-text: @tr("Translation text");
            text <=> root.draft-text;
            accessible-label: @tr("Translation text");
            accepted(t) => { root.save(root.draft-lang, t); root.draft-text = ""; }
        }
        Button {
            text: @tr("Save");
            enabled: root.draft-text != "";
            clicked => { root.save(root.draft-lang, root.draft-text); root.draft-text = ""; }
        }
    }
}

// The inspector in draft mode (UI-08): a name field with focus. Enter or Tab
// creates the element, Ctrl/Cmd+Enter creates it and starts the next draft,
// Escape discards, and so does leaving the field empty. Leaving the field with a
// name creates it. The window only reports; the client core decides.
export component DraftForm inherits VerticalLayout {
    in property <string> title;
    in property <string> placeholder;
    in property <string> hint;
    // Changes with every new draft: the field starts empty again.
    in property <int> seq;
    // Why the last create was refused; the text stays (UI-08.6).
    in property <string> error;
    // A required field has no value yet: Create waits (UI-08.2).
    in property <bool> incomplete;
    // Leaving the field with a name creates the element. Off when the form has
    // other fields, so moving to one of them does not create it.
    in property <bool> blur-creates: true;
    callback commit(string, bool);
    callback cancel();
    property <bool> focused: edit.has-focus;
    spacing: 8px;
    SectionTitle { text: root.title; }
    FocusScope {
        min-height: edit.preferred-height;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel(); return accept; }
            if (event.text == Key.Return && event.modifiers.control) { root.commit(edit.text, true); return accept; }
            if (event.text == Key.Tab) { root.commit(edit.text, false); return accept; }
            reject
        }
        edit := LineEdit {
            width: parent.width;
            placeholder-text: root.placeholder;
            accessible-label: root.placeholder;
            accepted(t) => { root.commit(t, false); }
            init => { self.focus(); }
        }
    }
    @children
    if root.error != "": FieldError { text: root.error; }
    Text { text: root.hint; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
    Button {
        text: root.incomplete ? @tr("Choose the required fields") : @tr("Create");
        primary: true;
        enabled: edit.text != "" && !root.incomplete;
        clicked => { root.commit(edit.text, false); }
    }
    Rectangle { vertical-stretch: 1; }
    changed seq => {
        edit.text = "";
        edit.focus();
    }
    // The last required field got its value: back to the name, so Enter creates.
    changed incomplete => {
        if (!root.incomplete) { edit.focus(); }
    }
    changed focused => {
        if (!root.focused && root.blur-creates && edit.text != "") { root.commit(edit.text, false); }
    }
}

export component Panel inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.rule;
    border-radius: Theme.radius-panel;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        @children
    }
}

// The edge of a panel slot (UI-02): drag it to resize the panel. It only
// reports how far it was dragged; the window owns the size and remembers it
// on `released`. With `line` it is the 1 px rule between two panels (the
// grab area reaches 3 px either side); without, it fills the 16 px gap
// between a page and its panel.
export component Splitter inherits Rectangle {
    in property <bool> line;
    callback moved(length);
    callback released();
    width: root.line ? 1px : 16px;
    background: root.line ? Theme.rule : transparent;
    area := TouchArea {
        x: root.line ? -3px : 0px;
        width: root.line ? 7px : root.width;
        mouse-cursor: col-resize;
        moved => {
            if self.pressed {
                root.moved(self.mouse-x - self.pressed-x);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up {
                root.released();
            }
        }
    }
    Rectangle {
        x: (root.width - 2px) / 2;
        width: 2px;
        background: area.has-hover || area.pressed ? Theme.accent : transparent;
    }
}

// The top edge of the bottom panel slot (UI-02): drag it up or down. Like
// `Splitter` it only reports how far it was dragged.
export component HSplitter inherits Rectangle {
    callback moved(length);
    callback released();
    height: 1px;
    background: Theme.rule;
    area := TouchArea {
        y: -3px;
        height: 7px;
        mouse-cursor: row-resize;
        moved => {
            if self.pressed {
                root.moved(self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up {
                root.released();
            }
        }
    }
    Rectangle {
        y: -1px;
        height: 3px;
        background: area.has-hover || area.pressed ? Theme.accent : transparent;
    }
}

export component Swatch inherits Rectangle {
    in property <int> tone;
    width: 12px;
    height: 12px;
    background: Theme.tone(root.tone);
}

// A vertical list of related entities; a click reports the position.
export component LinkList inherits VerticalLayout {
    in property <[LinkItem]> items;
    in property <string> empty-text: @tr("None.");
    callback clicked(int);
    spacing: 2px;
    if root.items.length == 0: Text { text: root.empty-text; color: Theme.graphite; font-size: Theme.font-label; }
    for item[i] in root.items: Rectangle {
        height: 30px;
        background: area.has-hover ? Theme.wash : transparent;
        border-radius: Theme.radius-control;
        accessible-role: button;
        accessible-label: item.label;
        accessible-action-default => { root.clicked(i); }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            if item.tone > 0: Swatch { tone: item.tone; y: 9px; }
            Text { text: item.label; color: Theme.accent; font-size: Theme.font-body; font-weight: Theme.weight-semibold; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: item.detail; color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-medium; vertical-alignment: center; overflow: elide; }
        }
        area := TouchArea { clicked => { root.clicked(i); } }
    }
}

// Check boxes for a set of choices.
export component CheckList inherits VerticalLayout {
    in property <[CheckItem]> items;
    in property <bool> editable: true;
    in property <string> empty-text: @tr("None.");
    callback toggled(int, bool);
    spacing: 2px;
    if root.items.length == 0: Text { text: root.empty-text; color: Theme.graphite; font-size: Theme.font-label; }
    for item[i] in root.items: CheckBox {
        text: item.label;
        checked: item.checked;
        enabled: root.editable;
        toggled => { root.toggled(i, self.checked); }
    }
}

// Count tiles for the overview.
export component Tile inherits Rectangle {
    in property <string> label;
    in property <int> count;
    min-width: 120px;
    height: 70px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.rule;
    border-radius: Theme.radius-panel;
    VerticalLayout {
        padding: 10px;
        Text { text: root.count; font-size: 24px; font-weight: Theme.weight-heavy; letter-spacing: Theme.tracking-tight; color: Theme.ink; }
        Text { text: root.label; font-size: Theme.font-label; font-weight: Theme.weight-semibold; color: Theme.graphite; overflow: elide; }
    }
}

// Horizontal bars of a distribution.
export component Bars inherits VerticalLayout {
    in property <[CountItem]> items;
    in property <string> title;
    // The largest count, which gets the full width.
    in property <int> most: 1;
    spacing: 4px;
    SectionTitle { text: root.title; }
    for item in root.items: HorizontalLayout {
        spacing: 8px;
        Text { text: item.label; width: 90px; font-size: Theme.font-label; font-weight: Theme.weight-medium; color: Theme.ink; overflow: elide; }
        Rectangle {
            horizontal-stretch: 1;
            height: 14px;
            Rectangle {
                x: 0;
                width: item.count == 0 ? 2px : parent.width * min(1.0, item.count / max(1.0, root.most));
                background: item.tone == 0 ? Theme.rule : Theme.tone(item.tone);
            }
        }
        Text { text: item.count; width: 32px; font-size: Theme.font-label; font-weight: Theme.weight-bold; color: Theme.ink; horizontal-alignment: right; }
    }
}

// Attack-type -> feasibility-ceiling rules table for a security setting (CFG-04).
export component RulesTable inherits VerticalLayout {
    in property <[ControlRuleItem]> rules;
    in property <[string]> ceiling-options;
    in property <bool> editable: true;
    callback set-rule(int, int);
    spacing: 4px;
    HorizontalLayout {
        spacing: 6px;
        Text { text: @tr("Attack type"); color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-semibold; horizontal-stretch: 1; }
        Text { text: @tr("At most"); color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-semibold; width: 132px; }
    }
    for rule[idx] in root.rules: HorizontalLayout {
        spacing: 6px;
        Text { text: rule.label; color: Theme.ink; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Choice {
            width: 132px;
            options: root.ceiling-options;
            index: rule.level;
            editable: root.editable;
            label: rule.label;
            picked(lvl) => { root.set-rule(idx, lvl); }
        }
    }
}

// Security settings section in the component and interface inspectors (CFG-03 to CFG-05).
// Settings from the owning component appear dimmed on its interfaces; custom settings
// open an inline draft with a rules table (no modal).
export component SettingsSection inherits VerticalLayout {
    in property <[SettingItem]> settings;
    in property <[string]> available-controls;
    in property <[ControlRuleItem]> custom-rules;
    in property <[string]> ceiling-options;
    in property <bool> editable: true;
    in-out property <int> pick-index: 0;
    // Whether the "Add setting" list has the keyboard (read by tests).
    in-out property <bool> pick-focused;
    in-out property <bool> drafting-custom: false;
    in-out property <string> custom-name: "";
    callback apply-control(int);
    callback unapply-control(int);
    callback open-setting(int);
    callback begin-custom();
    callback set-custom-rule(int, int);
    callback create-custom(string);
    callback cancel-custom();
    spacing: 6px;
    SectionTitle { text: @tr("Security settings"); }
    if root.settings.length == 0 && !root.drafting-custom: Text {
        text: @tr("None.");
        color: Theme.graphite;
        font-size: Theme.font-label;
    }
    for item[i] in root.settings: Rectangle {
        background: open-area.has-hover ? Theme.wash : transparent;
        border-radius: Theme.radius-control;
        opacity: item.inherited ? Theme.disabled-opacity : 1.0;
        VerticalLayout {
            padding: 4px;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 24px;
                    accessible-role: button;
                    accessible-label: item.label;
                    accessible-action-default => { root.open-setting(i); }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: item.inherited ? (item.label + " · " + @tr("From") + " " + item.from-component + " (" + @tr("applies here too") + ")") : item.label;
                        color: item.inherited ? Theme.graphite : Theme.accent;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    open-area := TouchArea {
                        clicked => { root.open-setting(i); }
                    }
                }
                if !item.inherited && root.editable: Button {
                    text: @tr("Remove");
                    ghost: true;
                    enabled: root.editable;
                    clicked => { root.unapply-control(i); }
                }
            }
            Text {
                text: item.rules;
                color: Theme.graphite;
                font-size: Theme.font-label;
                wrap: word-wrap;
            }
        }
    }
    if root.editable && root.available-controls.length > 0 && !root.drafting-custom: HorizontalLayout {
        spacing: 6px;
        Choice {
            horizontal-stretch: 1;
            options: root.available-controls;
            index: root.pick-index;
            editable: root.editable;
            label: @tr("Add setting");
            has-focus <=> root.pick-focused;
            picked(i) => { root.pick-index = i; }
        }
        Button {
            text: @tr("Add setting");
            enabled: root.editable;
            clicked => { root.apply-control(root.pick-index); }
        }
    }
    if root.editable && !root.drafting-custom: Button {
        text: @tr("Custom setting");
        icon: @image-url("icons/plus.svg");
        enabled: root.editable;
        clicked => { root.custom-name = ""; root.begin-custom(); }
    }
    if root.editable && root.drafting-custom: VerticalLayout {
        spacing: 6px;
        SectionTitle { text: @tr("Custom setting"); }
        FocusScope {
            min-height: custom-edit.preferred-height;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) { root.cancel-custom(); return accept; }
                reject
            }
            custom-edit := LineEdit {
                width: parent.width;
                text <=> root.custom-name;
                placeholder-text: @tr("Control name");
                accessible-label: @tr("Custom setting");
                accepted(t) => { if (t != "") { root.create-custom(t); } }
                init => { self.focus(); }
            }
        }
        SectionTitle { text: @tr("Rules"); }
        if root.custom-rules.length == 0: Text {
            text: @tr("No attack types here, so a setting has no rules.");
            color: Theme.graphite;
            font-size: Theme.font-label;
            wrap: word-wrap;
        }
        if root.custom-rules.length > 0: RulesTable {
            rules: root.custom-rules;
            ceiling-options: root.ceiling-options;
            editable: root.editable;
            set-rule(idx, lvl) => { root.set-custom-rule(idx, lvl); }
        }
        HorizontalLayout {
            spacing: 6px;
            Button {
                text: @tr("Create");
                primary: true;
                enabled: root.custom-name != "";
                clicked => { root.create-custom(root.custom-name); }
            }
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel-custom(); }
            }
        }
    }
}
