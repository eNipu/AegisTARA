    // Opens the one-line input dialog. The answer comes back through
    // `prompt-accepted` with the same kind.
    public function ask(kind: string, title: string, label: string, text: string) {
        root.prompt-kind = kind;
        root.prompt-title = title;
        root.prompt-label = label;
        root.prompt-text = text;
        root.prompt-secret = false;
        root.prompt-open = true;
    }

    public function confirm(kind: string, text: string) {
        root.confirm-kind = kind;
        root.confirm-text = text;
        root.confirm-open = true;
    }

    function prompt-done(kind: string, text: string) {
        root.prompt-open = false;
        if (text == "") { return; }
        if (kind == "new-project") { root.create-project(text); }
        if (kind == "rename-project") { root.rename-project(text); }
        if (kind == "add-asset") { root.add-asset(text); }
        if (kind == "add-damage") { root.add-damage(text); }
        if (kind == "new-tree") { root.new-tree(text); }
        if (kind == "add-control") { root.add-control(text); }
        if (kind == "add-goal") { root.add-goal(text); }
        if (kind == "add-claim") { root.add-claim(text); }
        if (kind == "create-baseline") { root.create-baseline(text); }
        if (kind == "reset-password") { root.reset-user-password(text); }
    }

    function confirm-done(kind: string) {
        root.confirm-open = false;
        if (kind == "remove-asset") { root.remove-asset(); }
        if (kind == "remove-damage") { root.remove-damage(); }
        if (kind == "remove-threat") { root.remove-threat(); }
        if (kind == "remove-tree") { root.remove-tree(); }
        if (kind == "remove-tree-node") { root.remove-tree-node(); }
        if (kind == "remove-control") { root.remove-control(); }
        if (kind == "remove-goal") { root.remove-goal(); }
        if (kind == "remove-claim") { root.remove-claim(); }
        if (kind == "delete-user") { root.delete-user(); }
        if (kind == "revoke-session") { root.revoke-session(); }
        if (kind == "delete-project") { root.delete-project(); }
        if (kind == "break-lock") { root.break-lock(); }
        if (kind == "password-login-off") { root.set-password-login(false); }
        if (kind == "log-out") { root.log-out(); }
    }

    property <bool> in-project: root.connection == 1 && root.has-project;
    property <bool> online: root.connection == 1;

    // ===================================================================
    // Menus, with Lucide glyphs.
    // ===================================================================
    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New project folder…"; icon: @image-url("icons/file-plus.svg"); activated => { root.change-server(); } }
            MenuItem { title: "Open project folder…"; icon: @image-url("icons/folder-open.svg"); activated => { root.change-server(); } }
            MenuSeparator {}
            MenuItem { title: "New project…"; icon: @image-url("icons/file-plus.svg"); enabled: root.online; activated => { root.ask("new-project", "New project", "Project name", ""); } }
            MenuItem { title: "Projects"; icon: @image-url("icons/folder-open.svg"); enabled: root.online; activated => { root.close-project(); } }
            MenuItem { title: "Close project"; icon: @image-url("icons/folder-x.svg"); enabled: root.in-project; activated => { root.close-project(); } }
            MenuSeparator {}
            MenuItem { title: "Export TARA report (PDF)"; icon: @image-url("icons/file-down.svg"); enabled: root.in-project; activated => { root.export-pdf(); } }
            MenuItem { title: "Export TARA report (HTML)"; icon: @image-url("icons/file-text.svg"); enabled: root.in-project; activated => { root.export-report(); } }
            MenuItem { title: "Export risk register (CSV)"; icon: @image-url("icons/sheet.svg"); enabled: root.in-project; activated => { root.export-csv(); } }
            MenuItem { title: "Export attack tree (SVG)"; icon: @image-url("icons/image.svg"); enabled: root.in-project && root.has-tree; activated => { root.export-svg(); } }
            MenuSeparator {}
            MenuItem { title: "Change password…"; icon: @image-url("icons/key-round.svg"); enabled: root.online && root.is-password; activated => { root.pw-current = ""; root.pw-new = ""; root.pw-repeat = ""; root.password-open = true; } }
            MenuItem { title: "Change server…"; icon: @image-url("icons/server.svg"); activated => { root.change-server(); } }
            MenuItem { title: "Log out"; icon: @image-url("icons/log-out.svg"); enabled: root.online && !root.standalone-mode; activated => { root.confirm("log-out", "Log out of this server?"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; icon: @image-url("icons/undo-2.svg"); shortcut: @keys(Control + Z); enabled: root.in-project && root.editing && root.can-undo; activated => { root.undo(); } }
            MenuItem { title: "Redo"; icon: @image-url("icons/redo-2.svg"); shortcut: @keys(Control + Y); enabled: root.in-project && root.editing && root.can-redo; activated => { root.redo(); } }
            MenuSeparator {}
            MenuItem { title: "Take the edit lock"; icon: @image-url("icons/pencil.svg"); shortcut: @keys(Control + E); enabled: root.in-project && root.band-kind == 0; activated => { root.begin-edit(); } }
            MenuItem { title: "Release the edit lock"; icon: @image-url("icons/lock.svg"); enabled: root.in-project && root.editing; activated => { root.end-edit(); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Overview"; icon: @image-url("icons/layout-dashboard.svg"); shortcut: @keys(Control + "1"); enabled: root.in-project; activated => { root.show-page(Pages.overview); } }
            MenuItem { title: "Assets"; icon: @image-url("icons/box.svg"); shortcut: @keys(Control + "2"); enabled: root.in-project; activated => { root.show-page(Pages.assets); } }
            MenuItem { title: "Damage scenarios"; icon: @image-url("icons/triangle-alert.svg"); shortcut: @keys(Control + "3"); enabled: root.in-project; activated => { root.show-page(Pages.damage); } }
            MenuItem { title: "Threat scenarios"; icon: @image-url("icons/swords.svg"); shortcut: @keys(Control + "4"); enabled: root.in-project; activated => { root.show-page(Pages.threats); } }
            MenuItem { title: "Attack trees"; icon: @image-url("icons/network.svg"); shortcut: @keys(Control + "5"); enabled: root.in-project; activated => { root.show-page(Pages.trees); } }
            MenuItem { title: "Risks and treatment"; icon: @image-url("icons/gauge.svg"); shortcut: @keys(Control + "6"); enabled: root.in-project; activated => { root.show-page(Pages.risks); } }
            MenuItem { title: "Security controls"; icon: @image-url("icons/shield-check.svg"); shortcut: @keys(Control + "7"); enabled: root.in-project; activated => { root.show-page(Pages.controls); } }
            MenuItem { title: "Goals and claims"; icon: @image-url("icons/target.svg"); shortcut: @keys(Control + "8"); enabled: root.in-project; activated => { root.show-page(Pages.goals); } }
            MenuItem { title: "Problems"; icon: @image-url("icons/circle-alert.svg"); shortcut: @keys(Control + "9"); enabled: root.in-project; activated => { root.show-page(Pages.problems); } }
            MenuSeparator {}
            MenuItem { title: "Risk after controls"; icon: @image-url("icons/eye.svg"); checkable: true; checked: root.show-residual; enabled: root.in-project; activated => { root.set-residual(!root.show-residual); } }
            MenuItem { title: "Fit the tree"; icon: @image-url("icons/maximize.svg"); enabled: root.in-project && root.has-tree; activated => { root.fit(); } }
            MenuItem { title: "Zoom to 100%"; icon: @image-url("icons/zoom-in.svg"); enabled: root.in-project && root.has-tree; activated => { root.zoom-reset(); } }
            MenuSeparator {}
            MenuItem {
                title: "Dark theme";
                checkable: true;
                checked: Theme.dark;
                activated => {
                    Palette.color-scheme = Theme.dark ? ColorScheme.light : ColorScheme.dark;
                }
            }
        }
        Menu {
            title: "Project";
            MenuItem { title: "Rename project…"; icon: @image-url("icons/pencil.svg"); enabled: root.in-project && root.editing; activated => { root.ask("rename-project", "Rename project", "Project name", root.project-name); } }
            MenuItem { title: "Add the sample TARA"; icon: @image-url("icons/plus.svg"); enabled: root.in-project && root.editing && root.is-empty; activated => { root.create-sample(); } }
            MenuSeparator {}
            MenuItem { title: "Reload newer version"; icon: @image-url("icons/refresh-cw.svg"); enabled: root.in-project && root.newer-version; activated => { root.reload(); } }
            MenuItem { title: "Create baseline…"; icon: @image-url("icons/flag.svg"); enabled: root.in-project; activated => { root.ask("create-baseline", "Create baseline", "Baseline name, for example B1 Design freeze", ""); } }
            MenuItem { title: "Versions and comparison"; icon: @image-url("icons/git-compare.svg"); enabled: root.in-project; activated => { root.show-page(Pages.versions); } }
            MenuItem { title: "History"; icon: @image-url("icons/history.svg"); enabled: root.in-project; activated => { root.show-page(Pages.history); } }
            MenuItem { title: "Reports"; icon: @image-url("icons/file-chart-column.svg"); enabled: root.in-project; activated => { root.show-page(Pages.reports); } }
        }
        Menu {
            title: "Admin";
            MenuItem { title: "Users and project tools"; icon: @image-url("icons/user-cog.svg"); enabled: root.in-project && root.is-admin; activated => { root.show-page(Pages.admin); } }
            MenuItem { title: "Check the audit chain"; icon: @image-url("icons/list-checks.svg"); enabled: root.in-project && root.is-admin; activated => { root.verify-audit(); } }
            MenuItem { title: "Break the edit lock"; icon: @image-url("icons/unlink.svg"); enabled: root.in-project && root.is-admin && root.band-kind == 1; activated => { root.confirm("break-lock", "Break the edit lock? The other editor's unsaved changes are lost."); } }
            MenuItem { title: "Delete project…"; icon: @image-url("icons/trash-2.svg"); enabled: root.in-project && root.is-admin; activated => { root.confirm("delete-project", "Delete this project, its history and its baselines? This cannot be undone."); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "Keyboard shortcuts"; icon: @image-url("icons/keyboard.svg"); activated => { root.show-shortcuts = true; } }
            MenuItem { title: "Check for updates"; icon: @image-url("icons/refresh-cw.svg"); activated => { root.check-for-updates(); } }
            MenuItem { title: "Download update"; icon: @image-url("icons/file-down.svg"); activated => { root.download-update(); } }
            MenuItem { title: "About AegisTARA"; icon: @image-url("icons/info.svg"); activated => { root.show-about = true; } }
        }
    }

    // ===================================================================
    // Not connected: one centered card with dark-mode splash header.
    // ===================================================================
    if root.connection != 1: Rectangle {
        background: Theme.dark
            ? @linear-gradient(180deg, Theme.obsidian-core 0%, Theme.obsidian-edge 100%)
            : Theme.sheet;
        Rectangle {
            width: min(parent.width - 48px, 500px);
            height: splash-banner.height + card-column.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 3px;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                splash-banner := SplashHeader {
                    banner-height: root.connection == 4 ? 136px : 152px;
                    status-text: root.connection == 0 ? "CONNECTING"
                        : root.connection == 2 ? "OFFLINE"
                        : root.connection == 3 ? "AUTH REQUIRED"
                        : "SERVER & WORKSPACE";
                    status-color: root.connection == 2 ? Theme.high
                        : root.connection == 3 ? Theme.medium
                        : Theme.crimson-bright;
                }
                card-column := VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    if root.server-name != "" && root.connection == 3: HorizontalLayout {
                        spacing: 8px;
                        Image { source: @image-url("icons/server.svg"); width: 16px; height: 16px; y: 2px; colorize: Theme.accent; }
                        Text { text: root.server-name; color: Theme.ink; font-size: 14px; font-weight: 600; }
                    }
                    Text {
                        text: root.connection-text;
                        wrap: word-wrap;
                        color: Theme.graphite;
                        font-size: 13px;
                        accessible-role: text;
                    }
                    // Choose a server.
                    if root.connection == 4: VerticalLayout {
                        spacing: 8px;
                        Field {
                            label: "Server address";
                            url-edit := LineEdit {
                                text <=> root.server-url;
                                placeholder-text: "https://aegis.example.com";
                                accessible-label: "Server address";
                                accepted(t) => { root.connect-server(t, root.transport-index); }
                            }
                        }
                        Field {
                            label: "Connection";
                            Choice {
                                options: ["Automatic", "gRPC (HTTP/2)", "gRPC-Web (HTTP/1.1, through any proxy)"];
                                index: root.transport-index;
                                label: "Connection";
                                picked(i) => { root.transport-index = i; }
                            }
                        }
                        Button {
                            text: "Connect";
                            icon: @image-url("icons/server.svg");
                            primary: true;
                            enabled: root.server-url != "" && !root.login-busy;
                            clicked => { root.connect-server(root.server-url, root.transport-index); }
                        }
                        Rectangle { height: 1px; background: Theme.rule; }
                        Text { text: "Or work without a server"; color: Theme.graphite; font-size: 12px; font-weight: 600; }
                        Field {
                            label: "Project folder";
                            LineEdit {
                                text <=> root.standalone-folder;
                                placeholder-text: "/path/to/project-folder";
                                accessible-label: "Standalone project folder";
                            }
                        }
                        Field {
                            label: "Signed license file";
                            LineEdit {
                                text <=> root.standalone-license;
                                placeholder-text: "/path/to/license.aegis";
                                accessible-label: "Standalone license file";
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "New folder";
                                icon: @image-url("icons/file-plus.svg");
                                enabled: root.standalone-folder != "" && root.standalone-license != "" && !root.login-busy;
                                clicked => { root.new-project-folder(root.standalone-folder, root.standalone-license); }
                            }
                            Button {
                                text: "Open folder";
                                icon: @image-url("icons/folder-open.svg");
                                primary: true;
                                enabled: root.standalone-folder != "" && root.standalone-license != "" && !root.login-busy;
                                clicked => { root.open-project-folder(root.standalone-folder, root.standalone-license); }
                            }
                        }
                    }
                    if root.connection == 2: HorizontalLayout {
                        spacing: 8px;
                        Button { text: "Try again"; icon: @image-url("icons/refresh-cw.svg"); clicked => { root.retry(); } }
                        Button { text: "Change server"; icon: @image-url("icons/server.svg"); clicked => { root.change-server(); } }
                    }
                    // Password login.
                    if root.connection == 3 && root.login-method == 1: VerticalLayout {
                        spacing: 10px;
                        Field {
                            label: "User name";
                            LineEdit {
                                text <=> root.login-user;
                                accessible-label: "User name";
                            }
                        }
                        Field {
                            label: "Password";
                            LineEdit {
                                text <=> root.login-password;
                                input-type: password;
                                accessible-label: "Password";
                                accepted(t) => { root.password-log-in(root.login-user, root.login-password, root.remember); }
                            }
                        }
                        CheckBox { text: "Keep me logged in on this computer"; checked <=> root.remember; }
                        if root.login-error != "": Text { text: root.login-error; color: Theme.high; wrap: word-wrap; font-size: 13px; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.login-busy ? "Logging in…" : "Log in";
                                icon: @image-url("icons/log-in.svg");
                                primary: true;
                                enabled: root.login-user != "" && root.login-password != "" && !root.login-busy;
                                clicked => { root.password-log-in(root.login-user, root.login-password, root.remember); }
                            }
                            Button { text: "Change server"; clicked => { root.change-server(); } }
                            if root.password-also: Button { text: "Use company login"; icon: @image-url("icons/key-round.svg"); clicked => { root.use-company-login(); } }
                        }
                    }
                    // Development login.
                    if root.connection == 3 && root.login-method == 2: VerticalLayout {
                        spacing: 10px;
                        Text { text: "Development server: no password is checked."; color: Theme.medium; font-size: 12px; }
                        Field {
                            label: "User name";
                            LineEdit { text <=> root.login-user; accessible-label: "User name"; accepted(t) => { root.dev-log-in(t); } }
                        }
                        Button { text: "Continue"; primary: true; enabled: root.login-user != ""; clicked => { root.dev-log-in(root.login-user); } }
                    }
                    // Company login.
                    if root.connection == 3 && root.login-method == 0: VerticalLayout {
                        spacing: 8px;
                        if root.login-error != "": Text { text: root.login-error; color: Theme.high; wrap: word-wrap; font-size: 13px; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Log in"; primary: true; clicked => { root.log-in(); } }
                            Button { text: "Change server"; clicked => { root.change-server(); } }
                            if root.password-also: Button { text: "Use a user name and password"; clicked => { root.use-password-login(); } }
                        }
                    }
                }
            }
        }
    }

    // ===================================================================
    // Connected, no project open: the project list.
    // ===================================================================
    if root.connection == 1 && !root.has-project: Rectangle {
        background: Theme.dark
            ? @linear-gradient(180deg, Theme.obsidian-core 0%, Theme.obsidian-edge 100%)
            : Theme.sheet;
        Rectangle {
            width: min(parent.width - 48px, 640px);
            height: min(parent.height - 48px, 580px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 3px;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                SplashHeader {
                    banner-height: 136px;
                    status-text: root.standalone-mode ? "STANDALONE" : "ONLINE";
                    status-color: Theme.very-low;
                }
                VerticalLayout {
                    vertical-stretch: 1;
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        Image { source: @image-url("icons/folder-open.svg"); width: 20px; height: 20px; y: 5px; colorize: Theme.accent; }
                        Text {
                            text: "Projects";
                            font-size: Theme.font-display;
                            font-weight: Theme.weight-heavy;
                            letter-spacing: Theme.tracking-tight;
                            color: Theme.ink;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Refresh"; icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-projects(); } }
                        Button { text: "About"; icon: @image-url("icons/info.svg"); clicked => { root.show-about = true; } }
                    }
                    if root.projects.length == 0: Text {
                        text: "There are no projects yet. Create the first one below.";
                        color: Theme.graphite;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-medium;
                        wrap: word-wrap;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for p in root.projects: Rectangle {
                                height: 44px;
                                background: area.has-hover ? Theme.wash : transparent;
                                border-width: 1px;
                                border-color: area.has-hover ? Theme.accent : Theme.rule;
                                border-radius: 2px;
                                accessible-role: button;
                                accessible-label: "Open project " + p.name;
                                accessible-action-default => { root.open-project(p.id); }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Text {
                                        text: p.name;
                                        color: Theme.ink;
                                        font-size: Theme.font-h2;
                                        font-weight: Theme.weight-bold;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.methodology;
                                        color: Theme.graphite;
                                        font-size: Theme.font-label;
                                        font-weight: Theme.weight-semibold;
                                        vertical-alignment: center;
                                    }
                                }
                                area := TouchArea { clicked => { root.open-project(p.id); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: "New project name";
                            text <=> root.new-project-name;
                            accepted(t) => {
                                if (t != "") { root.create-project(t); root.new-project-name = ""; }
                            }
                        }
                        Choice {
                            options: ["ISO/SAE 21434 (Automotive)", "EU CRA (Annex I)"];
                            index <=> root.new-project-methodology;
                            label: "Methodology";
                        }
                        Button {
                            text: "Create";
                            icon: @image-url("icons/file-plus.svg");
                            primary: true;
                            enabled: root.new-project-name != "";
                            clicked => {
                                root.create-project(root.new-project-name);
                                root.new-project-name = "";
                            }
                        }
                    }
                    Text { text: (root.standalone-mode ? "Standalone project. " : "Logged in as " + root.user + ". ") + root.engine-text; color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-medium; overflow: elide; }
                }
            }
        }
    }

    // ===================================================================
    // A project is open.
    // ===================================================================
    if root.in-project: VerticalLayout {
        // ---- mode band ----
        Rectangle {
            height: 32px;
            background: root.band-kind == 2 ? Theme.band : Theme.wash;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Image {
                    source: root.band-kind == 2 ? @image-url("icons/pencil.svg") : @image-url("icons/lock.svg");
                    width: 16px;
                    height: 16px;
                    y: 8px;
                    colorize: root.band-kind == 2 ? Theme.band-text : Theme.ink;
                }
                Text {
                    text: root.band-text;
                    color: root.band-kind == 2 ? Theme.band-text : Theme.ink;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-role: text;
                }
                if root.newer-version: Button {
                    text: "Reload";
                    icon: @image-url("icons/refresh-cw.svg");
                    primary: true;
                    accessible-label: "Reload the newer version";
                    clicked => { root.reload(); }
                }
                if root.band-kind == 0: Button {
                    text: "Edit";
                    primary: root.band-kind == 0 && !root.newer-version;
                    clicked => { root.begin-edit(); }
                }
                if root.band-kind == 2: Button {
                    text: "Release edit lock";
                    clicked => { root.end-edit(); }
                }
            }
        }
        // ---- header ----
        Rectangle {
            height: 52px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 16px;
                spacing: 10px;
                Image {
                    source: @image-url("brand/App_Icon_Resolutions/AegisTARA_Icon_64x64.png");
                    width: 30px;
                    height: 30px;
                    y: 11px;
                }
                Rectangle { width: 1px; height: 24px; y: 14px; background: Theme.rule; }
                Button { text: "Projects"; icon: @image-url("icons/folder-open.svg"); clicked => { root.close-project(); } }
                Text {
                    text: root.project-name;
                    font-size: Theme.font-h1;
                    font-weight: Theme.weight-heavy;
                    letter-spacing: Theme.tracking-tight;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.sync-text;
                    color: Theme.graphite;
                    font-size: Theme.font-label;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 4px;
                    accessible-role: text;
                    accessible-label: root.numbers-text;
                    Image {
                        source: root.numbers-kind == 0 ? @image-url("icons/badge-check.svg") : root.numbers-kind == 1 ? @image-url("icons/refresh-cw.svg") : @image-url("icons/triangle-alert.svg");
                        colorize: root.numbers-kind == 0 ? Theme.very-low : root.numbers-kind == 1 ? Theme.graphite : Theme.high;
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.numbers-text;
                        color: root.numbers-kind == 0 ? Theme.ink : root.numbers-kind == 1 ? Theme.graphite : Theme.high;
                        font-size: Theme.font-label;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                    }
                }
                Button { text: "Undo"; icon: @image-url("icons/undo-2.svg"); enabled: root.can-undo && root.editing; clicked => { root.undo(); } }
                Button { text: "Redo"; icon: @image-url("icons/redo-2.svg"); enabled: root.can-redo && root.editing; clicked => { root.redo(); } }
                if root.is-empty && root.editing: Button {
                    text: "Add sample TARA";
                    primary: true;
                    clicked => { root.create-sample(); }
                }
                Rectangle {
                    width: residual-switch.preferred-width;
                    residual-switch := Switch {
                        text: "Risk after controls";
                        checked: root.show-residual;
                        toggled => { root.set-residual(self.checked); }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.rule; }

        HorizontalLayout {
            vertical-stretch: 1;
            // ---- TARA steps ----
            Rectangle {
                width: 210px;
                background: Theme.panel;
                ScrollView {
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        for item[i] in [
                            { label: "Overview", icon: @image-url("icons/layout-dashboard.svg") },
                            { label: "Assets", icon: @image-url("icons/box.svg") },
                            { label: root.damage-plural, icon: @image-url("icons/triangle-alert.svg") },
                            { label: "Threat scenarios", icon: @image-url("icons/swords.svg") },
                            { label: "Attack trees", icon: @image-url("icons/network.svg") },
                            { label: "Risks and treatment", icon: @image-url("icons/gauge.svg") },
                            { label: "Security controls", icon: @image-url("icons/shield-check.svg") },
                            { label: "Goals and claims", icon: @image-url("icons/target.svg") },
                            { label: "Problems", icon: @image-url("icons/circle-alert.svg") },
                            { label: "Versions", icon: @image-url("icons/git-compare.svg") },
                            { label: "History", icon: @image-url("icons/history.svg") },
                            { label: "Reports", icon: @image-url("icons/file-chart-column.svg") },
                            { label: "Administration", icon: @image-url("icons/user-cog.svg") },
                        ]: Rectangle {
                            visible: i != Pages.admin || root.is-admin;
                            height: self.visible ? 36px : 0px;
                            background: root.page == i ? Theme.accent-wash : (nav-area.has-hover ? Theme.wash : transparent);
                            accessible-role: button;
                            accessible-label: item.label;
                            accessible-action-default => { root.show-page(i); }
                            Rectangle { x: 0; width: 3px; background: root.page == i ? Theme.accent : transparent; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 10px;
                                Image { source: item.icon; width: 18px; height: 18px; y: 9px; colorize: root.page == i ? Theme.accent : Theme.graphite; }
                                Text {
                                    text: item.label;
                                    color: Theme.ink;
                                    font-size: Theme.font-body;
                                    font-weight: root.page == i ? Theme.weight-bold : Theme.weight-medium;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.nav-counts[i];
                                    color: i == Pages.problems && root.nav-counts[i] != "" && root.nav-counts[i] != "0" ? Theme.high : Theme.graphite;
                                    font-size: Theme.font-label;
                                    font-weight: root.page == i ? Theme.weight-bold : Theme.weight-semibold;
                                    vertical-alignment: center;
                                }
                            }
                            nav-area := TouchArea { clicked => { root.show-page(i); } }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.rule; }

            // ---- the page ----
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.sheet;

                // Overview
                if root.page == Pages.overview: ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        PageTitle { title: "Overview"; subtitle: "The project at a glance: what is analysed, how risky it is, and what is still open."; icon: @image-url("icons/layout-dashboard.svg"); }
                        DescriptionFor { items: root.descriptions; kind: "project"; label: "Project notes"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;
                            for c in root.ov-counts: Tile { label: c.label; count: c.count; }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 16px;
                            Panel {
                                horizontal-stretch: 1;
                                Bars { title: "Threat scenarios by risk before controls"; items: root.ov-inherent; most: root.ov-most; }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                Bars { title: "Threat scenarios by risk after controls"; items: root.ov-residual; most: root.ov-most; }
                            }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 16px;
                            Panel {
                                horizontal-stretch: 2;
                                SectionTitle { text: "Highest risks"; }
                                LinkList { items: root.ov-top; empty-text: "No threat scenario yet."; clicked(i) => { root.ov-top-clicked(i); } }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                SectionTitle { text: "Problems"; }
                                Text { text: root.ov-errors + " blocking, " + root.ov-warnings + " warnings"; color: root.ov-errors > 0 ? Theme.high : Theme.ink; font-size: 14px; }
                                Button { text: "Show problems"; icon: @image-url("icons/circle-alert.svg"); clicked => { root.show-page(Pages.problems); } }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Assets
                if root.page == Pages.assets: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: "Assets";
                            subtitle: "What must be protected, and which security properties matter.";
                            icon: @image-url("icons/box.svg");
                            Button { text: "Add asset"; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.ask("add-asset", "Add asset", "Asset name", ""); } }
                        }
                        Table {
                            label: "Assets";
                            columns: [{ title: "Asset", horizontal-stretch: 2 }, { title: "Properties", horizontal-stretch: 2 }, { title: "Threats", horizontal-stretch: 1 }, { title: "Worst risk", horizontal-stretch: 1 }];
                            rows: root.asset-rows;
                            selected: root.asset-selected;
                            picked(i) => { root.pick-asset(i); }
                        }
                    }
                    if root.has-asset: Panel {
                        width: root.side-width;
                        SectionTitle { text: "Asset"; }
                        NameEditor { name: root.asset-name; editable: root.editing; renamed(t) => { root.rename-asset(t); } }
                        DescriptionFor { items: root.descriptions; kind: "asset"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                        SectionTitle { text: "Security properties"; }
                        CheckList { items: root.asset-properties; editable: root.editing; toggled(i, on) => { root.toggle-asset-property(i, on); } }
                        SectionTitle { text: "Threat scenarios on this asset"; }
                        LinkList { items: root.asset-threats; clicked(i) => { root.asset-threat-clicked(i); } }
                        Text { text: root.asset-changed; color: Theme.graphite; font-size: 11px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: "Remove asset"; icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.confirm("remove-asset", "Remove asset \"" + root.asset-name + "\"?"); } }
                    }
                }

                // Damage scenarios
                if root.page == Pages.damage: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: root.damage-plural;
                            subtitle: "What could go wrong, rated per impact category.";
                            icon: @image-url("icons/triangle-alert.svg");
                            Button { text: "Add " + root.damage-singular; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.ask("add-damage", "Add " + root.damage-singular, "What happens", ""); } }
                        }
                        Table {
                            label: root.damage-plural;
                            columns: [{ title: root.damage-singular, horizontal-stretch: 2 }, { title: "Impact", horizontal-stretch: 2 }, { title: "Threats", horizontal-stretch: 1 }];
                            rows: root.damage-rows;
                            selected: root.damage-selected;
                            picked(i) => { root.pick-damage(i); }
                        }
                    }
                    if root.has-damage: Panel {
                        width: root.side-width;
                        SectionTitle { text: root.damage-singular; }
                        NameEditor { name: root.damage-name; editable: root.editing; renamed(t) => { root.rename-damage(t); } }
                        DescriptionFor { items: root.descriptions; kind: "damage"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                        SectionTitle { text: "Impact rating"; }
                        for f[fi] in root.damage-impacts: Field {
                            label: f.label;
                            Choice { options: f.options; index: f.selected; editable: root.editing; label: f.label; picked(i) => { root.set-impact(fi, i); } }
                        }
                        SectionTitle { text: "Threat scenarios leading here"; }
                        LinkList { items: root.damage-threats; clicked(i) => { root.damage-threat-clicked(i); } }
                        Text { text: root.damage-changed; color: Theme.graphite; font-size: 11px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: "Remove damage scenario"; icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.confirm("remove-damage", "Remove damage scenario \"" + root.damage-name + "\"? It is unlinked from its threat scenarios."); } }
                    }
                }

                // Threat scenarios
                if root.page == Pages.threats: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle { title: "Threat scenarios"; subtitle: "How an attacker could harm an asset, with STRIDE and UN R155 Annex 5."; icon: @image-url("icons/swords.svg"); }
                        if root.editing: Panel {
                            SectionTitle { text: "Add a threat scenario"; }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit { horizontal-stretch: 1; placeholder-text: "Threat scenario"; text <=> root.new-threat-name; accessible-label: "New threat scenario"; }
                                Button {
                                    text: "Add";
                                    icon: @image-url("icons/plus.svg");
                                    enabled: root.new-threat-name != "" && root.asset-names.length > 0;
                                    clicked => { root.add-threat(root.new-threat-name, root.new-threat-asset, root.new-threat-category); root.new-threat-name = ""; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Choice { horizontal-stretch: 1; options: root.asset-names; index: root.new-threat-asset; label: "Asset"; picked(i) => { root.new-threat-asset = i; } }
                                Choice { horizontal-stretch: 1; options: root.threat-categories; index: root.new-threat-category; label: "Category"; picked(i) => { root.new-threat-category = i; } }
                            }
                            if root.asset-names.length == 0: Text { text: "Add an asset first."; color: Theme.graphite; font-size: 12px; }
                        }
                        Table {
                            label: "Threat scenarios";
                            columns: [{ title: "Threat scenario", horizontal-stretch: 3 }, { title: "Asset", horizontal-stretch: 2 }, { title: "Before", horizontal-stretch: 1 }, { title: "After", horizontal-stretch: 1 }];
                            rows: root.threat-rows;
                            selected: root.threat-selected;
                            picked(i) => { root.select-threat(i); }
                        }
                    }
                    if root.has-threat-detail: ScrollView {
                        width: root.side-width + 30px;
                        Panel {
                            width: root.side-width + 12px;
                            SectionTitle { text: "Threat scenario"; }
                            NameEditor { name: root.td-name; editable: root.editing; renamed(t) => { root.rename-threat(t); } }
                            DescriptionFor { items: root.descriptions; kind: "threat"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                            Text { text: "On asset " + root.td-asset; color: Theme.graphite; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                Swatch { tone: root.td-inherent-tone; y: 4px; }
                                Text { text: "Before controls: " + (root.td-inherent == "" ? "not rated" : root.td-inherent); color: Theme.ink; font-size: 13px; }
                                Swatch { tone: root.td-residual-tone; y: 4px; }
                                Text { text: "After: " + (root.td-residual == "" ? "not rated" : root.td-residual); color: Theme.ink; font-size: 13px; }
                            }
                            for line in root.td-why: Text { text: line; color: Theme.graphite; font-size: 12px; wrap: word-wrap; }
                            Field {
                                label: "Category";
                                Choice { options: root.threat-categories; index: root.td-category; editable: root.editing; label: "Category"; picked(i) => { root.set-threat-category(i); } }
                            }
                            SectionTitle { text: "Damage scenarios it leads to"; }
                            CheckList { items: root.td-damages; editable: root.editing; empty-text: "Add a damage scenario first."; toggled(i, on) => { root.toggle-threat-damage(i, on); } }
                            SectionTitle { text: "Catalog references"; }
                            for r[ri] in root.td-refs: HorizontalLayout {
                                spacing: 6px;
                                Text { text: r; color: Theme.ink; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { text: "Remove"; enabled: root.editing; clicked => { root.remove-catalog-ref(ri); } }
                            }
                            if root.editing: Choice { options: root.catalog-schemes; index: root.new-ref-scheme; label: "Catalog"; picked(i) => { root.new-ref-scheme = i; } }
                            if root.editing: HorizontalLayout {
                                spacing: 6px;
                                LineEdit { horizontal-stretch: 1; placeholder-text: "4.1"; text <=> root.new-ref-text; accessible-label: "Reference"; }
                                Button { text: "Add"; enabled: root.new-ref-text != ""; clicked => { root.add-catalog-ref(root.new-ref-scheme, root.new-ref-text); root.new-ref-text = ""; } }
                            }
                            Field {
                                label: "Attack tree";
                                HorizontalLayout {
                                    spacing: 6px;
                                    Choice { horizontal-stretch: 1; options: root.tree-names; index: root.td-tree; editable: root.editing; label: "Attack tree"; picked(i) => { root.set-threat-tree(i); } }
                                    if root.td-tree > 0: Button { text: "Open"; icon: @image-url("icons/network.svg"); clicked => { root.open-threat-tree(); } }
                                    if root.td-tree == 0: Button { text: "New tree"; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.new-tree-for-threat(); } }
                                }
                            }
                            Field {
                                label: "Direct feasibility rating (concept phase; an attack tree overrides it)";
                                Choice { options: root.feasibility-options; index: root.td-feasibility; editable: root.editing; label: "Direct feasibility"; picked(i) => { root.set-threat-feasibility(i); } }
                            }
                            if root.td-feasibility-text != "": Text { text: "Feasibility the engine uses: " + root.td-feasibility-text; color: Theme.graphite; font-size: 12px; }
                            Text { text: root.td-changed; color: Theme.graphite; font-size: 11px; wrap: word-wrap; }
                            Button { text: "Remove threat scenario"; icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.confirm("remove-threat", "Remove threat scenario \"" + root.td-name + "\"?"); } }
                        }
                    }
                }

                // Attack trees
                if root.page == Pages.trees: HorizontalLayout {
                    VerticalLayout {
                        width: root.tree-list-width;
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 6px;
                            SectionTitle { text: "Attack trees"; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "New"; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.ask("new-tree", "New attack tree", "The attacker's goal (the root)", ""); } }
                        }
                        Table {
                            label: "Attack trees";
                            columns: [{ title: "Tree", horizontal-stretch: 1 }, { title: "Rating", width: 92px, min-width: 92px }];
                            rows: root.tree-rows;
                            selected: root.tree-selected;
                            picked(i) => { root.pick-tree(i); }
                        }
                        if root.has-tree: HorizontalLayout {
                            spacing: 6px;
                            Button { text: "Edit outline"; icon: @image-url("icons/pencil.svg"); enabled: root.editing; clicked => { root.outline-draft = root.outline-text; root.outline-open = true; } }
                            Button { text: "Delete"; icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.confirm("remove-tree", "Delete this attack tree? Its threat scenarios lose their tree."); } }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { horizontal-stretch: 1; text: "Library"; icon: @image-url("icons/box.svg"); accessible-description: "Search the attack tree library and copy an item into the project"; clicked => { root.library-opened(); root.library-open = true; } }
                            if root.has-tree: Button { horizontal-stretch: 1; text: "Suggest steps"; icon: @image-url("icons/workflow.svg"); enabled: root.editing; accessible-description: "Synthesize ghost attack-tree steps with Aegis-Core Gear 1"; clicked => { root.suggest-tree-nodes(); } }
                        }
                        if root.has-tree: Button { text: "Export SVG"; icon: @image-url("icons/image.svg"); clicked => { root.export-svg(); } }
                        DescriptionFor { items: root.descriptions; kind: "tree"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                        // Legend.
                        VerticalLayout {
                            spacing: 4px;
                            SectionTitle { text: "Attack feasibility"; }
                            for entry[i] in ["High", "Medium", "Low", "Very low"]: HorizontalLayout {
                                spacing: 8px;
                                Swatch { tone: 4 - i; y: 2px; }
                                Text { text: entry; font-size: Theme.font-label; font-weight: Theme.weight-medium; color: Theme.graphite; }
                            }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.rule; }
                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            Rectangle {
                                height: 30px;
                                background: Theme.panel;
                                Text { x: 12px; text: root.tree-title; color: Theme.ink; font-size: Theme.font-body; font-weight: Theme.weight-semibold; vertical-alignment: center; overflow: elide; width: parent.width - 24px; }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                Canvas {
                                    items: root.draw;
                                    path-items: root.draw-paths;
                                    rect-items: root.draw-rects;
                                    text-items: root.draw-texts;
                                    access-nodes: root.access-nodes;
                                    node-activated(n) => { root.canvas-node-activated(n); }
                                    accessible-summary: root.canvas-summary;
                                    pointer-down(x, y) => { root.canvas-down(x, y); }
                                    pointer-move(x, y) => { root.canvas-move(x, y); }
                                    pointer-up(x, y) => { root.canvas-up(x, y); }
                                    scrolled(x, y, d) => { root.canvas-scroll(x, y, d); }
                                    key(text, shift) => { return root.canvas-key(text, shift); }
                                    resized(w, h) => {
                                        root.canvas-x = self.absolute-position.x;
                                        root.canvas-y = self.absolute-position.y;
                                        root.canvas-resized(w, h);
                                    }
                                }
                                if !root.has-tree: Text {
                                    text: root.tree-rows.length == 0
                                        ? "This project has no attack trees yet. Create one with New, or from a threat scenario."
                                        : "Choose an attack tree on the left.";
                                    color: Theme.graphite;
                                    font-size: 14px;
                                    font-weight: Theme.weight-medium;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    x: 12px;
                                    y: parent.height - 44px;
                                    width: 170px;
                                    height: 32px;
                                    spacing: 6px;
                                    Button { text: "Fit"; icon: @image-url("icons/maximize.svg"); clicked => { root.fit(); } }
                                    Button { text: root.zoom-text; clicked => { root.zoom-reset(); } }
                                }
                            }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.rule; }
                    // Inspector
                    Rectangle {
                        width: root.inspector-width;
                        background: Theme.panel;
                        if !root.has-inspector && root.suggestion-rows.length == 0: Text {
                            text: "Select a node on the canvas to inspect its feasibility or expand the attack tree.";
                            color: Theme.graphite;
                            wrap: word-wrap;
                            font-size: Theme.font-body;
                            font-weight: Theme.weight-medium;
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                        }
                        if root.has-inspector || root.suggestion-rows.length > 0: ScrollView {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                if root.suggestion-rows.length > 0: VerticalLayout {
                                    spacing: 8px;
                                    SectionTitle { text: "AI suggestions (Gear 1)"; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: "Accept all";
                                            icon: @image-url("icons/badge-check.svg");
                                            primary: true;
                                            enabled: root.editing;
                                            clicked => { root.accept-all-suggestions(); }
                                        }
                                        Button {
                                            horizontal-stretch: 1;
                                            text: "Dismiss all";
                                            icon: @image-url("icons/x.svg");
                                            clicked => { root.reject-all-suggestions(); }
                                        }
                                    }
                                    for s[si] in root.suggestion-rows: Rectangle {
                                        background: s.selected ? Theme.wash : Theme.sheet;
                                        border-width: 1px;
                                        border-color: s.selected ? Theme.accent : Theme.rule;
                                        border-radius: 2px;
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 4px;
                                            Text {
                                                text: s.label;
                                                color: Theme.ink;
                                                font-size: Theme.font-body;
                                                font-weight: Theme.weight-semibold;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: s.kind + " · " + s.detail;
                                                color: Theme.graphite;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Button {
                                                    horizontal-stretch: 1;
                                                    text: "Accept";
                                                    enabled: root.editing;
                                                    clicked => { root.accept-suggestion(si); }
                                                }
                                                Button {
                                                    horizontal-stretch: 1;
                                                    text: "Dismiss";
                                                    clicked => { root.reject-suggestion(si); }
                                                }
                                            }
                                        }
                                    }
                                    if root.has-inspector: Rectangle { height: 1px; background: Theme.rule; }
                                }
                                if root.has-inspector: VerticalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.inspector-title;
                                        font-size: Theme.font-h1;
                                        font-weight: Theme.weight-heavy;
                                        letter-spacing: Theme.tracking-tight;
                                        color: Theme.ink;
                                        wrap: word-wrap;
                                    }
                                Text { text: root.inspector-kind; color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-semibold; }
                                if root.editing: NameEditor {
                                    name: root.inspector-title;
                                    editable: root.editing;
                                    renamed(t) => { root.rename-tree-node(t); }
                                }
                                if !root.inspector-is-step: Field {
                                    label: "Gate logic";
                                    Choice {
                                        options: ["OR — any child suffices", "AND — all children needed", "SEQ — children in order"];
                                        index: root.inspector-gate-index;
                                        editable: root.editing;
                                        label: "Gate logic";
                                        picked(i) => { root.set-tree-node-gate(i); }
                                    }
                                }
                                if root.inspector-needs-review: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "This rating was copied from the library and has not been reviewed."; color: Theme.ink; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                                    Button { text: "Reviewed"; enabled: root.editing; accessible-description: "Confirm this rating after checking it"; clicked => { root.mark-reviewed(); } }
                                }
                                if root.evaluated-text != "": HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle { width: 16px; height: 16px; y: 6px; background: Theme.tone(root.evaluated-tone); }
                                    Text {
                                        text: root.evaluated-text + " attack feasibility";
                                        font-size: Theme.font-h2;
                                        font-weight: Theme.weight-bold;
                                        color: Theme.ink;
                                    }
                                }
                                if root.why-lines.length > 0: VerticalLayout {
                                    spacing: 4px;
                                    SectionTitle { text: "Why?"; }
                                    for line in root.why-lines: Text {
                                        text: line;
                                        wrap: word-wrap;
                                        color: Theme.ink;
                                        font-size: Theme.font-body;
                                    }
                                }
                                // ---- Interactive Tree Expansion (End of Node & Intermediate Points) ----
                                if root.editing: VerticalLayout {
                                    spacing: 6px;
                                    Rectangle { height: 1px; background: Theme.rule; }
                                    SectionTitle { text: root.inspector-is-step ? "Expand step or insert gate" : "Expand gate or restructure"; }
                                    LineEdit {
                                        text <=> root.new-node-label;
                                        placeholder-text: root.inspector-is-step ? "New child or gate label" : "New child or gate label";
                                        accessible-label: "New node label";
                                        accepted(t) => {
                                            root.add-tree-child(root.new-node-kind, t);
                                            root.new-node-label = "";
                                        }
                                    }
                                    Choice {
                                        options: ["Attack step (leaf)", "OR gate", "AND gate", "SEQ gate"];
                                        index: root.new-node-kind;
                                        label: "New node kind";
                                        picked(i) => { root.new-node-kind = i; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: root.inspector-is-step ? "Branch with child" : "Add child";
                                            icon: @image-url("icons/plus.svg");
                                            primary: true;
                                            clicked => {
                                                root.add-tree-child(root.new-node-kind, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                        if !root.inspector-is-root: Button {
                                            horizontal-stretch: 1;
                                            text: "Add sibling";
                                            icon: @image-url("icons/plus.svg");
                                            clicked => {
                                                root.add-sibling-node(root.new-node-kind, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Text { text: "Insert gate above:"; font-size: Theme.font-caption; font-weight: Theme.weight-semibold; color: Theme.graphite; vertical-alignment: center; horizontal-stretch: 1; }
                                        Button {
                                            text: "OR";
                                            clicked => {
                                                root.insert-parent-gate(0, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                        Button {
                                            text: "AND";
                                            clicked => {
                                                root.insert-parent-gate(1, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                        Button {
                                            text: "SEQ";
                                            clicked => {
                                                root.insert-parent-gate(2, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                    }
                                    if !root.inspector-is-root: HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: "Move up";
                                            enabled: root.inspector-can-move-up;
                                            clicked => { root.move-tree-node(-1); }
                                        }
                                        Button {
                                            horizontal-stretch: 1;
                                            text: "Move down";
                                            enabled: root.inspector-can-move-down;
                                            clicked => { root.move-tree-node(1); }
                                        }
                                        Button {
                                            text: "Delete";
                                            icon: @image-url("icons/trash-2.svg");
                                            clicked => { root.confirm("remove-tree-node", "Delete node \"" + root.inspector-title + "\" and its unshared children?"); }
                                        }
                                    }
                                }
                                if root.inspector-is-step: VerticalLayout {
                                    spacing: 8px;
                                    Rectangle { height: 1px; background: Theme.rule; }
                                    SectionTitle { text: root.feasibility-label; }
                                    Choice {
                                        options: root.level-options;
                                        index: root.rating-index;
                                        editable: root.editing;
                                        label: root.feasibility-label;
                                        picked(i) => { root.set-rating(i); }
                                    }
                                    if root.effective-text != "": Text {
                                        text: "The engine uses: " + root.effective-text;
                                        color: Theme.graphite;
                                        font-size: 12px;
                                    }
                                    if root.has-attack-potential: VerticalLayout {
                                        spacing: 8px;
                                        SectionTitle { text: "Attack potential"; }
                                        if root.potential-text != "": Text {
                                            text: root.potential-text + " from the five factors";
                                            font-size: 13px;
                                            color: Theme.ink;
                                        }
                                        if root.potential-text == "": Text {
                                            text: "Rate all five factors to calculate it. Until then the rating above is used.";
                                            font-size: 12px;
                                            color: Theme.graphite;
                                            wrap: word-wrap;
                                        }
                                        for f[fi] in root.factors: VerticalLayout {
                                            spacing: 2px;
                                            Text { text: f.label; font-size: 12px; color: Theme.graphite; }
                                            Choice {
                                                options: f.options;
                                                index: f.selected;
                                                editable: root.editing;
                                                label: f.label;
                                                picked(i) => { root.set-factor(fi, i); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.rule; }
                                    SectionTitle { text: "Security controls on this step"; }
                                    if root.step-residual-text != "": Text { text: "After controls: " + root.step-residual-text; color: Theme.ink; font-size: 13px; }
                                    if root.mitigations.length == 0: Text { text: "None."; color: Theme.graphite; font-size: 12px; }
                                    for mi[mx] in root.mitigations: VerticalLayout {
                                        spacing: 2px;
                                        Text { text: mi.name; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: "caps at"; color: Theme.graphite; font-size: 12px; vertical-alignment: center; }
                                            Choice { horizontal-stretch: 1; options: root.feasibility-levels; index: mi.level; editable: root.editing; label: "Cap"; picked(i) => { root.set-mitigation(mx, i); } }
                                            Button { text: "Detach"; enabled: root.editing; clicked => { root.detach-control(mx); } }
                                        }
                                    }
                                    if root.editing && root.attach-names.length > 0: VerticalLayout {
                                        spacing: 4px;
                                        SectionTitle { text: "Attach a control"; }
                                        Choice { options: root.attach-names; index: root.attach-control-index; label: "Control"; picked(i) => { root.attach-control-index = i; } }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: "caps at"; color: Theme.graphite; font-size: 12px; vertical-alignment: center; }
                                            Choice { horizontal-stretch: 1; options: root.feasibility-levels; index: root.attach-level-index; label: "Cap"; picked(i) => { root.attach-level-index = i; } }
                                            Button { text: "Attach"; icon: @image-url("icons/link.svg"); clicked => { root.attach-control(root.attach-control-index, root.attach-level-index); } }
                                        }
                                    }
                                    if root.editing && root.attach-names.length == 0 && root.mitigations.length == 0: Text { text: "Add controls on the Security controls page to attach them here."; color: Theme.graphite; font-size: 12px; wrap: word-wrap; }
                                }
                                }
                            }
                        }
                    }
                }

                // Risks and treatment
                if root.page == Pages.risks: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle { title: "Risks and treatment"; subtitle: "Every threat scenario, worst risk first, with the decision on what to do about it."; icon: @image-url("icons/gauge.svg"); }
                        Table {
                            label: "Risk register";
                            // The short columns get a minimum width so their titles and values
                            // ("not rated") are never cut; the names take the rest.
                            columns: [{ title: "Threat scenario", horizontal-stretch: 3, min-width: 110px }, { title: "Deciding damage", horizontal-stretch: 2, min-width: 136px }, { title: "Impact", horizontal-stretch: 0, min-width: 84px }, { title: "Feasibility", horizontal-stretch: 0, min-width: 104px }, { title: "Before", horizontal-stretch: 0, min-width: 80px }, { title: "After", horizontal-stretch: 0, min-width: 76px }, { title: "Treatment", horizontal-stretch: 0, min-width: 104px }];
                            rows: root.risk-rows;
                            selected: root.risk-selected;
                            picked(i) => { root.pick-risk(i); }
                        }
                    }
                    if root.has-threat-detail: Panel {
                        width: min(360px, root.side-width);
                        Text { text: root.td-name; font-size: 16px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                        DescriptionFor { items: root.descriptions; kind: "threat"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                        HorizontalLayout {
                            spacing: 8px;
                            Swatch { tone: root.td-inherent-tone; y: 4px; }
                            Text { text: "Before controls: " + (root.td-inherent == "" ? "not rated" : root.td-inherent); color: Theme.ink; font-size: 13px; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Swatch { tone: root.td-residual-tone; y: 4px; }
                            Text { text: "After controls: " + (root.td-residual == "" ? "not rated" : root.td-residual); color: Theme.ink; font-size: 13px; }
                        }
                        SectionTitle { text: "Why?"; }
                        for line in root.td-why: Text { text: line; color: Theme.ink; font-size: 12px; wrap: word-wrap; }
                        Field {
                            label: "Treatment decision";
                            Choice { options: root.treatment-options; index: root.td-treatment; editable: root.editing; label: "Treatment"; picked(i) => { root.set-treatment(i); } }
                        }
                        Field {
                            label: "Cybersecurity goal (for Reduce)";
                            Choice { options: root.goal-names; index: root.td-goal; editable: root.editing; label: "Goal"; picked(i) => { root.set-threat-goal(i); } }
                        }
                        Field {
                            label: "Cybersecurity claim (for Retain and Share)";
                            Choice { options: root.claim-names; index: root.td-claim; editable: root.editing; label: "Claim"; picked(i) => { root.set-threat-claim(i); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: "Open threat scenario"; icon: @image-url("icons/swords.svg"); clicked => { root.show-page(Pages.threats); } }
                    }
                }

                // Security controls
                if root.page == Pages.controls: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: "Security controls";
                            subtitle: "Measures that make attack steps harder. Attach them to steps on the Attack trees page.";
                            icon: @image-url("icons/shield-check.svg");
                            Button { text: "Add control"; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.ask("add-control", "Add security control", "Control name", ""); } }
                        }
                        Table {
                            label: "Security controls";
                            columns: [{ title: "Control", horizontal-stretch: 3 }, { title: "Attack steps", horizontal-stretch: 1 }, { title: "Goals", horizontal-stretch: 1 }];
                            rows: root.control-rows;
                            selected: root.control-selected;
                            picked(i) => { root.pick-control(i); }
                        }
                    }
                    if root.has-control: Panel {
                        width: root.side-width;
                        SectionTitle { text: "Security control"; }
                        NameEditor { name: root.control-name; editable: root.editing; renamed(t) => { root.rename-control(t); } }
                        DescriptionFor { items: root.descriptions; kind: "control"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                        SectionTitle { text: "Attached to"; }
                        LinkList { items: root.control-steps; empty-text: "No attack step yet."; clicked(i) => { root.control-step-clicked(i); } }
                        SectionTitle { text: "Part of goals"; }
                        LinkList { items: root.control-goals; clicked(i) => { root.control-goal-clicked(i); } }
                        Text { text: root.control-changed; color: Theme.graphite; font-size: 11px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: "Remove control"; icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.confirm("remove-control", "Remove control \"" + root.control-name + "\"? It is detached from its steps and goals."); } }
                    }
                }

                // Goals and claims
                if root.page == Pages.goals: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: "Goals and claims";
                            subtitle: "Goals back a Reduce decision with controls; claims back Retain and Share.";
                            icon: @image-url("icons/target.svg");
                            Button { text: "Add goal"; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.ask("add-goal", "Add cybersecurity goal", "Goal", ""); } }
                            Button { text: "Add claim"; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.ask("add-claim", "Add cybersecurity claim", "Claim", ""); } }
                        }
                        SectionTitle { text: root.goal-plural; }
                        Table {
                            label: root.goal-plural;
                            columns: [{ title: root.goal-singular, horizontal-stretch: 3 }, { title: "Controls", horizontal-stretch: 1 }, { title: "Threats", horizontal-stretch: 1 }];
                            rows: root.goal-rows;
                            selected: root.goal-selected;
                            picked(i) => { root.pick-goal(i); }
                        }
                        SectionTitle { text: "Cybersecurity claims"; }
                        Table {
                            label: "Cybersecurity claims";
                            columns: [{ title: "Claim", horizontal-stretch: 3 }, { title: "Threats", horizontal-stretch: 1 }];
                            rows: root.claim-rows;
                            selected: root.claim-selected;
                            picked(i) => { root.pick-claim(i); }
                        }
                    }
                    VerticalLayout {
                        width: root.side-width;
                        spacing: 12px;
                        if root.has-goal: Panel {
                            SectionTitle { text: root.goal-singular; }
                            NameEditor { name: root.goal-name; editable: root.editing; renamed(t) => { root.rename-goal(t); } }
                            DescriptionFor { items: root.descriptions; kind: "goal"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                            SectionTitle { text: "Controls that realize it"; }
                            CheckList { items: root.goal-controls; editable: root.editing; empty-text: "Add security controls first."; toggled(i, on) => { root.toggle-goal-control(i, on); } }
                            SectionTitle { text: "Threat scenarios"; }
                            LinkList { items: root.goal-threats; clicked(i) => { root.goal-threat-clicked(i); } }
                            Button { text: "Remove goal"; icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.confirm("remove-goal", "Remove goal \"" + root.goal-name + "\"?"); } }
                        }
                        if root.has-claim: Panel {
                            SectionTitle { text: "Cybersecurity claim"; }
                            NameEditor { name: root.claim-name; editable: root.editing; renamed(t) => { root.rename-claim(t); } }
                            DescriptionFor { items: root.descriptions; kind: "claim"; editable: root.editing; edit-requested(i, label, t) => { root.description-index = i; root.description-title = label; root.description-draft = t; root.description-open = true; } }
                            SectionTitle { text: "Threat scenarios"; }
                            LinkList { items: root.claim-threats; clicked(i) => { root.claim-threat-clicked(i); } }
                            Button { text: "Remove claim"; icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.confirm("remove-claim", "Remove claim \"" + root.claim-name + "\"?"); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Problems
                if root.page == Pages.problems: VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    PageTitle { title: "Problems"; subtitle: "Completeness and consistency checks. Blocking problems stop a risk from being computed or a treatment from being complete."; icon: @image-url("icons/circle-alert.svg"); }
                    if root.problems.length == 0: Text { text: "No problems. The analysis is complete and consistent."; color: Theme.ink; font-size: 14px; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for p[pi] in root.problems: Rectangle {
                                min-height: 36px;
                                background: problem-area.has-hover ? Theme.wash : Theme.panel;
                                border-width: 1px;
                                border-color: Theme.rule;
                                accessible-role: button;
                                accessible-label: p.text;
                                accessible-action-default => { root.problem-clicked(pi); }
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Image { source: @image-url("icons/circle-alert.svg"); width: 16px; height: 16px; colorize: p.error ? Theme.high : Theme.medium; }
                                    Text { text: p.error ? "Blocking" : "Warning"; width: 70px; color: p.error ? Theme.high : Theme.medium; font-size: 12px; font-weight: 600; }
                                    Text { text: p.text; color: Theme.ink; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
                                    Text { text: "Go to"; color: Theme.accent; font-size: 12px; }
                                }
                                problem-area := TouchArea { clicked => { root.problem-clicked(pi); } }
                            }
                        }
                    }
                }

                // Versions
                if root.page == Pages.versions: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 2;
                        spacing: 10px;
                        PageTitle {
                            title: "Versions";
                            subtitle: "Baselines freeze the saved state under a name. Compare the current state with one to see what changed and which risks moved.";
                            icon: @image-url("icons/git-compare.svg");
                            Button { text: "Create baseline"; icon: @image-url("icons/flag.svg"); clicked => { root.ask("create-baseline", "Create baseline", "Baseline name, for example B1 Design freeze", ""); } }
                        }
                        Table {
                            label: "Baselines";
                            columns: [{ title: "Baseline", horizontal-stretch: 2 }, { title: "Change", horizontal-stretch: 1 }, { title: "By", horizontal-stretch: 1 }, { title: "Created", horizontal-stretch: 2 }];
                            rows: root.baseline-rows;
                            selected: root.baseline-selected;
                            picked(i) => { root.pick-baseline(i); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: "Compare with the current state"; icon: @image-url("icons/git-compare.svg"); enabled: root.baseline-selected >= 0; clicked => { root.compare-baseline(); } }
                            if root.comparing: Button { text: "Stop comparing"; icon: @image-url("icons/x.svg"); clicked => { root.stop-compare(); } }
                        }
                    }
                    if root.comparing: Panel {
                        horizontal-stretch: 3;
                        SectionTitle { text: "Comparison"; }
                        Text { text: root.compare-summary; color: Theme.ink; font-size: 14px; wrap: word-wrap; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for d in root.diff-lines: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: d.kind; width: 70px; font-size: 12px; font-weight: 600; color: d.kind == "Removed" ? Theme.high : (d.kind == "Risk" ? Theme.accent : Theme.ink); }
                                    Text { text: d.text; font-size: 13px; color: Theme.ink; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }

                // History
                if root.page == Pages.history: VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    PageTitle {
                        title: "History";
                        subtitle: "The latest accepted changes on the server, newest first. Every change is in the hash-chained audit log.";
                        icon: @image-url("icons/history.svg");
                        Button { text: "Refresh"; icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-history(); } }
                    }
                    Table {
                        label: "History";
                        columns: [{ title: "Change", horizontal-stretch: 1 }, { title: "Who", horizontal-stretch: 2 }, { title: "When", horizontal-stretch: 2 }, { title: "What", horizontal-stretch: 3 }];
                        rows: root.history-rows;
                    }
                }

                // Reports
                if root.page == Pages.reports: VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    PageTitle { title: "Reports"; subtitle: "Exports carry your name and the time, and the server records each one."; icon: @image-url("icons/file-chart-column.svg"); }
                    Panel {
                        Field {
                            label: "Save files in this folder";
                            LineEdit { text <=> root.export-dir; accessible-label: "Export folder"; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { text: "TARA report (PDF)"; icon: @image-url("icons/file-down.svg"); primary: true; clicked => { root.export-pdf(); } }
                            Button { text: "TARA report (HTML)"; icon: @image-url("icons/file-text.svg"); clicked => { root.export-report(); } }
                            Button { text: "Risk register (CSV)"; icon: @image-url("icons/sheet.svg"); clicked => { root.export-csv(); } }
                            Button { text: "Attack tree on the canvas (SVG)"; icon: @image-url("icons/image.svg"); enabled: root.has-tree; clicked => { root.export-svg(); } }
                        }
                        if root.last-export != "": Text { text: "Last saved: " + root.last-export; color: Theme.graphite; font-size: 12px; wrap: word-wrap; }
                    }
                    Text {
                        text: "The TARA report has an executive summary and the full work product: assets, damage scenarios, threat scenarios, attack trees as diagrams, the risk register with treatment, controls, goals and claims, and the open problems. The PDF has the watermark and page numbers on every page. The HTML version opens in a browser, where you can also print it.";
                        color: Theme.graphite;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // Administration
                if root.page == Pages.admin: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle { title: "Administration"; subtitle: "Users of this server (password login), and tools for the open project."; icon: @image-url("icons/user-cog.svg"); }
                        HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            max-height: 40px;
                            Button { text: "Users and login"; icon: @image-url("icons/users.svg"); primary: root.admin-tab == 0; clicked => { root.admin-tab = 0; } }
                            Button { text: "Event log"; icon: @image-url("icons/scroll-text.svg"); primary: root.admin-tab == 1; clicked => { root.admin-tab = 1; root.refresh-events(); } }
                            Button { text: "Sessions"; icon: @image-url("icons/shield.svg"); primary: root.admin-tab == 2; clicked => { root.admin-tab = 2; root.refresh-sessions(); } }
                        }
                        if root.admin-tab == 0: VerticalLayout {
                            spacing: 10px;
                            if root.is-password: Table {
                                label: "Users";
                                columns: [{ title: "User", horizontal-stretch: 2 }, { title: "Name", horizontal-stretch: 2 }, { title: "Admin", width: 78px, min-width: 78px }, { title: "Status", width: 80px, min-width: 80px }, { title: "Last login", horizontal-stretch: 3 }, { title: "Sessions", width: 98px, min-width: 98px }];
                                rows: root.user-rows;
                                selected: root.user-selected;
                                picked(i) => { root.pick-user(i); }
                            }
                            if !root.is-password: Text { text: "Users come from the company identity provider. Manage them there."; color: Theme.graphite; wrap: word-wrap; }
                            if root.settings-known: Panel {
                                SectionTitle { text: "Login"; }
                                Text {
                                    text: root.password-login-on ? "Password login is on. People can log in with a user name and password as well as with the company account." : "Password login is off. Everyone logs in with the company account.";
                                    color: Theme.ink;
                                    wrap: word-wrap;
                                    font-size: 13px;
                                }
                                if !root.company-login-available: Text {
                                    text: "This server has no company login, so password login cannot be turned off.";
                                    color: Theme.graphite;
                                    wrap: word-wrap;
                                    font-size: 12px;
                                }
                                Button {
                                    text: root.password-login-on ? "Turn password login off" : "Turn password login on";
                                    icon: @image-url("icons/lock.svg");
                                    enabled: !root.password-login-on || root.company-login-available;
                                    clicked => {
                                        if (root.password-login-on) {
                                            root.confirm("password-login-off", "Turn password login off? Everyone with a password session is logged out now. Use the company account to log in.");
                                        } else {
                                            root.set-password-login(true);
                                        }
                                    }
                                }
                            }
                            if root.is-password && root.user-selected >= 0: HorizontalLayout {
                                spacing: 6px;
                                Button { text: root.selected-user-admin ? "Remove admin rights" : "Make admin"; icon: @image-url("icons/user-cog.svg"); clicked => { root.toggle-user-admin(); } }
                                Button { text: root.selected-user-disabled ? "Enable" : "Disable"; icon: @image-url("icons/lock.svg"); clicked => { root.toggle-user-disabled(); } }
                                Button { text: "Set password"; icon: @image-url("icons/key-round.svg"); clicked => { root.ask("reset-password", "Set a new password", "New password (at least 10 characters)", ""); root.prompt-secret = true; } }
                                Button { text: "Delete"; icon: @image-url("icons/trash-2.svg"); clicked => { root.confirm("delete-user", "Delete this user? Their sessions end."); } }
                            }
                            if root.is-password: Panel {
                                SectionTitle { text: "Add a user"; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { horizontal-stretch: 1; placeholder-text: "user name"; text <=> root.new-user-name; accessible-label: "New user name"; }
                                    LineEdit { horizontal-stretch: 2; placeholder-text: "Full name"; text <=> root.new-user-display; accessible-label: "Full name"; }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { horizontal-stretch: 1; placeholder-text: "First password (10+ characters)"; input-type: password; text <=> root.new-user-password; accessible-label: "First password"; }
                                    CheckBox { text: "Administrator"; checked <=> root.new-user-admin; }
                                    Button {
                                        text: "Add user";
                                        icon: @image-url("icons/plus.svg");
                                        enabled: root.new-user-name != "" && root.new-user-password != "";
                                        clicked => {
                                            root.create-user(root.new-user-name, root.new-user-display, root.new-user-password, root.new-user-admin);
                                            root.new-user-password = "";
                                        }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                        if root.admin-tab == 1: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                Button { text: "All"; primary: root.event-filter == 0; clicked => { root.set-event-filter(0); } }
                                Button { text: "Logins"; primary: root.event-filter == 1; clicked => { root.set-event-filter(1); } }
                                Button { text: "Exports"; primary: root.event-filter == 2; clicked => { root.set-event-filter(2); } }
                                Button { text: "Admin actions"; primary: root.event-filter == 3; clicked => { root.set-event-filter(3); } }
                                Rectangle { horizontal-stretch: 1; }
                                Button { text: "Refresh"; icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-events(); } }
                            }
                            Table {
                                label: "Event log";
                                columns: [{ title: "When", horizontal-stretch: 4 }, { title: "Who", horizontal-stretch: 2 }, { title: "What", horizontal-stretch: 5 }, { title: "About", horizontal-stretch: 2 }];
                                rows: root.event-rows;
                                selected: -1;
                            }
                            if root.events-text != "": Text { text: root.events-text; color: Theme.graphite; wrap: word-wrap; font-size: 13px; }
                        }
                        if root.admin-tab == 2: VerticalLayout {
                            spacing: 8px;
                            if !root.is-password: Text { text: "Sessions are managed by the company identity provider."; color: Theme.graphite; wrap: word-wrap; }
                            if root.is-password: HorizontalLayout {
                                spacing: 6px;
                                Text { text: "Open password sessions, newest first. Ending one logs that device out at its next request."; color: Theme.graphite; wrap: word-wrap; font-size: 13px; horizontal-stretch: 1; }
                                Button { text: "Refresh"; icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-sessions(); } }
                            }
                            if root.is-password: Table {
                                label: "Sessions";
                                columns: [{ title: "User", horizontal-stretch: 2 }, { title: "Device", horizontal-stretch: 3 }, { title: "Started (UTC)", horizontal-stretch: 4 }, { title: "Ends (UTC)", horizontal-stretch: 4 }];
                                rows: root.session-rows;
                                selected: root.session-selected;
                                picked(i) => { root.pick-session(i); }
                            }
                            if root.is-password && root.session-selected >= 0: Button { text: "End this session"; icon: @image-url("icons/log-out.svg"); clicked => { root.confirm("revoke-session", "End this session? That device is logged out at its next request."); } }
                            if root.is-password && root.sessions-text != "": Text { text: root.sessions-text; color: Theme.graphite; wrap: word-wrap; font-size: 13px; }
                        }
                    }
                    Panel {
                        width: 300px;
                        SectionTitle { text: "This project"; }
                        Button { text: "Check the audit chain"; icon: @image-url("icons/list-checks.svg"); clicked => { root.verify-audit(); } }
                        Button { text: "Break the edit lock"; icon: @image-url("icons/unlink.svg"); enabled: root.band-kind == 1; clicked => { root.confirm("break-lock", "Break the edit lock? The other editor's unsaved changes are lost."); } }
                        Button { text: "Delete project"; icon: @image-url("icons/trash-2.svg"); clicked => { root.confirm("delete-project", "Delete this project, its history and its baselines? This cannot be undone."); } }
                        if root.admin-text != "": Text { text: root.admin-text; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                        SectionTitle { text: "License"; }
                        Text { text: root.license-text; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                        SectionTitle { text: "Server"; }
                        Text { text: root.engine-text; color: Theme.graphite; font-size: 12px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // ---- status bar ----
        Rectangle { height: 1px; background: Theme.rule; }
        Rectangle {
            height: 26px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Image {
                    source: @image-url("brand/AegisTARA_Stencil_Light.svg");
                    width: 15px;
                    height: 15px;
                    y: 5.5px;
                    colorize: Theme.accent;
                }
                Text {
                    text: root.engine-text;
                    color: Theme.graphite;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Image { source: @image-url("icons/circle-user-round.svg"); width: 14px; height: 14px; y: 6px; colorize: Theme.graphite; }
                Text { text: root.user; color: Theme.graphite; font-size: 12px; vertical-alignment: center; }
                Text { text: "CPU renderer"; color: Theme.graphite; font-size: 12px; vertical-alignment: center; }
            }
        }
    }

    // ===================================================================
    // Notices: the newest at the bottom right.
    // ===================================================================
    VerticalLayout {
        x: parent.width - 420px;
        y: parent.height - self.preferred-height - 40px;
        width: 400px;
        spacing: 6px;
        for n in root.notices: Rectangle {
            background: n.severity == 2 ? (Theme.dark ? #2E1512 : #FDECEA) : (n.severity == 1 ? (Theme.dark ? #2E230E : #FFF4D6) : Theme.panel);
            border-width: 1px;
            border-color: n.severity == 2 ? Theme.high : (n.severity == 1 ? Theme.medium : Theme.rule);
            border-radius: 2px;
            height: notice-text.preferred-height + 20px;
            accessible-role: text;
            accessible-label: n.text;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                notice-text := Text {
                    text: n.text;
                    wrap: word-wrap;
                    color: Theme.ink;
                    font-size: 13px;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    accessible-role: button;
                    accessible-label: "Dismiss";
                    accessible-action-default => { root.dismiss-notice(n.id); }
                    Image { source: @image-url("icons/x.svg"); width: 14px; height: 14px; colorize: Theme.ink; }
                    TouchArea { clicked => { root.dismiss-notice(n.id); } }
                }
            }
        }
    }

    // ===================================================================
    // Dialogs.
    // ===================================================================
    if root.prompt-open: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.prompt-open = false; } }
        Rectangle {
            width: min(parent.width - 48px, 480px);
            height: prompt-column.preferred-height + 40px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 2px;
            TouchArea {}
            prompt-column := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: root.prompt-title; font-size: 18px; font-weight: 700; color: Theme.ink; }
                SectionTitle { text: root.prompt-label; }
                prompt-edit := LineEdit {
                    text <=> root.prompt-text;
                    input-type: root.prompt-secret ? password : text;
                    accessible-label: root.prompt-label;
                    accepted(t) => { root.prompt-done(root.prompt-kind, t); }
                    init => { self.focus(); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Cancel"; clicked => { root.prompt-open = false; } }
                    Button { text: "OK"; primary: true; enabled: root.prompt-text != ""; clicked => { root.prompt-done(root.prompt-kind, root.prompt-text); } }
                }
            }
        }
    }

    if root.confirm-open: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.confirm-open = false; } }
        Rectangle {
            width: min(parent.width - 48px, 460px);
            height: confirm-column.preferred-height + 40px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 2px;
            TouchArea {}
            confirm-column := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: root.confirm-text; font-size: 15px; color: Theme.ink; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Cancel"; clicked => { root.confirm-open = false; } }
                    Button { text: "Yes"; primary: true; clicked => { root.confirm-done(root.confirm-kind); } }
                }
            }
        }
    }

    if root.description-open: Rectangle {
        background: #000000A0;
        FocusScope {
            // The text box keeps Tab for itself, so the keys that leave it are
            // fixed: Ctrl+Enter saves, Escape cancels.
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.description-open = false;
                    return accept;
                }
                if (event.text == Key.Return && event.modifiers.control) {
                    root.set-description(root.description-index, root.description-draft);
                    root.description-open = false;
                    return accept;
                }
                reject
            }
            Rectangle {
                width: min(parent.width - 48px, 640px);
                height: min(parent.height - 48px, 440px);
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.rule;
                border-radius: 2px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: root.description-title; font-size: 18px; font-weight: 700; color: Theme.ink; }
                    Text {
                        text: "Plain text. Ctrl+Enter saves, Escape cancels.";
                        color: Theme.graphite;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    description-edit := TextEdit {
                        vertical-stretch: 1;
                        text <=> root.description-draft;
                        wrap: word-wrap;
                        accessible-label: root.description-title;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button { text: "Cancel"; clicked => { root.description-open = false; } }
                        Button { text: "Save"; primary: true; clicked => { root.set-description(root.description-index, root.description-draft); root.description-open = false; } }
                    }
                }
            }
            init => { description-edit.focus(); }
        }
    }

    if root.outline-open: Rectangle {
        background: #000000A0;
        Rectangle {
            width: min(parent.width - 48px, 760px);
            height: min(parent.height - 48px, 620px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 2px;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Edit the attack tree"; font-size: 18px; font-weight: 700; color: Theme.ink; }
                Text {
                    text: "One node per line; indent a child under its parent. Start a gate with OR, AND or SEQ (sequential AND); a step with - or nothing. Lines with the same text are the same node, which is how a step is shared. Nodes that keep their text keep their ratings and controls.";
                    color: Theme.graphite;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.outline-draft;
                    font-family: "monospace";
                    font-size: 13px;
                    wrap: no-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Cancel"; clicked => { root.outline-open = false; } }
                    Button { text: "Apply"; primary: true; clicked => { root.apply-outline(root.outline-draft); root.outline-open = false; } }
                }
            }
        }
    }

    if root.library-open: Rectangle {
        background: #000000A0;
        Rectangle {
            width: min(parent.width - 48px, 980px);
            height: min(parent.height - 48px, 640px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 2px;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Attack tree library"; font-size: 18px; font-weight: 700; color: Theme.ink; }
                HorizontalLayout {
                    spacing: 8px;
                    lib-search := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Search (English or Japanese)";
                        accessible-label: "Search the library";
                        edited(t) => { root.library-query(t); }
                    }
                    ComboBox {
                        width: 260px;
                        model: root.library-facets;
                        current-index: -1;
                        accessible-label: "Narrow by";
                        selected(v) => { root.library-facet(self.current-index); }
                    }
                    Button { text: "Clear"; enabled: root.library-filter != ""; clicked => { root.library-clear-filters(); } }
                }
                Text { visible: root.library-filter != ""; text: "Narrowed by " + root.library-filter; color: Theme.graphite; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    Table {
                        horizontal-stretch: 1;
                        label: "Library items";
                        columns: [{ title: "Item", horizontal-stretch: 1 }, { title: "Kind", width: 90px, min-width: 90px }];
                        rows: root.library-rows;
                        selected: root.library-selected;
                        picked(i) => { root.library-pick(i); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-width: 1px;
                        border-color: Theme.rule;
                        Text {
                            x: 8px; y: 8px;
                            width: parent.width - 16px;
                            text: root.library-preview == "" ? "Pick an item to see it here." : root.library-preview;
                            font-family: "monospace";
                            font-size: 12px;
                            color: Theme.ink;
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                            accessible-label: "Preview";
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    ComboBox {
                        width: 250px;
                        model: ["As a new tree", "Under the selected gate", "In place of the selected step"];
                        current-index <=> root.library-mode;
                        accessible-label: "Where to put it";
                    }
                    CheckBox { text: "With the suggested ratings (marked for review)"; checked <=> root.library-ratings; }
                    CheckBox { text: "Share steps the tree already has"; checked <=> root.library-share; }
                }
                Text {
                    visible: (root.library-mode == 1 && !root.library-can-gate) || (root.library-mode == 2 && !root.library-can-leaf);
                    text: root.library-mode == 1 ? "Select a gate of the tree on the canvas first." : "Select a step (not the root) of the tree on the canvas first.";
                    color: Theme.graphite;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Close"; clicked => { root.library-open = false; } }
                    Button {
                        text: "Insert";
                        primary: true;
                        enabled: root.editing && root.library-selected >= 0 && (root.library-mode == 0 || (root.library-mode == 1 && root.library-can-gate) || (root.library-mode == 2 && root.library-can-leaf));
                        clicked => { root.library-insert(root.library-mode, root.library-ratings, root.library-share); root.library-open = false; }
                    }
                }
            }
            init => { lib-search.focus(); }
        }
    }

    if root.password-open: Rectangle {
        background: #000000A0;
        Rectangle {
            width: min(parent.width - 48px, 420px);
            height: pw-column.preferred-height + 40px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 2px;
            pw-column := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Change your password"; font-size: 18px; font-weight: 700; color: Theme.ink; }
                Field { label: "Current password"; LineEdit { input-type: password; text <=> root.pw-current; accessible-label: "Current password"; } }
                Field { label: "New password (at least 10 characters)"; LineEdit { input-type: password; text <=> root.pw-new; accessible-label: "New password"; } }
                Field { label: "New password again"; LineEdit { input-type: password; text <=> root.pw-repeat; accessible-label: "New password again"; } }
                if root.pw-repeat != "" && root.pw-new != root.pw-repeat: Text { text: "The two new passwords differ."; color: Theme.high; font-size: 12px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: "Cancel"; clicked => { root.password-open = false; } }
                    Button {
                        text: "Change password";
                        primary: true;
                        enabled: root.pw-current != "" && root.pw-new != "" && root.pw-new == root.pw-repeat;
                        clicked => { root.change-password(root.pw-current, root.pw-new); root.password-open = false; root.pw-current = ""; root.pw-new = ""; root.pw-repeat = ""; }
                    }
                }
            }
        }
    }

    if root.show-shortcuts: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.show-shortcuts = false; } }
        Rectangle {
            width: min(parent.width - 48px, 480px);
            height: keys-column.preferred-height + 40px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 2px;
            keys-column := VerticalLayout {
                padding: 20px;
                spacing: 6px;
                Text { text: "Keyboard shortcuts"; font-size: 18px; font-weight: 700; color: Theme.ink; }
                for k in [
                    { keys: "Ctrl+Z / Ctrl+Y", what: "Undo / redo" },
                    { keys: "Ctrl+E", what: "Take the edit lock" },
                    { keys: "Ctrl+1 to Ctrl+9", what: "Go to a TARA step" },
                    { keys: "Arrow keys", what: "Move between nodes on the canvas" },
                    { keys: "+ / - / 0 / F", what: "Zoom in / out / 100% / fit" },
                    { keys: "Esc", what: "Clear the selection on the canvas" },
                ]: HorizontalLayout {
                    spacing: 12px;
                    Text { text: k.keys; width: 150px; font-size: 13px; font-weight: 600; color: Theme.ink; }
                    Text { text: k.what; font-size: 13px; color: Theme.ink; }
                }
                HorizontalLayout { alignment: end; Button { text: "Close"; clicked => { root.show-shortcuts = false; } } }
            }
        }
    }

    // About: the Slint notice the license requires (decisions D7, D9).
    if root.show-about: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.show-about = false; } }
        Rectangle {
            width: min(parent.width - 48px, 520px);
            height: about-splash.height + about-column.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: 3px;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                about-splash := SplashHeader {
                    banner-height: 148px;
                    status-text: "CYBERSECURITY TARA";
                    status-color: Theme.crimson-bright;
                }
                about-column := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "Threat analysis and risk assessment for vehicle cybersecurity.";
                        color: Theme.ink;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: Theme.rule; }
                    AboutSlint { }
                    Text {
                        text: "This application uses the Slint toolkit under the Slint Royalty-free License 2.0. Icons by Lucide (ISC license). Third-party licenses are listed in the release notices.";
                        color: Theme.graphite;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Button { text: "Close"; clicked => { root.show-about = false; } }
                }
            }
        }
    }
}
