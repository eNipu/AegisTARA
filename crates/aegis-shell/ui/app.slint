// AegisTARA desktop window (jobs 033 and 040).
//
// This file only lays things out and reports what the user did. Every
// decision (what is selected, what a change means, what the numbers are) is
// made by the client core in Rust; the window shows the view model and sends
// commands back. Menu and sidebar glyphs are Lucide icons (ISC license,
// ui/icons/LICENSE-lucide.txt).
import { ScrollView, AboutSlint, StandardListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AccessNode, Canvas, DrawItem } from "canvas.slint";
import {
    DescriptionItem, DescriptionBox, TranslationEditor, ProjectItem, ThreatItem, FactorItem, NoticeItem, LinkItem, CheckItem, MitigationItem,
    CountItem, DiffItem, ProblemItem, SuggestionItem, Choice, DataTable, SectionTitle, PageTitle, SplashHeader, Panel, Swatch,
    LinkList, CheckList, Tile, Bars, FieldError, DangerButton, DraftForm,
    Button, LineEdit, TextEdit, ComboBox, CheckBox, Switch
} from "widgets.slint";

export { DrawItem, DescriptionItem, ProjectItem, ThreatItem, FactorItem, NoticeItem, LinkItem, CheckItem, MitigationItem, CountItem, DiffItem, ProblemItem, SuggestionItem }

// Page numbers, in the order of aegis_client::view::Page::ALL.
global Pages {
    out property <int> overview: 0;
    out property <int> assets: 1;
    out property <int> damage: 2;
    out property <int> threats: 3;
    out property <int> trees: 4;
    out property <int> risks: 5;
    out property <int> controls: 6;
    out property <int> goals: 7;
    out property <int> problems: 8;
    out property <int> versions: 9;
    out property <int> history: 10;
    out property <int> reports: 11;
    out property <int> admin: 12;
    out property <int> item: 13;
}

// A row with a label above a field.
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 2px;
    SectionTitle { text: root.label; wrap: word-wrap; }
    @children
}

// True while a text field that has a saved value has focus and its text differs
// from that value. The Undo and Redo menu items stand aside then, so the platform
// undo shortcut reaches the field and undoes its own typing; otherwise it undoes
// the last project change (UI-10.4). Saving the field is one project undo step.
global Typing {
    in-out property <bool> dirty;
}

// The name field of a details panel (UI-08.3). The name saves on Enter, on Tab
// and when focus leaves; Escape puts the saved name back; an empty name is never
// saved: the saved name returns and a short note says a name is needed.
component NameEditor inherits VerticalLayout {
    in property <string> name;
    in property <bool> editable;
    // Set by a table row's Enter or Open; the editor takes the keyboard when
    // it exists (its panel appears after the pick) and clears the request.
    in-out property <bool> focus-requested;
    callback renamed(string);
    property <bool> typing: edit.has-focus && edit.text != root.name;
    // The text already sent, so Enter and the focus leaving do not send it twice.
    property <string> requested;
    property <bool> needed;
    spacing: 4px;
    changed typing => { Typing.dirty = root.typing; }
    function take-focus() {
        if (root.focus-requested && root.editable) {
            root.focus-requested = false;
            edit.focus();
        }
    }
    init => { root.take-focus(); }
    changed focus-requested => { root.take-focus(); }
    function save() {
        if (edit.text == root.name || (root.requested != "" && edit.text == root.requested)) { return; }
        if (edit.text == "") {
            root.needed = true;
            edit.text = root.name;
            return;
        }
        root.requested = edit.text;
        root.renamed(edit.text);
    }
    FocusScope {
        min-height: edit.preferred-height;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                edit.text = root.name;
                root.needed = false;
                return accept;
            }
            if (event.text == Key.Tab) { root.save(); }
            reject
        }
        edit := LineEdit {
            width: parent.width;
            text: root.name;
            enabled: root.editable;
            accessible-label: @tr("Name");
            accepted(t) => { root.save(); }
            edited(t) => {
                root.needed = false;
                root.requested = "";
            }
        }
    }
    if root.needed: FieldError { text: @tr("A name is needed"); }
    changed name => {
        edit.text = root.name;
        root.requested = "";
    }
    changed focused => {
        if (!root.focused) { root.save(); }
    }
    property <bool> focused: edit.has-focus;
}

// The description boxes of the page that are for `kind`. A page has at most
// two (goals and claims), so there are two slots; a repeater here would put
// the Edit buttons in a focus chain that Tab does not get through.
component DescriptionFor inherits VerticalLayout {
    in property <[DescriptionItem]> items;
    in property <string> kind;
    in property <bool> editable;
    in property <string> label: @tr("Description");
    in property <string> save-label;
    callback save-requested(int, string);
    callback translation-requested(int, string, string);
    callback translation-removed(int, string);
    if root.items.length > 0 && root.items[0].kind == root.kind: DescriptionBox {
        label: root.label;
        text: root.items[0].text;
        by: root.items[0].by;
        editable: root.editable;
        save-label: root.save-label;
        save(t) => { root.save-requested(0, t); }
        TranslationEditor {
            items: root.items[0].translations;
            editable: root.editable;
            save(l, t) => { root.translation-requested(0, l, t); }
            remove(l) => { root.translation-removed(0, l); }
        }
    }
    if root.items.length > 1 && root.items[1].kind == root.kind: DescriptionBox {
        label: root.label;
        text: root.items[1].text;
        by: root.items[1].by;
        editable: root.editable;
        save-label: root.save-label;
        save(t) => { root.save-requested(1, t); }
        TranslationEditor {
            items: root.items[1].translations;
            editable: root.editable;
            save(l, t) => { root.translation-requested(1, l, t); }
            remove(l) => { root.translation-removed(1, l); }
        }
    }
    if root.items.length > 2 && root.items[2].kind == root.kind: DescriptionBox {
        label: root.label;
        text: root.items[2].text;
        by: root.items[2].by;
        editable: root.editable;
        save-label: root.save-label;
        save(t) => { root.save-requested(2, t); }
        TranslationEditor {
            items: root.items[2].translations;
            editable: root.editable;
            save(l, t) => { root.translation-requested(2, l, t); }
            remove(l) => { root.translation-removed(2, l); }
        }
    }
    if root.items.length > 3 && root.items[3].kind == root.kind: DescriptionBox {
        label: root.label;
        text: root.items[3].text;
        by: root.items[3].by;
        editable: root.editable;
        save-label: root.save-label;
        save(t) => { root.save-requested(3, t); }
        TranslationEditor {
            items: root.items[3].translations;
            editable: root.editable;
            save(l, t) => { root.translation-requested(3, l, t); }
            remove(l) => { root.translation-removed(3, l); }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("AegisTARA");
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 980px;
    min-height: 600px;
    background: Theme.sheet;
    icon: @image-url("brand/App_Icon_Resolutions/AegisTARA_Icon_256x256.png");
    // Appearance (UI-07.5): 0 System, 1 Light, 2 Dark. System hands the
    // palette back to the OS (`unknown`), so the window follows the OS live;
    // `Theme.dark` reads the palette, so the brand tokens follow too.
    in-out property <int> appearance: 0;
    callback appearance-selected(int);
    changed appearance => {
        Palette.color-scheme = root.appearance == 1 ? ColorScheme.light
            : root.appearance == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    // A field that goes away while it has focus cannot say it is clean again.
    changed page => { Typing.dirty = false; }
    changed in-project => { Typing.dirty = false; }

    // Side panels follow the window: full size on a big window, narrower on a
    // small one, so a page never pushes its detail panel off the screen
    // (checked at the smallest window, 980 x 600, by tests/small_windows.rs).
    property <length> side-width: min(400px, max(300px, root.width * 0.3));
    property <length> tree-list-width: min(340px, max(240px, root.width * 0.24));
    property <length> inspector-width: min(340px, max(260px, root.width * 0.25));

    // ---- connection and login ----
    // 0 connecting, 1 online, 2 offline, 3 login required, 4 choose a server
    in property <int> connection: 0;
    in property <string> connection-text;
    // 0 company login (OIDC), 1 user name and password, 2 development
    in property <int> login-method: 0;
    // The company login is shown, and a user name and password are accepted too.
    in property <bool> password-also: false;
    in property <string> server-name;
    in property <string> login-error;
    in property <bool> login-busy;
    in-out property <string> server-url;
    in-out property <string> standalone-folder;
    in-out property <string> standalone-license;
    in property <bool> standalone-mode: false;
    // 0 automatic, 1 gRPC over HTTP/2, 2 gRPC-Web over HTTP/1.1
    in-out property <int> transport-index: 0;
    in-out property <string> login-user;
    in-out property <string> login-password;
    in-out property <bool> remember: true;
    in property <string> user;
    in property <string> engine-text;
    in property <bool> is-admin;
    in property <bool> is-password;

    // ---- projects ----
    in property <[ProjectItem]> projects;
    in property <bool> has-project;
    in property <string> project-name;
    in-out property <string> new-project-name: "";
    in-out property <int> new-project-methodology: 0;

    // ---- open project ----
    in property <bool> editing;
    in property <bool> has-attack-potential: true;
    in property <string> feasibility-label: @tr("Attack feasibility");
    in property <string> damage-singular: "Damage scenario";
    in property <string> damage-plural: "Damage scenarios";
    in property <string> goal-singular: "Cybersecurity goal";
    in property <string> goal-plural: "Cybersecurity goals";
    // The description boxes of the page on screen, and saving one.
    in property <[DescriptionItem]> descriptions;
    callback set-description(int, string);
    callback set-description-translation(int, string, string);
    callback remove-description-translation(int, string);
    // The window that edits one description.
    // The server holds a newer saved version than the one shown.
    in property <bool> newer-version;
    in property <string> band-text;
    // 0 read-only (free), 1 read-only (someone else edits), 2 editing
    in property <int> band-kind;
    in property <string> sync-text;
    // Whether the risk numbers are checked against the server's (G15):
    // 0 checked, 1 checking, 2 the server's numbers are shown, 3 not comparable.
    in property <int> numbers-kind;
    in property <string> numbers-text;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // The draft being typed (UI-08): "", "asset", "damage" or "control".
    in property <string> draft-kind;
    in property <int> draft-seq;
    // Why the last create was refused, shown in the draft form (UI-08.6).
    in property <string> draft-error;
    // Why the header "New ..." buttons are off, "" when they work (UI-08.5).
    out property <string> new-reason: root.editing ? "" : root.band-kind == 1 ? @tr("Read only") + ": " + root.band-text : @tr("Read only: take the edit lock first.");
    // The draft the new-element shortcut starts on the page on screen, "" if the page has none.
    pure function new-kind() -> string {
        if (root.page == Pages.assets) { return "asset"; }
        if (root.page == Pages.damage) { return "damage"; }
        if (root.page == Pages.threats) { return "threat"; }
        if (root.page == Pages.trees) { return "tree"; }
        if (root.page == Pages.controls) { return "control"; }
        if (root.page == Pages.goals) { return "goal"; }
        if (root.page == Pages.item) {
            return root.item-tab == 0 ? "component" : root.item-tab == 1 ? "interface" : root.item-tab == 2 ? "data-flow" : "trust-boundary";
        }
        return "";
    }
    public function begin-new() {
        if (root.editing && root.new-kind() != "") { root.begin-draft(root.new-kind()); }
    }
    // The text of the draft row in each table; translated here, read by the controller.
    out property <string> draft-row-asset: @tr("New asset");
    out property <string> draft-row-damage: @tr("New ") + root.damage-singular;
    out property <string> draft-row-control: @tr("New control");
    out property <string> draft-row-threat: @tr("New threat scenario");
    out property <string> draft-row-goal: @tr("New ") + root.goal-singular;
    out property <string> draft-row-claim: @tr("New claim");
    out property <string> draft-row-tree: @tr("New attack tree");
    // The threat draft's required fields: positions in the asset and category lists, -1 if none.
    in property <int> draft-asset: -1;
    in property <int> draft-category: -1;
    in property <bool> draft-incomplete;
    out property <string> draft-row-component: @tr("New component");
    out property <string> draft-row-interface: @tr("New interface");
    out property <string> draft-row-data-flow: @tr("New data flow");
    out property <string> draft-row-trust-boundary: @tr("New trust boundary");
    // The item definition drafts: positions in the component list (interface component,
    // flow from, flow to) and in the interface kinds, -1 if none.
    in property <int> draft-component: -1;
    in property <int> draft-to: -1;
    in property <int> draft-interface-kind: -1;
    callback set-draft-component(int);
    callback set-draft-to(int);
    callback set-draft-interface-kind(int);
    // A draft of an item definition element opens its tab.
    changed draft-kind => {
        if (root.draft-kind == "component") { root.item-tab = 0; }
        if (root.draft-kind == "interface") { root.item-tab = 1; }
        if (root.draft-kind == "data-flow") { root.item-tab = 2; }
        if (root.draft-kind == "trust-boundary") { root.item-tab = 3; }
    }
    callback set-draft-asset(int);
    callback set-draft-category(int);
    callback begin-draft(string);
    callback commit-draft(string, bool);
    callback cancel-draft();
// What Undo / Redo would do, "remove asset 'Brake ECU'" (UI-10.2); empty if nothing.
in property <string> undo-label;
in property <string> redo-label;
    // Platform-spelled shortcut labels for the Undo/Redo tooltips (UI-10.2).
    in property <string> undo-shortcut;
    in property <string> redo-shortcut;
    in property <bool> show-residual;
    in property <bool> is-empty;
    in property <int> page: 0;

    // ---- platform fidelity (job 113, D25, UI-07) ----
    // True on macOS; lets the UI spell a modifier the Apple way.
    // A platform-spelled hint for the description editor, built from the one
    // shortcut table in Rust (shortcuts.rs) so no .slint file names a key.
    in property <string> save-description-label;
    // The single shortcut table in Rust (shortcuts.rs) drives every menu
    // accelerator, so a shortcut is written once (UI-07.6).
    in property <keys> palette-keys;
    in property <keys> undo-keys;
    in property <keys> redo-keys;
    in property <keys> begin-edit-keys;
    in property <keys> end-edit-keys;
    in property <keys> new-element-keys;
    in property <keys> save-description-keys;
    in property <keys> overview-keys;
    in property <keys> assets-keys;
    in property <keys> damage-keys;
    in property <keys> threats-keys;
    in property <keys> trees-keys;
    in property <keys> risks-keys;
    in property <keys> controls-keys;
    in property <keys> goals-keys;
    in property <keys> problems-keys;
    in property <keys> item-keys;
    // System font families applied by platform.rs (UI-07.7). The UI family is
    // bound to `default-font-family` below; the monospace family is used by
    // identifier and detail surfaces.
    in property <string> ui-font-family;
    in property <string> mono-font-family;
    // Set by main.rs from the renderer it selected; the test platform draws on the CPU.
    in property <bool> gpu-renderer;
    default-font-family: root.ui-font-family;
    default-font-size: Theme.font-body;
    // One entry per page: a count shown in the sidebar, or empty.
    in property <[string]> nav-counts;

    // ---- vocabulary ----
    in property <[string]> property-labels;
    in property <[string]> threat-categories;
    // "Not rated" first.
    in property <[string]> feasibility-options;
    // The levels only.
    in property <[string]> feasibility-levels;
    // "Not decided" first.
    in property <[string]> treatment-options;
    in property <[string]> catalog-schemes;
    in property <[string]> interface-kinds;

    // ---- overview ----
    in property <[CountItem]> ov-counts;
    in property <[CountItem]> ov-inherent;
    in property <[CountItem]> ov-residual;
    in property <int> ov-most: 1;
    in property <int> ov-errors;
    in property <int> ov-warnings;
    in property <[LinkItem]> ov-top;

    // ---- item definition (job 074) ----
    in-out property <int> item-tab: 0;
    in property <[string]> component-names;
    in property <[[StandardListViewItem]]> component-rows;
    in property <int> component-selected: -1;
    in property <bool> has-component;
    in property <string> component-id;
    in property <string> component-name;
    in property <[string]> component-parent-options;
    in property <int> component-parent: 0;
    in property <[LinkItem]> component-interfaces;
    in property <[LinkItem]> component-assets;
    in property <string> component-changed;
    in property <[[StandardListViewItem]]> interface-rows;
    in property <int> interface-selected: -1;
    in property <bool> has-interface;
    in property <string> interface-id;
    in property <string> interface-name;
    in property <string> interface-component;
    in property <int> interface-kind: 0;
    in property <[LinkItem]> interface-flows;
    in property <string> interface-changed;
    in-out property <string> new-interface-name;
    in-out property <int> new-interface-component: 0;
    in-out property <int> new-interface-kind: 0;
    in property <[[StandardListViewItem]]> data-flow-rows;
    in property <int> data-flow-selected: -1;
    in property <bool> has-data-flow;
    in property <string> data-flow-id;
    in property <string> data-flow-name;
    in property <string> data-flow-from;
    in property <string> data-flow-to;
    in property <[string]> data-flow-interface-options;
    in property <int> data-flow-interface: 0;
    in property <bool> data-flow-crosses-boundary;
    in property <string> data-flow-changed;
    in-out property <string> new-flow-name;
    in-out property <int> new-flow-from: 0;
    in-out property <int> new-flow-to: 0;
    in property <[[StandardListViewItem]]> trust-boundary-rows;
    in property <int> trust-boundary-selected: -1;
    in property <bool> has-trust-boundary;
    in property <string> trust-boundary-id;
    in property <string> trust-boundary-name;
    in property <[CheckItem]> trust-boundary-members;
    in property <string> trust-boundary-changed;

    // ---- assets ----
    in property <[[StandardListViewItem]]> asset-rows;
    in property <int> asset-selected: -1;
    in property <bool> has-asset;
    in property <string> asset-id;
    in property <string> asset-name;
    in property <[string]> asset-component-options;
    in property <int> asset-component: 0;
    in property <[CheckItem]> asset-properties;
    in property <[LinkItem]> asset-threats;
    in property <[LinkItem]> asset-damages;
    in property <string> asset-changed;

    // ---- damage ----
    in property <[[StandardListViewItem]]> damage-rows;
    in property <int> damage-selected: -1;
    in property <bool> has-damage;
    in property <string> damage-id;
    in property <string> damage-name;
    in property <[FactorItem]> damage-impacts;
    in property <[LinkItem]> damage-threats;
    in property <[LinkItem]> damage-assets;
    in property <string> damage-changed;

    // ---- threats and risks ----
    in property <[ThreatItem]> threats;
    in property <[[StandardListViewItem]]> threat-rows;
    in property <int> threat-selected: -1;
    in property <[string]> asset-names;
    in-out property <string> new-threat-name;
    in-out property <int> new-threat-asset: 0;
    in-out property <int> new-threat-category: 0;
    in property <bool> has-threat-detail;
    in property <string> td-id;
    in property <string> td-name;
    in property <string> td-asset;
    in property <int> td-category;
    in property <[CheckItem]> td-damages;
    in property <[string]> td-refs;
    in-out property <int> new-ref-scheme: 0;
    in-out property <string> new-ref-text;
    in property <int> td-feasibility;
    in property <[string]> tree-names;
    in property <int> td-tree;
    in property <string> td-feasibility-text;
    in property <string> td-inherent;
    in property <string> td-residual;
    in property <int> td-inherent-tone;
    in property <int> td-residual-tone;
    in property <[string]> td-why;
    in property <string> td-changed;
    in property <int> td-treatment;
    in property <[string]> goal-names;
    in property <int> td-goal;
    in property <[string]> claim-names;
    in property <int> td-claim;
    in property <[[StandardListViewItem]]> risk-rows;
    in property <int> risk-selected: -1;

    // ---- attack trees ----
    in property <[[StandardListViewItem]]> tree-rows;
    in property <int> tree-selected: -1;
    in property <[DrawItem]> draw;
    in property <[DrawItem]> draw-paths;
    in property <[DrawItem]> draw-rects;
    in property <[DrawItem]> draw-texts;
    in property <[AccessNode]> access-nodes;
    in property <bool> has-tree;
    in property <string> tree-title;
    in property <string> zoom-text: @tr("100%");
    in property <string> canvas-summary;
    in property <string> outline-text;
    in property <bool> has-inspector;
    in property <string> inspector-tree-id;
    in property <string> inspector-title;
    in property <bool> inspector-needs-review;
    callback mark-reviewed();
    in property <string> inspector-kind;
    in property <bool> inspector-is-step;
    in property <bool> inspector-is-root;
    in property <int> inspector-gate-index;
    in property <bool> inspector-can-move-up;
    in property <bool> inspector-can-move-down;
    in-out property <string> new-node-label;
    in-out property <int> new-node-kind: 0;
    in property <[string]> level-options;
    in property <int> rating-index;
    in property <string> effective-text;
    in property <string> potential-text;
    in property <[FactorItem]> factors;
    in property <string> evaluated-text;
    in property <int> evaluated-tone;
    in property <[string]> why-lines;
    in property <[MitigationItem]> mitigations;
    in property <[SuggestionItem]> suggestion-rows;
    in property <[string]> attach-names;
    in property <string> step-residual-text;
    in-out property <int> attach-control-index: 0;
    in-out property <int> attach-level-index: 0;
    // Where the canvas is in the window, for tests that click on nodes.
    in-out property <length> canvas-x;
    // The last data table to lay out (tests aim real clicks at its rows).
    // Enter or Open on a row asks the details panel's name field for the
    // keyboard; the request lapses if no such field appears.
    // The word a duplicated element's name ends with.
    in property <string> copy-suffix: @tr("copy");
    in-out property <bool> focus-name;
    function focus-inspector() {
        if (root.editing) { root.focus-name = true; }
    }
    Timer {
        interval: 800ms;
        running: root.focus-name;
        triggered => { root.focus-name = false; }
    }
    in-out property <length> table-x;
    in-out property <length> table-y;
    in-out property <length> table-w;
    in-out property <length> canvas-y;

    // ---- controls ----
    in property <[[StandardListViewItem]]> control-rows;
    in property <int> control-selected: -1;
    in property <bool> has-control;
    in property <string> control-id;
    in property <string> control-name;
    in property <[LinkItem]> control-steps;
    in property <[LinkItem]> control-goals;
    in property <string> control-changed;

    // ---- goals and claims ----
    in property <[[StandardListViewItem]]> goal-rows;
    in property <int> goal-selected: -1;
    in property <bool> has-goal;
    in property <string> goal-id;
    in property <string> goal-name;
    in property <[CheckItem]> goal-controls;
    in property <[LinkItem]> goal-threats;
    in property <[[StandardListViewItem]]> claim-rows;
    in property <int> claim-selected: -1;
    in property <bool> has-claim;
    in property <string> claim-id;
    in property <string> claim-name;
    in property <[LinkItem]> claim-threats;

