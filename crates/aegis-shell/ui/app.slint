    // Opens the one-line input dialog. The answer comes back through
    // `prompt-accepted` with the same kind.
    public function ask(kind: string, title: string, label: string, text: string) {
        root.prompt-kind = kind;
        root.prompt-title = title;
        root.prompt-label = label;
        root.prompt-text = text;
        root.prompt-secret = false;
        root.prompt-open = true;
    }

    public function confirm(kind: string, text: string) {
        root.confirm-kind = kind;
        root.confirm-text = text;
        root.confirm-title = root.confirm-title-for(kind);
        root.confirm-action = root.confirm-action-for(kind);
        root.confirm-open = true;
    }

    // UI-12: a dialog names the thing in its title, and its main button says
    // the action, never "Yes" or "OK".
    pure function confirm-title-for(kind: string) -> string {
        if (kind == "delete-project") { return @tr("Delete project '{}'?", root.project-name); }
        if (kind == "break-lock") { return @tr("Break the edit lock?"); }
        if (kind == "revoke-session") { return @tr("End this session?"); }
        if (kind == "delete-user") { return @tr("Delete this user?"); }
        if (kind == "password-login-off") { return @tr("Turn password login off?"); }
        return @tr("Log out?");
    }
    pure function confirm-action-for(kind: string) -> string {
        if (kind == "delete-project") { return @tr("Delete project"); }
        if (kind == "break-lock") { return @tr("Break lock"); }
        if (kind == "revoke-session") { return @tr("End session"); }
        if (kind == "delete-user") { return @tr("Delete user"); }
        if (kind == "password-login-off") { return @tr("Turn off"); }
        return @tr("Log out");
    }

    public function confirm-named(kind: string, title: string, text: string, action: string) {
        root.confirm-kind = kind;
        root.confirm-title = title;
        root.confirm-text = text;
        root.confirm-action = action;
        root.confirm-open = true;
    }

    function close-palette() {
        root.palette-open = false;
        root.palette-shortcuts-open = false;
        root.palette-query = "";
    }

    function run-palette-row(row: int) {
        if (!root.palette-shortcuts-open && root.palette-rows.length > 0) {
            root.palette-pick(row >= 0 && row < root.palette-rows.length ? row : 0);
        }
    }

    function prompt-done(kind: string, text: string) {
        root.prompt-open = false;
        if (text == "") { return; }
        if (kind == "new-project") { root.create-project(text); }
        if (kind == "rename-project") { root.rename-project(text); }
        if (kind == "create-baseline") { root.create-baseline(text); }
        if (kind == "reset-password") { root.reset-user-password(text); }
    }

    // The Undo / Redo tooltip: the action and the shortcut, or why it is off (UI-10.2).
    pure function undo-tip() -> string {
        if (!root.editing) { return @tr("Read only") + ": " + root.band-text; }
        if (!root.can-undo) { return @tr("Nothing to undo"); }
        return @tr("Undo {} ({})", root.undo-label, root.undo-shortcut);
    }
    pure function redo-tip() -> string {
        if (!root.editing) { return @tr("Read only") + ": " + root.band-text; }
        if (!root.can-redo) { return @tr("Nothing to redo"); }
        return @tr("Redo {} ({})", root.redo-label, root.redo-shortcut);
    }

    function confirm-done(kind: string) {
        root.confirm-open = false;
        if (kind == "delete-user") { root.delete-user(); }
        if (kind == "revoke-session") { root.revoke-session(); }
        if (kind == "remove-member") { root.remove-membership(); }
        if (kind == "delete-project") { root.delete-project(); }
        if (kind == "break-lock") { root.break-lock(); }
        if (kind == "password-login-off") { root.set-password-login(false); }
        if (kind == "log-out") { root.log-out(); }
    }

    property <bool> in-project: root.connection == 1 && root.has-project;
    property <bool> online: root.connection == 1;

    // ===================================================================
    // Menus, with Lucide glyphs.
    // ===================================================================
    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New project folder…"); icon: @image-url("icons/file-plus.svg"); activated => { root.change-server(); } }
            MenuItem { title: @tr("Open project folder…"); icon: @image-url("icons/folder-open.svg"); activated => { root.change-server(); } }
            MenuSeparator {}
            MenuItem { title: @tr("New project…"); icon: @image-url("icons/file-plus.svg"); enabled: root.online; activated => { root.ask("new-project", "New project", "Project name", ""); } }
            MenuItem { title: @tr("Projects"); icon: @image-url("icons/folder-open.svg"); enabled: root.online; activated => { root.close-project(); } }
            MenuItem { title: @tr("Close project"); icon: @image-url("icons/folder-x.svg"); enabled: root.in-project; activated => { root.close-project(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Export TARA report (PDF)"); icon: @image-url("icons/file-down.svg"); enabled: root.in-project; activated => { root.export-pdf(); } }
            MenuItem { title: @tr("Export TARA report (HTML)"); icon: @image-url("icons/file-text.svg"); enabled: root.in-project; activated => { root.export-report(); } }
            MenuItem { title: @tr("Export risk register (CSV)"); icon: @image-url("icons/sheet.svg"); enabled: root.in-project; activated => { root.export-csv(); } }
            MenuItem { title: @tr("Export attack tree (SVG)"); icon: @image-url("icons/image.svg"); enabled: root.in-project && root.has-tree; activated => { root.export-svg(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Change password…"); icon: @image-url("icons/key-round.svg"); enabled: root.online && root.is-password; activated => { root.pw-current = ""; root.pw-new = ""; root.pw-repeat = ""; root.password-open = true; } }
            MenuItem { title: @tr("Change server…"); icon: @image-url("icons/server.svg"); activated => { root.change-server(); } }
            MenuItem { title: @tr("Log out"); icon: @image-url("icons/log-out.svg"); enabled: root.online && !root.standalone-mode; activated => { root.confirm("log-out", "Log out of this server?"); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: (root.can-undo && root.editing) ? @tr("Undo {}", root.undo-label) : @tr("Undo"); icon: @image-url("icons/undo-2.svg"); shortcut: root.undo-keys; enabled: root.in-project && root.editing && root.can-undo && !Typing.dirty; activated => { root.undo(); } }
            MenuItem { title: (root.can-redo && root.editing) ? @tr("Redo {}", root.redo-label) : @tr("Redo"); icon: @image-url("icons/redo-2.svg"); shortcut: root.redo-keys; enabled: root.in-project && root.editing && root.can-redo && !Typing.dirty; activated => { root.redo(); } }
            MenuItem { title: @tr("New element on this page"); icon: @image-url("icons/plus.svg"); shortcut: root.new-element-keys; enabled: root.in-project && root.editing && root.new-kind() != ""; activated => { root.begin-new(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Take the edit lock"); icon: @image-url("icons/pencil.svg"); shortcut: root.begin-edit-keys; enabled: root.in-project && root.band-kind == 0; activated => { root.begin-edit(); } }
            MenuItem { title: @tr("Release the edit lock"); icon: @image-url("icons/lock.svg"); enabled: root.in-project && root.editing; activated => { root.end-edit(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Command palette…"); icon: @image-url("icons/keyboard.svg"); shortcut: root.palette-keys; enabled: root.in-project; activated => { root.open-palette(); } }
            MenuItem { title: @tr("Overview"); icon: @image-url("icons/layout-dashboard.svg"); shortcut: root.overview-keys; enabled: root.in-project; activated => { root.show-page(Pages.overview); } }
            MenuItem { title: @tr("Item definition"); icon: @image-url("icons/network.svg"); shortcut: root.item-keys; enabled: root.in-project; activated => { root.show-page(Pages.item); } }
            MenuItem { title: @tr("Assets"); icon: @image-url("icons/box.svg"); shortcut: root.assets-keys; enabled: root.in-project; activated => { root.show-page(Pages.assets); } }
            MenuItem { title: @tr("Damage scenarios"); icon: @image-url("icons/triangle-alert.svg"); shortcut: root.damage-keys; enabled: root.in-project; activated => { root.show-page(Pages.damage); } }
            MenuItem { title: @tr("Threat scenarios"); icon: @image-url("icons/swords.svg"); shortcut: root.threats-keys; enabled: root.in-project; activated => { root.show-page(Pages.threats); } }
            MenuItem { title: @tr("Attack trees"); icon: @image-url("icons/network.svg"); shortcut: root.trees-keys; enabled: root.in-project; activated => { root.show-page(Pages.trees); } }
            MenuItem { title: @tr("Risks and treatment"); icon: @image-url("icons/gauge.svg"); shortcut: root.risks-keys; enabled: root.in-project; activated => { root.show-page(Pages.risks); } }
            MenuItem { title: @tr("Security controls"); icon: @image-url("icons/shield-check.svg"); shortcut: root.controls-keys; enabled: root.in-project; activated => { root.show-page(Pages.controls); } }
            MenuItem { title: @tr("Goals and claims"); icon: @image-url("icons/target.svg"); shortcut: root.goals-keys; enabled: root.in-project; activated => { root.show-page(Pages.goals); } }
            MenuItem { title: @tr("Problems"); icon: @image-url("icons/circle-alert.svg"); shortcut: root.problems-keys; enabled: root.in-project; activated => { root.show-page(Pages.problems); } }
            MenuSeparator {}
            MenuItem { title: @tr("Risk after controls"); icon: @image-url("icons/eye.svg"); checkable: true; checked: root.show-residual; enabled: root.in-project; activated => { root.set-residual(!root.show-residual); } }
            MenuItem { title: @tr("Fit the tree"); icon: @image-url("icons/maximize.svg"); enabled: root.in-project && root.has-tree; activated => { root.fit(); } }
            MenuItem { title: @tr("Zoom to 100%"); icon: @image-url("icons/zoom-in.svg"); enabled: root.in-project && root.has-tree; activated => { root.zoom-reset(); } }
            MenuSeparator {}
            Menu {
                title: @tr("Appearance");
                MenuItem { title: @tr("System"); checkable: true; checked: root.appearance == 0; activated => { root.appearance = 0; root.appearance-selected(0); } }
                MenuItem { title: @tr("Light"); checkable: true; checked: root.appearance == 1; activated => { root.appearance = 1; root.appearance-selected(1); } }
                MenuItem { title: @tr("Dark"); checkable: true; checked: root.appearance == 2; activated => { root.appearance = 2; root.appearance-selected(2); } }
            }
        }
        Menu {
            title: @tr("Project");
            MenuItem { title: @tr("Rename project…"); icon: @image-url("icons/pencil.svg"); enabled: root.in-project && root.editing; activated => { root.ask("rename-project", "Rename project", "Project name", root.project-name); } }
            MenuItem { title: @tr("Add the sample TARA"); icon: @image-url("icons/plus.svg"); enabled: root.in-project && root.editing && root.is-empty; activated => { root.create-sample(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Reload newer version"); icon: @image-url("icons/refresh-cw.svg"); enabled: root.in-project && root.newer-version; activated => { root.reload(); } }
            MenuItem { title: @tr("Create baseline…"); icon: @image-url("icons/flag.svg"); enabled: root.in-project; activated => { root.ask("create-baseline", "Create baseline", "Baseline name, for example B1 Design freeze", ""); } }
            MenuItem { title: @tr("Versions and comparison"); icon: @image-url("icons/git-compare.svg"); enabled: root.in-project; activated => { root.show-page(Pages.versions); } }
            MenuItem { title: @tr("History"); icon: @image-url("icons/history.svg"); enabled: root.in-project; activated => { root.show-page(Pages.history); } }
            MenuItem { title: @tr("Reports"); icon: @image-url("icons/file-chart-column.svg"); enabled: root.in-project; activated => { root.show-page(Pages.reports); } }
        }
        Menu {
            title: @tr("Admin");
            MenuItem { title: @tr("Users and project tools"); icon: @image-url("icons/user-cog.svg"); enabled: root.in-project && root.is-admin; activated => { root.show-page(Pages.admin); } }
            MenuItem { title: @tr("Check the audit chain"); icon: @image-url("icons/list-checks.svg"); enabled: root.in-project && root.is-admin; activated => { root.verify-audit(); } }
            MenuItem { title: @tr("Break the edit lock"); icon: @image-url("icons/unlink.svg"); enabled: root.in-project && root.is-admin && root.band-kind == 1; activated => { root.confirm("break-lock", "Break the edit lock? The other editor's unsaved changes are lost."); } }
            MenuItem { title: @tr("Delete project…"); icon: @image-url("icons/trash-2.svg"); enabled: root.in-project && root.is-admin; activated => { root.confirm("delete-project", "Delete this project, its history and its baselines? This cannot be undone."); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("Keyboard shortcuts"); icon: @image-url("icons/keyboard.svg"); activated => { root.open-palette(); root.palette-shortcuts-open = true; } }
            MenuItem { title: @tr("Check for updates"); icon: @image-url("icons/refresh-cw.svg"); activated => { root.check-for-updates(); } }
            MenuItem { title: @tr("Download update"); icon: @image-url("icons/file-down.svg"); activated => { root.download-update(); } }
            MenuItem { title: @tr("About AegisTARA"); icon: @image-url("icons/info.svg"); activated => { root.show-about = true; } }
        }
    }

    // ===================================================================
    // Not connected: one centered card with dark-mode splash header.
    // ===================================================================
    if root.connection != 1: Rectangle {
        background: Theme.dark
            ? @linear-gradient(180deg, Theme.obsidian-core 0%, Theme.obsidian-edge 100%)
            : Theme.sheet;
        Rectangle {
            width: min(parent.width - 48px, 500px);
            height: splash-banner.height + card-column.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: Theme.radius-panel;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                splash-banner := SplashHeader {
                    banner-height: root.connection == 4 ? 136px : 152px;
                    status-text: root.connection == 0 ? "CONNECTING"
                        : root.connection == 2 ? "OFFLINE"
                        : root.connection == 3 ? "AUTH REQUIRED"
                        : "SERVER & WORKSPACE";
                    status-color: root.connection == 2 ? Theme.high
                        : root.connection == 3 ? Theme.medium
                        : Theme.crimson-bright;
                }
                card-column := VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    if root.server-name != "" && root.connection == 3: HorizontalLayout {
                        spacing: 8px;
                        Image { source: @image-url("icons/server.svg"); width: 16px; height: 16px; y: 2px; colorize: Theme.accent; }
                        Text { text: root.server-name; color: Theme.ink; font-size: Theme.font-body + 1px; font-weight: 600; }
                    }
                    Text {
                        text: root.connection-text;
                        wrap: word-wrap;
                        color: Theme.graphite;
                        font-size: Theme.font-body;
                        accessible-role: text;
                    }
                    // Choose a server.
                    if root.connection == 4: VerticalLayout {
                        spacing: 8px;
                        Field {
                            label: @tr("Server address");
                            url-edit := LineEdit {
                                text <=> root.server-url;
                                placeholder-text: @tr("https://aegis.example.com");
                                accessible-label: @tr("Server address");
                                accepted(t) => { root.connect-server(t, root.transport-index); }
                            }
                        }
                        Field {
                            label: @tr("Connection");
                            Choice {
                                options: ["Automatic", "gRPC (HTTP/2)", "gRPC-Web (HTTP/1.1, through any proxy)"];
                                index: root.transport-index;
                                label: @tr("Connection");
                                picked(i) => { root.transport-index = i; }
                            }
                        }
                        Button {
                            text: @tr("Connect");
                            icon: @image-url("icons/server.svg");
                            primary: true;
                            enabled: root.server-url != "" && !root.login-busy;
                            clicked => { root.connect-server(root.server-url, root.transport-index); }
                        }
                        Rectangle { height: 1px; background: Theme.rule; }
                        Text { text: @tr("Or work without a server"); color: Theme.graphite; font-size: Theme.font-label; font-weight: 600; }
                        Field {
                            label: @tr("Project folder");
                            LineEdit {
                                text <=> root.standalone-folder;
                                placeholder-text: @tr("/path/to/project-folder");
                                accessible-label: @tr("Standalone project folder");
                            }
                        }
                        Field {
                            label: @tr("Signed license file");
                            LineEdit {
                                text <=> root.standalone-license;
                                placeholder-text: @tr("/path/to/license.aegis");
                                accessible-label: @tr("Standalone license file");
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: @tr("New folder");
                                icon: @image-url("icons/file-plus.svg");
                                enabled: root.standalone-folder != "" && root.standalone-license != "" && !root.login-busy;
                                clicked => { root.new-project-folder(root.standalone-folder, root.standalone-license); }
                            }
                            Button {
                                text: @tr("Open folder");
                                icon: @image-url("icons/folder-open.svg");
                                primary: true;
                                enabled: root.standalone-folder != "" && root.standalone-license != "" && !root.login-busy;
                                clicked => { root.open-project-folder(root.standalone-folder, root.standalone-license); }
                            }
                        }
                    }
                    if root.connection == 2: HorizontalLayout {
                        spacing: 8px;
                        Button { text: @tr("Try again"); icon: @image-url("icons/refresh-cw.svg"); clicked => { root.retry(); } }
                        Button { text: @tr("Change server"); icon: @image-url("icons/server.svg"); clicked => { root.change-server(); } }
                    }
                    // Password login.
                    if root.connection == 3 && root.login-method == 1: VerticalLayout {
                        spacing: 10px;
                        Field {
                            label: @tr("User name");
                            LineEdit {
                                text <=> root.login-user;
                                accessible-label: @tr("User name");
                            }
                        }
                        Field {
                            label: @tr("Password");
                            LineEdit {
                                text <=> root.login-password;
                                input-type: password;
                                accessible-label: @tr("Password");
                                accepted(t) => { root.password-log-in(root.login-user, root.login-password, root.remember); }
                            }
                        }
                        CheckBox { text: @tr("Keep me logged in on this computer"); checked <=> root.remember; }
                        if root.login-error != "": FieldError { text: root.login-error; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.login-busy ? "Logging in…" : "Log in";
                                icon: @image-url("icons/log-in.svg");
                                primary: true;
                                enabled: root.login-user != "" && root.login-password != "" && !root.login-busy;
                                clicked => { root.password-log-in(root.login-user, root.login-password, root.remember); }
                            }
                            Button { text: @tr("Change server"); clicked => { root.change-server(); } }
                            if root.password-also: Button { text: @tr("Use company login"); icon: @image-url("icons/key-round.svg"); clicked => { root.use-company-login(); } }
                        }
                    }
                    // Development login.
                    if root.connection == 3 && root.login-method == 2: VerticalLayout {
                        spacing: 10px;
                        Text { text: @tr("Development server: no password is checked."); color: Theme.medium; font-size: Theme.font-label; }
                        Field {
                            label: @tr("User name");
                            LineEdit { text <=> root.login-user; accessible-label: @tr("User name"); accepted(t) => { root.dev-log-in(t); } }
                        }
                        Button { text: @tr("Continue"); primary: true; enabled: root.login-user != ""; clicked => { root.dev-log-in(root.login-user); } }
                    }
                    // Company login.
                    if root.connection == 3 && root.login-method == 0: VerticalLayout {
                        spacing: 8px;
                        if root.login-error != "": FieldError { text: root.login-error; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: @tr("Log in"); primary: true; clicked => { root.log-in(); } }
                            Button { text: @tr("Change server"); clicked => { root.change-server(); } }
                            if root.password-also: Button { text: @tr("Use a user name and password"); clicked => { root.use-password-login(); } }
                        }
                    }
                }
            }
        }
    }

    // ===================================================================
    // Connected, no project open: the project list.
    // ===================================================================
    if root.connection == 1 && !root.has-project: Rectangle {
        background: Theme.dark
            ? @linear-gradient(180deg, Theme.obsidian-core 0%, Theme.obsidian-edge 100%)
            : Theme.sheet;
        Rectangle {
            width: min(parent.width - 48px, 640px);
            height: min(parent.height - 48px, 580px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: Theme.radius-panel;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                SplashHeader {
                    banner-height: 136px;
                    status-text: root.standalone-mode ? "STANDALONE" : "ONLINE";
                    status-color: Theme.very-low;
                }
                VerticalLayout {
                    vertical-stretch: 1;
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        Image { source: @image-url("icons/folder-open.svg"); width: 20px; height: 20px; y: 5px; colorize: Theme.accent; }
                        Text {
                            text: @tr("Projects");
                            font-size: Theme.font-display;
                            font-weight: Theme.weight-heavy;
                            letter-spacing: Theme.tracking-tight;
                            color: Theme.ink;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: @tr("Refresh"); icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-projects(); } }
                        Button { text: @tr("About"); icon: @image-url("icons/info.svg"); clicked => { root.show-about = true; } }
                    }
                    if root.projects.length == 0: Text {
                        text: @tr("There are no projects yet. Create the first one below.");
                        color: Theme.graphite;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-medium;
                        wrap: word-wrap;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for p in root.projects: Rectangle {
                                height: 44px;
                                background: area.has-hover ? Theme.wash : transparent;
                                border-width: 1px;
                                border-color: area.has-hover ? Theme.accent : Theme.rule;
                                border-radius: Theme.radius-control;
                                accessible-role: button;
                                accessible-label: @tr("Open project ") + p.name;
                                accessible-action-default => { root.open-project(p.id); }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Text {
                                        text: p.name;
                                        color: Theme.ink;
                                        font-size: Theme.font-h2;
                                        font-weight: Theme.weight-bold;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: p.methodology;
                                        color: Theme.graphite;
                                        font-size: Theme.font-label;
                                        font-weight: Theme.weight-semibold;
                                        vertical-alignment: center;
                                    }
                                }
                                area := TouchArea { clicked => { root.open-project(p.id); } }
                            }
                        }
                    }
                    // The method decides the rating scales, the impact categories and
                    // what the elements are called; it is fixed when the project is made.
                    Text {
                        text: @tr("New project: name it and pick the assessment method.");
                        color: Theme.ink;
                        font-size: Theme.font-label;
                        font-weight: Theme.weight-semibold;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: @tr("New project name");
                            text <=> root.new-project-name;
                            accepted(t) => {
                                if (t != "") { root.create-project(t); root.new-project-name = ""; }
                            }
                        }
                        Choice {
                            options: [@tr("ISO/SAE 21434 · road vehicles"), @tr("EU Cyber Resilience Act · connected products"), @tr("STRIDE · software and cloud services")];
                            index <=> root.new-project-methodology;
                            label: @tr("Assessment method");
                        }
                        Button {
                            text: @tr("Create");
                            icon: @image-url("icons/file-plus.svg");
                            primary: true;
                            enabled: root.new-project-name != "";
                            clicked => {
                                root.create-project(root.new-project-name);
                                root.new-project-name = "";
                            }
                        }
                    }
                    Text {
                        text: root.new-project-methodology == 1
                            ? @tr("For products with digital elements sold in the EU (CRA Annex I). Harms are rated on health and safety, data and privacy, availability, and financial impact; likelihood is rated directly; goals are called security requirements.")
                            : root.new-project-methodology == 2
                            ? @tr("For software services and cloud systems. One service-impact scale and a direct likelihood rating: the lightest method, good for a first pass.")
                            : @tr("For vehicles and their parts (ISO/SAE 21434, UN R155). Damage is rated on safety, financial, operational and privacy impact; feasibility is worked out from attack potential.");
                        color: Theme.graphite;
                        font-size: Theme.font-label;
                        wrap: word-wrap;
                    }
                    Text { text: (root.standalone-mode ? "Standalone project. " : "Logged in as " + root.user + ". ") + root.engine-text; color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-medium; overflow: elide; }
                }
            }
        }
    }

    // ===================================================================
    // A project is open.
    // ===================================================================
    if root.in-project: VerticalLayout {
        // ---- mode band ----
        Rectangle {
            height: 32px;
            background: root.band-kind == 2 ? Theme.band : Theme.wash;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Image {
                    source: root.band-kind == 2 ? @image-url("icons/pencil.svg") : @image-url("icons/lock.svg");
                    width: 16px;
                    height: 16px;
                    y: 8px;
                    colorize: root.band-kind == 2 ? Theme.band-text : Theme.ink;
                }
                Text {
                    text: root.band-text;
                    color: root.band-kind == 2 ? Theme.band-text : Theme.ink;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-role: text;
                }
                if root.newer-version: Button {
                    text: @tr("Reload");
                    icon: @image-url("icons/refresh-cw.svg");
                    primary: true;
                    accessible-label: @tr("Reload the newer version");
                    clicked => { root.reload(); }
                }
                if root.band-kind == 0: Button {
                    text: @tr("Edit");
                    primary: root.band-kind == 0 && !root.newer-version;
                    clicked => { root.begin-edit(); }
                }
                if root.band-kind == 2: Button {
                    text: @tr("Release edit lock");
                    clicked => { root.end-edit(); }
                }
            }
        }
        // ---- header ----
        Rectangle {
            height: 52px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 16px;
                spacing: 10px;
                Image {
                    source: @image-url("brand/App_Icon_Resolutions/AegisTARA_Icon_64x64.png");
                    width: 30px;
                    height: 30px;
                    y: 11px;
                }
                Rectangle { width: 1px; height: 24px; y: 14px; background: Theme.rule; }
                Button { text: @tr("Projects"); icon: @image-url("icons/folder-open.svg"); clicked => { root.close-project(); } }
                Button {
                    icon: @image-url("icons/undo-2.svg");
                    accessible-label: root.undo-tip();
                    enabled: root.in-project && root.editing && root.can-undo;
                    clicked => { root.undo(); }
                    Tooltip {
                        Text { text: root.undo-tip(); color: #FFFFFF; font-size: Theme.font-label; }
                    }
                }
                Button {
                    icon: @image-url("icons/redo-2.svg");
                    accessible-label: root.redo-tip();
                    enabled: root.in-project && root.editing && root.can-redo;
                    clicked => { root.redo(); }
                    Tooltip {
                        Text { text: root.redo-tip(); color: #FFFFFF; font-size: Theme.font-label; }
                    }
                }
                Text {
                    text: root.project-name;
                    font-size: Theme.font-h1;
                    font-weight: Theme.weight-heavy;
                    letter-spacing: Theme.tracking-tight;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.sync-text;
                    color: Theme.graphite;
                    font-size: Theme.font-label;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 4px;
                    accessible-role: text;
                    accessible-label: root.numbers-text;
                    Image {
                        source: root.numbers-kind == 0 ? @image-url("icons/badge-check.svg") : root.numbers-kind == 1 ? @image-url("icons/refresh-cw.svg") : @image-url("icons/triangle-alert.svg");
                        colorize: root.numbers-kind == 0 ? Theme.very-low : root.numbers-kind == 1 ? Theme.graphite : Theme.high;
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.numbers-text;
                        color: root.numbers-kind == 0 ? Theme.ink : root.numbers-kind == 1 ? Theme.graphite : Theme.high;
                        font-size: Theme.font-label;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                    }
                }
                if root.is-empty && root.editing: Button {
                    text: @tr("Add sample TARA");
                    primary: true;
                    clicked => { root.create-sample(); }
                }
                Rectangle {
                    width: residual-switch.preferred-width;
                    residual-switch := Switch {
                        text: @tr("Risk after controls");
                        checked: root.show-residual;
                        toggled => { root.set-residual(self.checked); }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.rule; }

        HorizontalLayout {
            vertical-stretch: 1;
            // ---- TARA steps ----
            Rectangle {
                width: 210px;
                background: Theme.panel;
                ScrollView {
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        for item[i] in [
                            { label: @tr("Overview"), icon: @image-url("icons/layout-dashboard.svg") },
                            { label: @tr("Assets"), icon: @image-url("icons/box.svg") },
                            { label: root.damage-plural, icon: @image-url("icons/triangle-alert.svg") },
                            { label: @tr("Threat scenarios"), icon: @image-url("icons/swords.svg") },
                            { label: @tr("Attack trees"), icon: @image-url("icons/network.svg") },
                            { label: @tr("Risks and treatment"), icon: @image-url("icons/gauge.svg") },
                            { label: @tr("Security controls"), icon: @image-url("icons/shield-check.svg") },
                            { label: @tr("Goals and claims"), icon: @image-url("icons/target.svg") },
                            { label: @tr("Problems"), icon: @image-url("icons/circle-alert.svg") },
                            { label: @tr("Versions"), icon: @image-url("icons/git-compare.svg") },
                            { label: @tr("History"), icon: @image-url("icons/history.svg") },
                            { label: @tr("Reports"), icon: @image-url("icons/file-chart-column.svg") },
                            { label: @tr("Administration"), icon: @image-url("icons/user-cog.svg") },
                            { label: @tr("Item definition"), icon: @image-url("icons/network.svg") },
                        ]: Rectangle {
                            visible: i != Pages.admin || root.is-admin;
                            height: self.visible ? 36px : 0px;
                            background: root.page == i ? Theme.accent-wash : (nav-area.has-hover ? Theme.wash : transparent);
                            accessible-role: button;
                            accessible-label: item.label;
                            accessible-action-default => { root.show-page(i); }
                            Rectangle { x: 0; width: 3px; background: root.page == i ? Theme.accent : transparent; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 10px;
                                Image { source: item.icon; width: 18px; height: 18px; y: 9px; colorize: root.page == i ? Theme.accent : Theme.graphite; }
                                Text {
                                    text: item.label;
                                    color: Theme.ink;
                                    font-size: Theme.font-body;
                                    font-weight: root.page == i ? Theme.weight-bold : Theme.weight-medium;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.nav-counts[i];
                                    color: i == Pages.problems && root.nav-counts[i] != "" && root.nav-counts[i] != "0" ? Theme.high : Theme.graphite;
                                    font-size: Theme.font-label;
                                    font-weight: root.page == i ? Theme.weight-bold : Theme.weight-semibold;
                                    vertical-alignment: center;
                                }
                            }
                            nav-area := TouchArea { clicked => { root.show-page(i); } }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.rule; }

            // ---- the page ----
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.sheet;

                // Overview
                if root.page == Pages.overview: ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        PageTitle { title: @tr("Overview"); subtitle: @tr("The project at a glance: what is analysed, how risky it is, and what is still open."); icon: @image-url("icons/layout-dashboard.svg"); }
                        DescriptionFor { items: root.descriptions; kind: "project"; label: @tr("Project notes"); editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;
                            for c in root.ov-counts: Tile { label: c.label; count: c.count; }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 16px;
                            Panel {
                                horizontal-stretch: 1;
                                Bars { title: @tr("Threat scenarios by risk before controls"); items: root.ov-inherent; most: root.ov-most; }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                Bars { title: @tr("Threat scenarios by risk after controls"); items: root.ov-residual; most: root.ov-most; }
                            }
                        }
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 16px;
                            Panel {
                                horizontal-stretch: 2;
                                SectionTitle { text: @tr("Highest risks"); }
                                LinkList { items: root.ov-top; empty-text: @tr("No threat scenario yet."); clicked(i) => { root.ov-top-clicked(i); } }
                            }
                            Panel {
                                horizontal-stretch: 1;
                                SectionTitle { text: @tr("Problems"); }
                                Text { text: root.ov-errors + " blocking, " + root.ov-warnings + " warnings"; color: root.ov-errors > 0 ? Theme.high : Theme.ink; font-size: Theme.font-body + 1px; }
                                Button { text: @tr("Show problems"); icon: @image-url("icons/circle-alert.svg"); clicked => { root.show-page(Pages.problems); } }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Assets
                if root.page == Pages.assets: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: @tr("Assets");
                            subtitle: @tr("What must be protected, and which security properties matter.");
                            icon: @image-url("icons/box.svg");
                            Button { text: @tr("New asset"); icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.begin-draft("asset"); } if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } } }
                        }
                        DataTable {
                            label: @tr("Assets");
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Asset"), horizontal-stretch: 2 }, { title: @tr("Properties"), horizontal-stretch: 2 }, { title: @tr("Threats"), horizontal-stretch: 1 }, { title: @tr("Worst risk"), horizontal-stretch: 1 }];
                            rows: root.asset-rows;
                            selected: root.asset-selected;
                            editable: root.editing;
                            show-add: true;
                            laid-out(x, y, w) => { root.table-x = x; root.table-y = y; root.table-w = w; }
                            add-verb: @tr("Add threat scenario to");
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.pick-asset(i); }
                            activated(i) => { root.pick-asset(i); root.focus-inspector(); }
                            open-row(i) => { root.pick-asset(i); root.focus-inspector(); }
                            add-child(i) => { root.add-child-asset(i); }
                            duplicate-row(i) => { root.duplicate-asset(i); }
                            remove-row(i) => { root.remove-row-asset(i); }
                        }
                    }
                    if root.draft-kind == "asset": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New asset");
                            placeholder: @tr("Asset name");
                            hint: @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            commit(t, next) => { root.commit-draft(t, next); }
                            cancel => { root.cancel-draft(); }
                        }
                    }
                    if root.has-asset && root.draft-kind != "asset": Panel {
                        width: root.side-width;
                        SectionTitle { text: @tr("Asset") + " · " + root.asset-id; }
                        NameEditor { focus-requested <=> root.focus-name; name: root.asset-name; editable: root.editing; renamed(t) => { root.rename-asset(t); } }
                        DescriptionFor { items: root.descriptions; kind: "asset"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        Field {
                            label: @tr("Component");
                            ComboBox {
                                model: root.asset-component-options;
                                current-index: root.asset-component;
                                enabled: root.editing;
                                accessible-label: @tr("Component");
                                selected(v) => { root.set-asset-component(self.current-index); }
                            }
                        }
                        SectionTitle { text: @tr("Security properties"); }
                        CheckList { items: root.asset-properties; editable: root.editing; toggled(i, on) => { root.toggle-asset-property(i, on); } }
                        SectionTitle { text: @tr("Threat scenarios on this asset"); }
                        LinkList { items: root.asset-threats; clicked(i) => { root.asset-threat-clicked(i); } }
                        // Reached through the threats above; link one by adding a threat with +.
                        SectionTitle { text: @tr("{} it can lead to", root.damage-plural); }
                        LinkList { items: root.asset-damages; clicked(i) => { root.asset-damage-clicked(i); } }
                        if root.editing: Button { text: @tr("Add threat scenario"); icon: @image-url("icons/plus.svg"); clicked => { root.add-child-asset(root.asset-selected); } }
                        Text { text: root.asset-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Remove asset"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-asset(); } }
                    }
                }

                // Damage scenarios
                if root.page == Pages.damage: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: root.damage-plural;
                            subtitle: @tr("What could go wrong, rated per impact category.");
                            icon: @image-url("icons/triangle-alert.svg");
                            Button { text: @tr("New ") + root.damage-singular; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.begin-draft("damage"); } if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } } }
                        }
                        DataTable {
                            label: root.damage-plural;
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: root.damage-singular, horizontal-stretch: 2 }, { title: @tr("Impact"), horizontal-stretch: 2 }, { title: @tr("Threats"), horizontal-stretch: 1 }];
                            rows: root.damage-rows;
                            selected: root.damage-selected;
                            editable: root.editing;
                            show-add: true;
                            add-verb: @tr("Add threat scenario leading to");
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.pick-damage(i); }
                            activated(i) => { root.pick-damage(i); root.focus-inspector(); }
                            open-row(i) => { root.pick-damage(i); root.focus-inspector(); }
                            add-child(i) => { root.add-child-damage(i); }
                            duplicate-row(i) => { root.duplicate-damage(i); }
                            remove-row(i) => { root.remove-row-damage(i); }
                        }
                    }
                    if root.draft-kind == "damage": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New ") + root.damage-singular;
                            placeholder: @tr("What happens");
                            hint: @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            commit(t, next) => { root.commit-draft(t, next); }
                            cancel => { root.cancel-draft(); }
                        }
                    }
                    if root.has-damage && root.draft-kind != "damage": Panel {
                        width: root.side-width;
                        SectionTitle { text: root.damage-singular + " · " + root.damage-id; }
                        NameEditor { focus-requested <=> root.focus-name; name: root.damage-name; editable: root.editing; renamed(t) => { root.rename-damage(t); } }
                        DescriptionFor { items: root.descriptions; kind: "damage"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        SectionTitle { text: @tr("Impact rating"); }
                        for f[fi] in root.damage-impacts: Field {
                            label: f.label;
                            Choice { options: f.options; index: f.selected; editable: root.editing; label: f.label; picked(i) => { root.set-impact(fi, i); } }
                        }
                        SectionTitle { text: @tr("Threat scenarios leading here"); }
                        LinkList { items: root.damage-threats; clicked(i) => { root.damage-threat-clicked(i); } }
                        SectionTitle { text: @tr("Assets at stake"); }
                        LinkList { items: root.damage-assets; clicked(i) => { root.damage-asset-clicked(i); } }
                        if root.editing: Button { text: @tr("Add threat scenario"); icon: @image-url("icons/plus.svg"); clicked => { root.add-child-damage(root.damage-selected); } }
                        Text { text: root.damage-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Remove damage scenario"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-damage(); } }
                    }
                }

                // Threat scenarios
                if root.page == Pages.threats: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: @tr("Threat scenarios");
                            subtitle: @tr("How an attacker could harm an asset.");
                            icon: @image-url("icons/swords.svg");
                            Button { text: @tr("New threat scenario"); icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.begin-draft("threat"); } if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } } }
                        }
                        DataTable {
                            label: @tr("Threat scenarios");
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Threat scenario"), horizontal-stretch: 3 }, { title: @tr("Asset"), horizontal-stretch: 2 }, { title: @tr("Before"), horizontal-stretch: 1 }, { title: @tr("After"), horizontal-stretch: 1 }];
                            rows: root.threat-rows;
                            selected: root.threat-selected;
                            editable: root.editing;
                            show-add: true;
                            add-verb: @tr("Add attack tree for");
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.select-threat(i); }
                            activated(i) => { root.select-threat(i); root.focus-inspector(); }
                            open-row(i) => { root.select-threat(i); root.focus-inspector(); }
                            add-child(i) => { root.add-child-threat(i); }
                            duplicate-row(i) => { root.duplicate-threat(i); }
                            remove-row(i) => { root.remove-row-threat(i); }
                        }
                    }
                    if root.draft-kind == "threat": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New threat scenario");
                            placeholder: @tr("Threat scenario");
                            hint: root.asset-names.length == 0 ? @tr("Add an asset first.") : @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            incomplete: root.draft-incomplete;
                            blur-creates: false;
                            commit(t, next) => {
                                if (root.draft-incomplete && t != "") {
                                    if (root.draft-asset < 0) { draft-asset-choice.focus-box(); } else { draft-category-choice.focus-box(); }
                                } else {
                                    root.commit-draft(t, next);
                                }
                            }
                            cancel => { root.cancel-draft(); }
                            Field {
                                label: @tr("Asset");
                                draft-asset-choice := Choice { options: root.asset-names; index: root.draft-asset; label: @tr("Asset"); picked(i) => { root.set-draft-asset(i); } }
                            }
                            Field {
                                label: @tr("Category");
                                draft-category-choice := Choice { options: root.threat-categories; index: root.draft-category; label: @tr("Category"); picked(i) => { root.set-draft-category(i); } }
                            }
                        }
                    }
                    if root.has-threat-detail && root.draft-kind != "threat": ScrollView {
                        width: root.side-width + 30px;
                        Panel {
                            width: root.side-width + 12px;
                            SectionTitle { text: @tr("Threat scenario") + " · " + root.td-id; }
                            NameEditor { focus-requested <=> root.focus-name; name: root.td-name; editable: root.editing; renamed(t) => { root.rename-threat(t); } }
                            DescriptionFor { items: root.descriptions; kind: "threat"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                            Field {
                                label: @tr("Asset");
                                LinkList { items: [{ label: root.td-asset }]; clicked(i) => { root.threat-asset-clicked(); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Swatch { tone: root.td-inherent-tone; y: 4px; }
                                Text { text: @tr("Before controls: ") + (root.td-inherent == "" ? "not rated" : root.td-inherent); color: Theme.ink; font-size: Theme.font-body; }
                                Swatch { tone: root.td-residual-tone; y: 4px; }
                                Text { text: @tr("After: ") + (root.td-residual == "" ? "not rated" : root.td-residual); color: Theme.ink; font-size: Theme.font-body; }
                            }
                            for line in root.td-why: Text { text: line; color: Theme.graphite; font-size: Theme.font-label; wrap: word-wrap; }
                            Field {
                                label: @tr("Category");
                                Choice { options: root.threat-categories; index: root.td-category; editable: root.editing; label: @tr("Category"); picked(i) => { root.set-threat-category(i); } }
                            }
                            SectionTitle { text: @tr("Damage scenarios it leads to"); }
                            CheckList { items: root.td-damages; editable: root.editing; empty-text: @tr("Add a damage scenario first."); toggled(i, on) => { root.toggle-threat-damage(i, on); } }
                            SectionTitle { text: @tr("Catalog references"); }
                            for r[ri] in root.td-refs: HorizontalLayout {
                                spacing: 6px;
                                Text { text: r; color: Theme.ink; font-size: Theme.font-body; vertical-alignment: center; horizontal-stretch: 1; }
                                Button { text: @tr("Remove"); enabled: root.editing; clicked => { root.remove-catalog-ref(ri); } }
                            }
                            if root.editing: Choice { options: root.catalog-schemes; index: root.new-ref-scheme; label: @tr("Catalog"); picked(i) => { root.new-ref-scheme = i; } }
                            if root.editing: HorizontalLayout {
                                spacing: 6px;
                                LineEdit { horizontal-stretch: 1; placeholder-text: @tr("4.1"); text <=> root.new-ref-text; accessible-label: @tr("Reference"); }
                                Button { text: @tr("Add"); enabled: root.new-ref-text != ""; clicked => { root.add-catalog-ref(root.new-ref-scheme, root.new-ref-text); root.new-ref-text = ""; } }
                            }
                            Field {
                                label: @tr("Attack tree");
                                HorizontalLayout {
                                    spacing: 6px;
                                    Choice { horizontal-stretch: 1; options: root.tree-names; index: root.td-tree; editable: root.editing; label: @tr("Attack tree"); picked(i) => { root.set-threat-tree(i); } }
                                    if root.td-tree > 0: Button { text: @tr("Open"); icon: @image-url("icons/network.svg"); clicked => { root.open-threat-tree(); } }
                                    if root.td-tree == 0: Button { text: @tr("New tree"); icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.new-tree-for-threat(); } }
                                }
                            }
                            Field {
                                label: @tr("Direct feasibility rating (concept phase; an attack tree overrides it)");
                                Choice { options: root.feasibility-options; index: root.td-feasibility; editable: root.editing; label: @tr("Direct feasibility"); picked(i) => { root.set-threat-feasibility(i); } }
                            }
                            if root.td-feasibility-text != "": Text { text: @tr("Feasibility the engine uses: ") + root.td-feasibility-text; color: Theme.graphite; font-size: Theme.font-label; }
                            Text { text: root.td-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                            Button { text: @tr("Remove threat scenario"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-threat(); } }
                        }
                    }
                }

                // Attack trees
                if root.page == Pages.trees: HorizontalLayout {
                    VerticalLayout {
                        width: root.tree-list-width;
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 6px;
                            SectionTitle { text: @tr("Attack trees"); vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: @tr("New"); icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.begin-draft("tree"); } if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } } }
                        }
                        DataTable {
                            label: @tr("Attack trees");
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Tree"), horizontal-stretch: 1 }, { title: @tr("Rating"), width: 92px, min-width: 92px }];
                            rows: root.tree-rows;
                            selected: root.tree-selected;
                            editable: root.editing;
                            show-open: true;
                            show-duplicate: false;
                            show-remove: true;
                            picked(i) => { root.pick-tree(i); }
                            activated(i) => { root.pick-tree(i); }
                            open-row(i) => { root.pick-tree(i); }
                            remove-row(i) => { root.remove-row-tree(i); }
                        }
                        if root.draft-kind == "tree": DraftForm {
                            title: @tr("New attack tree");
                            placeholder: @tr("The attacker's goal (the root)");
                            hint: @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            commit(t, next) => { root.commit-draft(t, next); }
                            cancel => { root.cancel-draft(); }
                        }
                        if root.has-tree && root.draft-kind != "tree": HorizontalLayout {
                            spacing: 6px;
                            Button { text: @tr("Edit outline"); icon: @image-url("icons/pencil.svg"); enabled: root.editing; clicked => { root.outline-draft = root.outline-text; root.outline-open = true; } }
                            Button { text: @tr("Delete"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-tree(); } }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { horizontal-stretch: 1; text: @tr("Library"); icon: @image-url("icons/box.svg"); accessible-description: @tr("Search the attack tree library and copy an item into the project"); clicked => { root.library-opened(); root.library-open = true; } }
                            if root.has-tree: Button { horizontal-stretch: 1; text: @tr("Suggest steps"); icon: @image-url("icons/workflow.svg"); enabled: root.editing; accessible-description: @tr("Synthesize ghost attack-tree steps with Aegis-Core Gear 1"); clicked => { root.suggest-tree-nodes(); } }
                        }
                        if root.has-tree: Button { text: @tr("Export SVG"); icon: @image-url("icons/image.svg"); clicked => { root.export-svg(); } }
                        DescriptionFor { items: root.descriptions; kind: "tree"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        // Legend.
                        VerticalLayout {
                            spacing: 4px;
                            SectionTitle { text: @tr("Attack feasibility"); }
                            for entry[i] in ["High", "Medium", "Low", "Very low"]: HorizontalLayout {
                                spacing: 8px;
                                Swatch { tone: 4 - i; y: 2px; }
                                Text { text: entry; font-size: Theme.font-label; font-weight: Theme.weight-medium; color: Theme.graphite; }
                            }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.rule; }
                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            Rectangle {
                                height: 30px;
                                background: Theme.panel;
                                Text { x: 12px; text: root.tree-title; color: Theme.ink; font-size: Theme.font-body; font-weight: Theme.weight-semibold; vertical-alignment: center; overflow: elide; width: parent.width - 24px; }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                Canvas {
                                    items: root.draw;
                                    path-items: root.draw-paths;
                                    rect-items: root.draw-rects;
                                    text-items: root.draw-texts;
                                    access-nodes: root.access-nodes;
                                    node-activated(n) => { root.canvas-node-activated(n); }
                                    accessible-summary: root.canvas-summary;
                                    pointer-down(x, y) => { root.canvas-down(x, y); }
                                    pointer-move(x, y) => { root.canvas-move(x, y); }
                                    pointer-up(x, y) => { root.canvas-up(x, y); }
                                    scrolled(x, y, d) => { root.canvas-scroll(x, y, d); }
                                    key(text, shift) => { return root.canvas-key(text, shift); }
                                    resized(w, h) => {
                                        root.canvas-x = self.absolute-position.x;
                                        root.canvas-y = self.absolute-position.y;
                                        root.canvas-resized(w, h);
                                    }
                                }
                                if !root.has-tree: Text {
                                    text: root.tree-rows.length == 0
                                        ? "This project has no attack trees yet. Create one with New, or from a threat scenario."
                                        : "Choose an attack tree on the left.";
                                    color: Theme.graphite;
                                    font-size: Theme.font-body + 1px;
                                    font-weight: Theme.weight-medium;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    x: 12px;
                                    y: parent.height - 44px;
                                    width: 170px;
                                    height: 32px;
                                    spacing: 6px;
                                    Button { text: @tr("Fit"); icon: @image-url("icons/maximize.svg"); clicked => { root.fit(); } }
                                    Button { text: root.zoom-text; clicked => { root.zoom-reset(); } }
                                }
                            }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.rule; }
                    // Inspector
                    Rectangle {
                        width: root.inspector-width;
                        background: Theme.panel;
                        if !root.has-inspector && root.suggestion-rows.length == 0: Text {
                            text: @tr("Select a node on the canvas to inspect its feasibility or expand the attack tree.");
                            color: Theme.graphite;
                            wrap: word-wrap;
                            font-size: Theme.font-body;
                            font-weight: Theme.weight-medium;
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                        }
                        if root.has-inspector || root.suggestion-rows.length > 0: ScrollView {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                if root.suggestion-rows.length > 0: VerticalLayout {
                                    spacing: 8px;
                                    SectionTitle { text: @tr("AI suggestions (Gear 1)"); }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: @tr("Accept all");
                                            icon: @image-url("icons/badge-check.svg");
                                            primary: true;
                                            enabled: root.editing;
                                            clicked => { root.accept-all-suggestions(); }
                                        }
                                        Button {
                                            horizontal-stretch: 1;
                                            text: @tr("Dismiss all");
                                            icon: @image-url("icons/x.svg");
                                            clicked => { root.reject-all-suggestions(); }
                                        }
                                    }
                                    for s[si] in root.suggestion-rows: Rectangle {
                                        background: s.selected ? Theme.wash : Theme.sheet;
                                        border-width: 1px;
                                        border-color: s.selected ? Theme.accent : Theme.rule;
                                        border-radius: Theme.radius-control;
                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 4px;
                                            Text {
                                                text: s.label;
                                                color: Theme.ink;
                                                font-size: Theme.font-body;
                                                font-weight: Theme.weight-semibold;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: s.kind + " · " + s.detail;
                                                color: Theme.graphite;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                Button {
                                                    horizontal-stretch: 1;
                                                    text: @tr("Accept");
                                                    enabled: root.editing;
                                                    clicked => { root.accept-suggestion(si); }
                                                }
                                                Button {
                                                    horizontal-stretch: 1;
                                                    text: @tr("Dismiss");
                                                    clicked => { root.reject-suggestion(si); }
                                                }
                                            }
                                        }
                                    }
                                    if root.has-inspector: Rectangle { height: 1px; background: Theme.rule; }
                                }
                                if root.has-inspector: VerticalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.inspector-title;
                                        font-size: Theme.font-h1;
                                        font-weight: Theme.weight-heavy;
                                        letter-spacing: Theme.tracking-tight;
                                        color: Theme.ink;
                                        wrap: word-wrap;
                                    }
                                Text { text: root.inspector-tree-id + " · " + root.inspector-kind; color: Theme.graphite; font-size: Theme.font-label; font-weight: Theme.weight-semibold; }
                                if root.editing: NameEditor {
                                    name: root.inspector-title;
                                    editable: root.editing;
                                    renamed(t) => { root.rename-tree-node(t); }
                                }
                                if !root.inspector-is-step: Field {
                                    label: @tr("Gate logic");
                                    Choice {
                                        options: ["OR — any child suffices", "AND — all children needed", "SEQ — children in order"];
                                        index: root.inspector-gate-index;
                                        editable: root.editing;
                                        label: @tr("Gate logic");
                                        picked(i) => { root.set-tree-node-gate(i); }
                                    }
                                }
                                if root.inspector-needs-review: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: @tr("This rating was copied from the library and has not been reviewed."); color: Theme.ink; font-size: Theme.font-label; wrap: word-wrap; horizontal-stretch: 1; }
                                    Button { text: @tr("Reviewed"); enabled: root.editing; accessible-description: @tr("Confirm this rating after checking it"); clicked => { root.mark-reviewed(); } }
                                }
                                if root.evaluated-text != "": HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle { width: 16px; height: 16px; y: 6px; background: Theme.tone(root.evaluated-tone); }
                                    Text {
                                        text: root.evaluated-text + " attack feasibility";
                                        font-size: Theme.font-h2;
                                        font-weight: Theme.weight-bold;
                                        color: Theme.ink;
                                    }
                                }
                                if root.why-lines.length > 0: VerticalLayout {
                                    spacing: 4px;
                                    SectionTitle { text: @tr("Why?"); }
                                    for line in root.why-lines: Text {
                                        text: line;
                                        wrap: word-wrap;
                                        color: Theme.ink;
                                        font-size: Theme.font-body;
                                    }
                                }
                                // ---- Interactive Tree Expansion (End of Node & Intermediate Points) ----
                                if root.editing: VerticalLayout {
                                    spacing: 6px;
                                    Rectangle { height: 1px; background: Theme.rule; }
                                    SectionTitle { text: root.inspector-is-step ? "Expand step or insert gate" : "Expand gate or restructure"; }
                                    LineEdit {
                                        text <=> root.new-node-label;
                                        placeholder-text: root.inspector-is-step ? "New child or gate label" : "New child or gate label";
                                        accessible-label: @tr("New node label");
                                        accepted(t) => {
                                            root.add-tree-child(root.new-node-kind, t);
                                            root.new-node-label = "";
                                        }
                                    }
                                    Choice {
                                        options: ["Attack step (leaf)", "OR gate", "AND gate", "SEQ gate"];
                                        index: root.new-node-kind;
                                        label: @tr("New node kind");
                                        picked(i) => { root.new-node-kind = i; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: root.inspector-is-step ? "Branch with child" : "Add child";
                                            icon: @image-url("icons/plus.svg");
                                            primary: true;
                                            clicked => {
                                                root.add-tree-child(root.new-node-kind, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                        if !root.inspector-is-root: Button {
                                            horizontal-stretch: 1;
                                            text: @tr("Add sibling");
                                            icon: @image-url("icons/plus.svg");
                                            clicked => {
                                                root.add-sibling-node(root.new-node-kind, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Text { text: @tr("Insert gate above:"); font-size: Theme.font-caption; font-weight: Theme.weight-semibold; color: Theme.graphite; vertical-alignment: center; horizontal-stretch: 1; }
                                        Button {
                                            text: @tr("OR");
                                            clicked => {
                                                root.insert-parent-gate(0, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                        Button {
                                            text: @tr("AND");
                                            clicked => {
                                                root.insert-parent-gate(1, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                        Button {
                                            text: @tr("SEQ");
                                            clicked => {
                                                root.insert-parent-gate(2, root.new-node-label);
                                                root.new-node-label = "";
                                            }
                                        }
                                    }
                                    if !root.inspector-is-root: HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: @tr("Move up");
                                            enabled: root.inspector-can-move-up;
                                            clicked => { root.move-tree-node(-1); }
                                        }
                                        Button {
                                            horizontal-stretch: 1;
                                            text: @tr("Move down");
                                            enabled: root.inspector-can-move-down;
                                            clicked => { root.move-tree-node(1); }
                                        }
                                        Button {
                                            text: @tr("Delete");
                                            icon: @image-url("icons/trash-2.svg");
                                            clicked => { root.remove-tree-node(); }
                                        }
                                    }
                                }
                                if root.inspector-is-step: VerticalLayout {
                                    spacing: 8px;
                                    Rectangle { height: 1px; background: Theme.rule; }
                                    SectionTitle { text: root.feasibility-label; }
                                    Choice {
                                        options: root.level-options;
                                        index: root.rating-index;
                                        editable: root.editing;
                                        label: root.feasibility-label;
                                        picked(i) => { root.set-rating(i); }
                                    }
                                    if root.effective-text != "": Text {
                                        text: @tr("The engine uses: ") + root.effective-text;
                                        color: Theme.graphite;
                                        font-size: Theme.font-label;
                                    }
                                    if root.has-attack-potential: VerticalLayout {
                                        spacing: 8px;
                                        SectionTitle { text: @tr("Attack potential"); }
                                        if root.potential-text != "": Text {
                                            text: root.potential-text + " from the five factors";
                                            font-size: Theme.font-body;
                                            color: Theme.ink;
                                        }
                                        if root.potential-text == "": Text {
                                            text: @tr("Rate all five factors to calculate it. Until then the rating above is used.");
                                            font-size: Theme.font-label;
                                            color: Theme.graphite;
                                            wrap: word-wrap;
                                        }
                                        for f[fi] in root.factors: VerticalLayout {
                                            spacing: 2px;
                                            Text { text: f.label; font-size: Theme.font-label; color: Theme.graphite; }
                                            Choice {
                                                options: f.options;
                                                index: f.selected;
                                                editable: root.editing;
                                                label: f.label;
                                                picked(i) => { root.set-factor(fi, i); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.rule; }
                                    SectionTitle { text: @tr("Security controls on this step"); }
                                    if root.step-residual-text != "": Text { text: @tr("After controls: ") + root.step-residual-text; color: Theme.ink; font-size: Theme.font-body; }
                                    if root.mitigations.length == 0: Text { text: @tr("None."); color: Theme.graphite; font-size: Theme.font-label; }
                                    for mi[mx] in root.mitigations: VerticalLayout {
                                        spacing: 2px;
                                        Text { text: mi.name; color: Theme.ink; font-size: Theme.font-body; wrap: word-wrap; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: @tr("caps at"); color: Theme.graphite; font-size: Theme.font-label; vertical-alignment: center; }
                                            Choice { horizontal-stretch: 1; options: root.feasibility-levels; index: mi.level; editable: root.editing; label: @tr("Cap"); picked(i) => { root.set-mitigation(mx, i); } }
                                            Button { text: @tr("Detach"); enabled: root.editing; clicked => { root.detach-control(mx); } }
                                        }
                                    }
                                    if root.editing && root.attach-names.length > 0: VerticalLayout {
                                        spacing: 4px;
                                        SectionTitle { text: @tr("Attach a control"); }
                                        Choice { options: root.attach-names; index: root.attach-control-index; label: @tr("Control"); picked(i) => { root.attach-control-index = i; } }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: @tr("caps at"); color: Theme.graphite; font-size: Theme.font-label; vertical-alignment: center; }
                                            Choice { horizontal-stretch: 1; options: root.feasibility-levels; index: root.attach-level-index; label: @tr("Cap"); picked(i) => { root.attach-level-index = i; } }
                                            Button { text: @tr("Attach"); icon: @image-url("icons/link.svg"); clicked => { root.attach-control(root.attach-control-index, root.attach-level-index); } }
                                        }
                                    }
                                    if root.editing && root.attach-names.length == 0 && root.mitigations.length == 0: Text { text: @tr("Add controls on the Security controls page to attach them here."); color: Theme.graphite; font-size: Theme.font-label; wrap: word-wrap; }
                                }
                                }
                            }
                        }
                    }
                }

                // Risks and treatment
                if root.page == Pages.risks: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle { title: @tr("Risks and treatment"); subtitle: @tr("Every threat scenario, worst risk first, with the decision on what to do about it."); icon: @image-url("icons/gauge.svg"); }
                        DataTable {
                            label: @tr("Risk register");
                            // The short columns get a minimum width so their titles and values
                            // ("not rated") are never cut; the names take the rest.
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Threat scenario"), horizontal-stretch: 3, min-width: 110px }, { title: @tr("Deciding damage"), horizontal-stretch: 2, min-width: 136px }, { title: @tr("Impact"), horizontal-stretch: 0, min-width: 84px }, { title: @tr("Feasibility"), horizontal-stretch: 0, min-width: 104px }, { title: @tr("Before"), horizontal-stretch: 0, min-width: 80px }, { title: @tr("After"), horizontal-stretch: 0, min-width: 76px }, { title: @tr("Treatment"), horizontal-stretch: 0, min-width: 104px }];
                            rows: root.risk-rows;
                            selected: root.risk-selected;
                            picked(i) => { root.pick-risk(i); }
                        }
                    }
                    if root.has-threat-detail: Panel {
                        width: min(360px, root.side-width);
                        Text { text: root.td-id + " · " + root.td-name; font-size: 16px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                        DescriptionFor { items: root.descriptions; kind: "threat"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        HorizontalLayout {
                            spacing: 8px;
                            Swatch { tone: root.td-inherent-tone; y: 4px; }
                            Text { text: @tr("Before controls: ") + (root.td-inherent == "" ? "not rated" : root.td-inherent); color: Theme.ink; font-size: Theme.font-body; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Swatch { tone: root.td-residual-tone; y: 4px; }
                            Text { text: @tr("After controls: ") + (root.td-residual == "" ? "not rated" : root.td-residual); color: Theme.ink; font-size: Theme.font-body; }
                        }
                        SectionTitle { text: @tr("Why?"); }
                        for line in root.td-why: Text { text: line; color: Theme.ink; font-size: Theme.font-label; wrap: word-wrap; }
                        Field {
                            label: @tr("Treatment decision");
                            Choice { options: root.treatment-options; index: root.td-treatment; editable: root.editing; label: @tr("Treatment"); picked(i) => { root.set-treatment(i); } }
                        }
                        Field {
                            label: @tr("Cybersecurity goal (for Reduce)");
                            Choice { options: root.goal-names; index: root.td-goal; editable: root.editing; label: @tr("Goal"); picked(i) => { root.set-threat-goal(i); } }
                        }
                        Field {
                            label: @tr("Cybersecurity claim (for Retain and Share)");
                            Choice { options: root.claim-names; index: root.td-claim; editable: root.editing; label: @tr("Claim"); picked(i) => { root.set-threat-claim(i); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Open threat scenario"); icon: @image-url("icons/swords.svg"); clicked => { root.show-page(Pages.threats); } }
                    }
                }

                // Security controls
                if root.page == Pages.controls: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: @tr("Security controls");
                            subtitle: @tr("Measures that make attack steps harder. Attach them to steps on the Attack trees page.");
                            icon: @image-url("icons/shield-check.svg");
                            Button { text: @tr("New control"); icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.begin-draft("control"); } if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } } }
                        }
                        DataTable {
                            label: @tr("Security controls");
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Control"), horizontal-stretch: 3 }, { title: @tr("Attack steps"), horizontal-stretch: 1 }, { title: @tr("Goals"), horizontal-stretch: 1 }];
                            rows: root.control-rows;
                            selected: root.control-selected;
                            editable: root.editing;
                            show-add: true;
                            add-verb: @tr("Add goal for");
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.pick-control(i); }
                            activated(i) => { root.pick-control(i); root.focus-inspector(); }
                            open-row(i) => { root.pick-control(i); root.focus-inspector(); }
                            add-child(i) => { root.add-child-control(i); }
                            duplicate-row(i) => { root.duplicate-control(i); }
                            remove-row(i) => { root.remove-row-control(i); }
                        }
                    }
                    if root.draft-kind == "control": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New control");
                            placeholder: @tr("Control name");
                            hint: @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            commit(t, next) => { root.commit-draft(t, next); }
                            cancel => { root.cancel-draft(); }
                        }
                    }
                    if root.has-control && root.draft-kind != "control": Panel {
                        width: root.side-width;
                        SectionTitle { text: @tr("Security control") + " · " + root.control-id; }
                        NameEditor { focus-requested <=> root.focus-name; name: root.control-name; editable: root.editing; renamed(t) => { root.rename-control(t); } }
                        DescriptionFor { items: root.descriptions; kind: "control"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        SectionTitle { text: @tr("Attached to"); }
                        LinkList { items: root.control-steps; empty-text: @tr("No attack step yet."); clicked(i) => { root.control-step-clicked(i); } }
                        SectionTitle { text: @tr("Part of goals"); }
                        LinkList { items: root.control-goals; clicked(i) => { root.control-goal-clicked(i); } }
                        Text { text: root.control-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Remove control"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-control(); } }
                    }
                }

                // Goals and claims
                if root.page == Pages.goals: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: @tr("Goals and claims");
                            subtitle: @tr("Goals back a Reduce decision with controls; claims back Retain and Share.");
                            icon: @image-url("icons/target.svg");
                            Button { text: @tr("New ") + root.goal-singular; icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.begin-draft("goal"); } if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } } }
                            Button { text: @tr("New claim"); icon: @image-url("icons/plus.svg"); enabled: root.editing; clicked => { root.begin-draft("claim"); } if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } } }
                        }
                        SectionTitle { text: root.goal-plural; }
                        DataTable {
                            label: root.goal-plural;
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: root.goal-singular, horizontal-stretch: 3 }, { title: @tr("Controls"), horizontal-stretch: 1 }, { title: @tr("Threats"), horizontal-stretch: 1 }];
                            rows: root.goal-rows;
                            selected: root.goal-selected;
                            editable: root.editing;
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.pick-goal(i); }
                            activated(i) => { root.pick-goal(i); root.focus-inspector(); }
                            open-row(i) => { root.pick-goal(i); root.focus-inspector(); }
                            duplicate-row(i) => { root.duplicate-goal(i); }
                            remove-row(i) => { root.remove-row-goal(i); }
                        }
                        SectionTitle { text: @tr("Cybersecurity claims"); }
                        DataTable {
                            label: @tr("Cybersecurity claims");
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Claim"), horizontal-stretch: 3 }, { title: @tr("Threats"), horizontal-stretch: 1 }];
                            rows: root.claim-rows;
                            selected: root.claim-selected;
                            editable: root.editing;
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.pick-claim(i); }
                            activated(i) => { root.pick-claim(i); root.focus-inspector(); }
                            open-row(i) => { root.pick-claim(i); root.focus-inspector(); }
                            duplicate-row(i) => { root.duplicate-claim(i); }
                            remove-row(i) => { root.remove-row-claim(i); }
                        }
                    }
                    VerticalLayout {
                        width: root.side-width;
                        spacing: 12px;
                        if root.draft-kind == "goal": Panel {
                            DraftForm {
                                title: @tr("New ") + root.goal-singular;
                                placeholder: root.goal-singular;
                                hint: @tr("Press Enter to create, Escape to cancel.");
                                seq: root.draft-seq;
                            error: root.draft-error;
                                commit(t, next) => { root.commit-draft(t, next); }
                                cancel => { root.cancel-draft(); }
                            }
                        }
                        if root.draft-kind == "claim": Panel {
                            DraftForm {
                                title: @tr("New claim");
                                placeholder: @tr("Claim");
                                hint: @tr("Press Enter to create, Escape to cancel.");
                                seq: root.draft-seq;
                            error: root.draft-error;
                                commit(t, next) => { root.commit-draft(t, next); }
                                cancel => { root.cancel-draft(); }
                            }
                        }
                        if root.has-goal && root.draft-kind == "": Panel {
                            SectionTitle { text: root.goal-singular + " · " + root.goal-id; }
                            NameEditor { focus-requested <=> root.focus-name; name: root.goal-name; editable: root.editing; renamed(t) => { root.rename-goal(t); } }
                            DescriptionFor { items: root.descriptions; kind: "goal"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                            SectionTitle { text: @tr("Controls that realize it"); }
                            CheckList { items: root.goal-controls; editable: root.editing; empty-text: @tr("Add security controls first."); toggled(i, on) => { root.toggle-goal-control(i, on); } }
                            SectionTitle { text: @tr("Threat scenarios"); }
                            LinkList { items: root.goal-threats; clicked(i) => { root.goal-threat-clicked(i); } }
                            Button { text: @tr("Remove goal"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-goal(); } }
                        }
                        if root.has-claim && root.draft-kind == "": Panel {
                            SectionTitle { text: @tr("Cybersecurity claim") + " · " + root.claim-id; }
                            NameEditor { focus-requested <=> root.focus-name; name: root.claim-name; editable: root.editing; renamed(t) => { root.rename-claim(t); } }
                            DescriptionFor { items: root.descriptions; kind: "claim"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                            SectionTitle { text: @tr("Threat scenarios"); }
                            LinkList { items: root.claim-threats; clicked(i) => { root.claim-threat-clicked(i); } }
                            Button { text: @tr("Remove claim"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-claim(); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Problems
                if root.page == Pages.problems: VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    PageTitle { title: @tr("Problems"); subtitle: @tr("Completeness and consistency checks. Blocking problems stop a risk from being computed or a treatment from being complete."); icon: @image-url("icons/circle-alert.svg"); }
                    if root.problems.length == 0: Text { text: @tr("No problems. The analysis is complete and consistent."); color: Theme.ink; font-size: Theme.font-body + 1px; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for p[pi] in root.problems: Rectangle {
                                min-height: 36px;
                                background: problem-area.has-hover ? Theme.wash : Theme.panel;
                                border-width: 1px;
                                border-color: Theme.rule;
                                accessible-role: button;
                                accessible-label: p.text;
                                accessible-action-default => { root.problem-clicked(pi); }
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 10px;
                                    Image { source: @image-url("icons/circle-alert.svg"); width: 16px; height: 16px; colorize: p.error ? Theme.high : Theme.medium; }
                                    Text { text: p.error ? "Blocking" : "Warning"; width: 70px; color: p.error ? Theme.high : Theme.medium; font-size: Theme.font-label; font-weight: 600; }
                                    Text { text: p.text; color: Theme.ink; font-size: Theme.font-body; wrap: word-wrap; horizontal-stretch: 1; }
                                    Text { text: @tr("Go to"); color: Theme.accent; font-size: Theme.font-label; }
                                }
                                problem-area := TouchArea { clicked => { root.problem-clicked(pi); } }
                            }
                        }
                    }
                }

                // Versions
                if root.page == Pages.versions: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 2;
                        spacing: 10px;
                        PageTitle {
                            title: @tr("Versions");
                            subtitle: @tr("Baselines freeze the saved state under a name. Compare the current state with one to see what changed and which risks moved.");
                            icon: @image-url("icons/git-compare.svg");
                            Button { text: @tr("Create baseline"); icon: @image-url("icons/flag.svg"); clicked => { root.ask("create-baseline", "Create baseline", "Baseline name, for example B1 Design freeze", ""); } }
                        }
                        DataTable {
                            label: @tr("Baselines");
                            columns: [{ title: @tr("Baseline"), horizontal-stretch: 2 }, { title: @tr("Change"), horizontal-stretch: 1 }, { title: @tr("By"), horizontal-stretch: 1 }, { title: @tr("Created"), horizontal-stretch: 2 }];
                            rows: root.baseline-rows;
                            selected: root.baseline-selected;
                            picked(i) => { root.pick-baseline(i); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: @tr("Compare with the current state"); icon: @image-url("icons/git-compare.svg"); enabled: root.baseline-selected >= 0; clicked => { root.compare-baseline(); } }
                            if root.comparing: Button { text: @tr("Stop comparing"); icon: @image-url("icons/x.svg"); clicked => { root.stop-compare(); } }
                        }
                    }
                    if root.comparing: Panel {
                        horizontal-stretch: 3;
                        SectionTitle { text: @tr("Comparison"); }
                        Text { text: root.compare-summary; color: Theme.ink; font-size: Theme.font-body + 1px; wrap: word-wrap; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                for d in root.diff-lines: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: d.kind; width: 70px; font-size: Theme.font-label; font-weight: 600; color: d.kind == "Removed" ? Theme.high : (d.kind == "Risk" ? Theme.accent : Theme.ink); }
                                    Text { text: d.text; font-size: Theme.font-body; color: Theme.ink; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }

                // History
                if root.page == Pages.history: VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    PageTitle {
                        title: @tr("History");
                        subtitle: @tr("The latest accepted changes on the server, newest first. Every change is in the hash-chained audit log.");
                        icon: @image-url("icons/history.svg");
                        Button { text: @tr("Refresh"); icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-history(); } }
                    }
                    DataTable {
                        label: @tr("History");
                        columns: [{ title: @tr("Change"), horizontal-stretch: 1 }, { title: @tr("Who"), horizontal-stretch: 2 }, { title: @tr("When"), horizontal-stretch: 2 }, { title: @tr("What"), horizontal-stretch: 3 }];
                        rows: root.history-rows;
                    }
                }

                // Reports
                if root.page == Pages.reports: ScrollView {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        PageTitle { title: @tr("Reports"); subtitle: @tr("Exports carry your name and the time, and the server records each one."); icon: @image-url("icons/file-chart-column.svg"); }
                        Panel {
                            Field {
                                label: @tr("Save files in this folder");
                                LineEdit { text <=> root.export-dir; accessible-label: @tr("Export folder"); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button { text: @tr("TARA report (PDF)"); icon: @image-url("icons/file-down.svg"); primary: true; clicked => { root.export-pdf(); } }
                                Button { text: @tr("TARA report (HTML)"); icon: @image-url("icons/file-text.svg"); clicked => { root.export-report(); } }
                                Button { text: @tr("TARA workbook (XLSX)"); icon: @image-url("icons/sheet.svg"); clicked => { root.export-xlsx(); } }
                                Button { text: @tr("Risk register (CSV)"); icon: @image-url("icons/sheet.svg"); clicked => { root.export-csv(); } }
                                Button { text: @tr("Attack tree on the canvas (SVG)"); icon: @image-url("icons/image.svg"); enabled: root.has-tree; clicked => { root.export-svg(); } }
                            }
                            if root.last-export != "": Text { text: @tr("Last saved: ") + root.last-export; color: Theme.graphite; font-size: Theme.font-label; wrap: word-wrap; }
                        }
                        Panel {
                            SectionTitle { text: @tr("Figures"); }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit { horizontal-stretch: 2; placeholder-text: @tr("Image file path (PNG, JPEG, or SVG)"); text <=> root.new-figure-path; accessible-label: @tr("Figure file path"); enabled: root.editing; }
                                LineEdit { horizontal-stretch: 2; placeholder-text: @tr("Caption"); text <=> root.new-figure-caption; accessible-label: @tr("Figure caption"); enabled: root.editing; }
                                Button {
                                    text: @tr("Add figure");
                                    icon: @image-url("icons/plus.svg");
                                    enabled: root.editing && root.new-figure-path != "";
                                    clicked => { root.add-figure(root.new-figure-path, root.new-figure-caption); root.new-figure-path = ""; root.new-figure-caption = ""; }
                                }
                                Button {
                                    text: @tr("Delete");
                                    icon: @image-url("icons/trash-2.svg");
                                    enabled: root.editing && root.figure-selected >= 0;
                                    clicked => { root.delete-figure(); }
                                }
                            }
                            if root.figure-rows.length > 0: DataTable {
                                label: @tr("Figures");
                                columns: [{ title: @tr("Caption"), horizontal-stretch: 3 }, { title: @tr("Target"), horizontal-stretch: 2 }, { title: @tr("Format"), horizontal-stretch: 1 }];
                                rows: root.figure-rows;
                                selected: root.figure-selected;
                                picked(i) => { root.pick-figure(i); }
                            }
                        }
                        Panel {
                            SectionTitle { text: @tr("Excel import"); }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit { horizontal-stretch: 1; placeholder-text: @tr("Workbook path (.xlsx)"); text <=> root.excel-path; accessible-label: @tr("Workbook path"); enabled: root.editing; }
                                Button {
                                    text: @tr("Preview import");
                                    icon: @image-url("icons/file-text.svg");
                                    enabled: root.editing && root.excel-path != "";
                                    clicked => { root.preview-excel-import(root.excel-path); }
                                }
                                Button {
                                    text: @tr("Apply import");
                                    icon: @image-url("icons/plus.svg");
                                    primary: root.has-excel-preview;
                                    enabled: root.editing && root.has-excel-preview;
                                    clicked => { root.apply-excel-import(); }
                                }
                                Button {
                                    text: @tr("Clear");
                                    enabled: root.has-excel-preview;
                                    clicked => { root.clear-excel-preview(); }
                                }
                            }
                            if root.excel-summary != "": Text { text: root.excel-summary; color: Theme.ink; font-size: Theme.font-body; wrap: word-wrap; }
                            if root.excel-unmapped-rows.length > 0: DataTable {
                                label: @tr("Unmapped rows");
                                columns: [{ title: @tr("Row"), width: 70px, min-width: 70px }, { title: @tr("Reason"), horizontal-stretch: 3 }];
                                rows: root.excel-unmapped-rows;
                            }
                        }
                        Text {
                            text: @tr("The TARA report has an executive summary and the full work product: assets, damage scenarios, threat scenarios, attack trees as diagrams, the risk register with treatment, controls, goals and claims, and the open problems. The PDF has the watermark and page numbers on every page. The HTML version opens in a browser, where you can also print it.");
                            color: Theme.graphite;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Item definition (job 074)
                if root.page == Pages.item: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle {
                            title: @tr("Item definition");
                            subtitle: @tr("Components, interfaces, data flows, and trust boundaries of the item.");
                            icon: @image-url("icons/network.svg");
                            Button {
                                text: root.item-tab == 0 ? @tr("New component") : root.item-tab == 1 ? @tr("New interface") : root.item-tab == 2 ? @tr("New data flow") : @tr("New trust boundary");
                                icon: @image-url("icons/plus.svg");
                                enabled: root.editing;
                                if !root.editing: Tooltip { Text { text: root.new-reason; color: #FFFFFF; font-size: Theme.font-label; } }
                                clicked => { root.begin-draft(root.item-tab == 0 ? "component" : root.item-tab == 1 ? "interface" : root.item-tab == 2 ? "data-flow" : "trust-boundary"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            max-height: 40px;
                            Button { text: @tr("Components"); primary: root.item-tab == 0; clicked => { root.item-tab = 0; } }
                            Button { text: @tr("Interfaces"); primary: root.item-tab == 1; clicked => { root.item-tab = 1; } }
                            Button { text: @tr("Data flows"); primary: root.item-tab == 2; clicked => { root.item-tab = 2; } }
                            Button { text: @tr("Trust boundaries"); primary: root.item-tab == 3; clicked => { root.item-tab = 3; } }
                        }
                        if root.item-tab == 0: DataTable {
                            label: @tr("Components");
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Component"), horizontal-stretch: 2 }, { title: @tr("Parent"), horizontal-stretch: 2 }, { title: @tr("Interfaces"), horizontal-stretch: 1 }, { title: @tr("Assets"), horizontal-stretch: 1 }];
                            rows: root.component-rows;
                            selected: root.component-selected;
                            editable: root.editing;
                            show-add: true;
                            add-verb: @tr("Add asset to");
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.pick-component(i); }
                            activated(i) => { root.pick-component(i); root.focus-inspector(); }
                            open-row(i) => { root.pick-component(i); root.focus-inspector(); }
                            add-child(i) => { root.add-child-component(i); }
                            duplicate-row(i) => { root.duplicate-component(i); }
                            remove-row(i) => { root.remove-row-component(i); }
                        }
                        if root.item-tab == 1: VerticalLayout {
                            spacing: 8px;
                            DataTable {
                                label: @tr("Interfaces");
                                columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Interface"), horizontal-stretch: 2 }, { title: @tr("Component"), horizontal-stretch: 2 }, { title: @tr("Kind"), horizontal-stretch: 2 }, { title: @tr("Data flows"), horizontal-stretch: 1 }];
                                rows: root.interface-rows;
                                selected: root.interface-selected;
                                editable: root.editing;
                                show-open: true;
                                show-duplicate: true;
                                show-remove: true;
                                picked(i) => { root.pick-interface(i); }
                                activated(i) => { root.pick-interface(i); root.focus-inspector(); }
                                open-row(i) => { root.pick-interface(i); root.focus-inspector(); }
                                duplicate-row(i) => { root.duplicate-interface(i); }
                                remove-row(i) => { root.remove-row-interface(i); }
                            }
                        }
                        if root.item-tab == 2: VerticalLayout {
                            spacing: 8px;
                            DataTable {
                                label: @tr("Data flows");
                                columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Data flow"), horizontal-stretch: 2 }, { title: @tr("From"), horizontal-stretch: 1 }, { title: @tr("To"), horizontal-stretch: 1 }, { title: @tr("Interface"), horizontal-stretch: 1 }];
                                rows: root.data-flow-rows;
                                selected: root.data-flow-selected;
                                editable: root.editing;
                                show-open: true;
                                show-duplicate: true;
                                show-remove: true;
                                picked(i) => { root.pick-data-flow(i); }
                                activated(i) => { root.pick-data-flow(i); root.focus-inspector(); }
                                open-row(i) => { root.pick-data-flow(i); root.focus-inspector(); }
                                duplicate-row(i) => { root.duplicate-data-flow(i); }
                                remove-row(i) => { root.remove-row-data-flow(i); }
                            }
                        }
                        if root.item-tab == 3: DataTable {
                            label: @tr("Trust boundaries");
                            columns: [{ title: @tr("ID"), width: 76px, min-width: 76px }, { title: @tr("Trust boundary"), horizontal-stretch: 3 }, { title: @tr("Components"), horizontal-stretch: 1 }];
                            rows: root.trust-boundary-rows;
                            selected: root.trust-boundary-selected;
                            editable: root.editing;
                            show-open: true;
                            show-duplicate: true;
                            show-remove: true;
                            picked(i) => { root.pick-trust-boundary(i); }
                            activated(i) => { root.pick-trust-boundary(i); root.focus-inspector(); }
                            open-row(i) => { root.pick-trust-boundary(i); root.focus-inspector(); }
                            duplicate-row(i) => { root.duplicate-trust-boundary(i); }
                            remove-row(i) => { root.remove-row-trust-boundary(i); }
                        }
                    }
                    if root.item-tab == 0 && root.draft-kind == "component": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New component");
                            placeholder: @tr("Component name");
                            hint: @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            commit(t, next) => { root.commit-draft(t, next); }
                            cancel => { root.cancel-draft(); }
                        }
                    }
                    if root.item-tab == 1 && root.draft-kind == "interface": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New interface");
                            placeholder: @tr("Interface name");
                            hint: root.component-names.length == 0 ? @tr("Add a component first.") : @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            incomplete: root.draft-incomplete;
                            blur-creates: false;
                            commit(t, next) => {
                                if (root.draft-incomplete && t != "") {
                                    if (root.draft-component < 0) { draft-if-component.focus-box(); } else { draft-if-kind.focus-box(); }
                                } else {
                                    root.commit-draft(t, next);
                                }
                            }
                            cancel => { root.cancel-draft(); }
                            Field {
                                label: @tr("Component");
                                draft-if-component := Choice { options: root.component-names; index: root.draft-component; label: @tr("Component"); picked(i) => { root.set-draft-component(i); } }
                            }
                            Field {
                                label: @tr("Kind");
                                draft-if-kind := Choice { options: root.interface-kinds; index: root.draft-interface-kind; label: @tr("Kind"); picked(i) => { root.set-draft-interface-kind(i); } }
                            }
                        }
                    }
                    if root.item-tab == 2 && root.draft-kind == "data-flow": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New data flow");
                            placeholder: @tr("Data flow name");
                            hint: root.component-names.length < 2 ? @tr("A data flow needs two components.") : @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            incomplete: root.draft-incomplete;
                            blur-creates: false;
                            commit(t, next) => {
                                if (root.draft-incomplete && t != "") {
                                    if (root.draft-component < 0) { draft-flow-from.focus-box(); } else { draft-flow-to.focus-box(); }
                                } else {
                                    root.commit-draft(t, next);
                                }
                            }
                            cancel => { root.cancel-draft(); }
                            Field {
                                label: @tr("From component");
                                draft-flow-from := Choice { options: root.component-names; index: root.draft-component; label: @tr("From component"); picked(i) => { root.set-draft-component(i); } }
                            }
                            Field {
                                label: @tr("To component");
                                draft-flow-to := Choice { options: root.component-names; index: root.draft-to; label: @tr("To component"); picked(i) => { root.set-draft-to(i); } }
                            }
                        }
                    }
                    if root.item-tab == 3 && root.draft-kind == "trust-boundary": Panel {
                        width: root.side-width;
                        DraftForm {
                            title: @tr("New trust boundary");
                            placeholder: @tr("Trust boundary name");
                            hint: @tr("Press Enter to create, Escape to cancel.");
                            seq: root.draft-seq;
                            error: root.draft-error;
                            commit(t, next) => { root.commit-draft(t, next); }
                            cancel => { root.cancel-draft(); }
                        }
                    }
                    if root.item-tab == 0 && root.has-component && root.draft-kind == "": Panel {
                        width: root.side-width;
                        SectionTitle { text: @tr("Component") + " · " + root.component-id; }
                        NameEditor { focus-requested <=> root.focus-name; name: root.component-name; editable: root.editing; renamed(t) => { root.rename-component(t); } }
                        DescriptionFor { items: root.descriptions; kind: "component"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        Field {
                            label: @tr("Parent");
                            ComboBox {
                                model: root.component-parent-options;
                                current-index: root.component-parent;
                                enabled: root.editing;
                                accessible-label: @tr("Parent");
                                selected(v) => { root.set-component-parent(self.current-index); }
                            }
                        }
                        SectionTitle { text: @tr("Interfaces"); }
                        LinkList { items: root.component-interfaces; clicked(i) => { root.item-tab = 1; } }
                        SectionTitle { text: @tr("Assets"); }
                        LinkList { items: root.component-assets; clicked(i) => { root.show-page(Pages.assets); } }
                        Text { text: root.component-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Remove component"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-component(); } }
                    }
                    if root.item-tab == 1 && root.has-interface && root.draft-kind == "": Panel {
                        width: root.side-width;
                        SectionTitle { text: @tr("Interface") + " · " + root.interface-id; }
                        NameEditor { focus-requested <=> root.focus-name; name: root.interface-name; editable: root.editing; renamed(t) => { root.rename-interface(t); } }
                        DescriptionFor { items: root.descriptions; kind: "interface"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        Field {
                            label: @tr("Kind");
                            ComboBox {
                                model: root.interface-kinds;
                                current-index: root.interface-kind;
                                enabled: root.editing;
                                accessible-label: @tr("Kind");
                                selected(v) => { root.set-interface-kind(self.current-index); }
                            }
                        }
                        Text { text: root.interface-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Remove interface"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-interface(); } }
                    }
                    if root.item-tab == 2 && root.has-data-flow && root.draft-kind == "": Panel {
                        width: root.side-width;
                        SectionTitle { text: @tr("Data flow") + " · " + root.data-flow-id; }
                        NameEditor { focus-requested <=> root.focus-name; name: root.data-flow-name; editable: root.editing; renamed(t) => { root.rename-data-flow(t); } }
                        DescriptionFor { items: root.descriptions; kind: "data-flow"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        Field {
                            label: @tr("Interface");
                            ComboBox {
                                model: root.data-flow-interface-options;
                                current-index: root.data-flow-interface;
                                enabled: root.editing;
                                accessible-label: @tr("Interface");
                                selected(v) => { root.set-data-flow-interface(self.current-index); }
                            }
                        }
                        Text { text: root.data-flow-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Remove data flow"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-data-flow(); } }
                    }
                    if root.item-tab == 3 && root.has-trust-boundary && root.draft-kind == "": Panel {
                        width: root.side-width;
                        SectionTitle { text: @tr("Trust boundary") + " · " + root.trust-boundary-id; }
                        NameEditor { focus-requested <=> root.focus-name; name: root.trust-boundary-name; editable: root.editing; renamed(t) => { root.rename-trust-boundary(t); } }
                        DescriptionFor { items: root.descriptions; kind: "trust-boundary"; editable: root.editing; save-label: root.save-description-label; save-requested(i, t) => { root.set-description(i, t); } translation-requested(i, l, t) => { root.set-description-translation(i, l, t); } translation-removed(i, l) => { root.remove-description-translation(i, l); } }
                        SectionTitle { text: @tr("Components"); }
                        CheckList { items: root.trust-boundary-members; editable: root.editing; toggled(i, on) => { root.toggle-trust-boundary-member(i, on); } }
                        Text { text: root.trust-boundary-changed; color: Theme.graphite; font-size: Theme.font-caption; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                        Button { text: @tr("Remove trust boundary"); icon: @image-url("icons/trash-2.svg"); enabled: root.editing; clicked => { root.remove-trust-boundary(); } }
                    }
                }

                // Administration
                if root.page == Pages.admin: HorizontalLayout {
                    padding: 20px;
                    spacing: 16px;
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 10px;
                        PageTitle { title: @tr("Administration"); subtitle: @tr("Users of this server (password login), and tools for the open project."); icon: @image-url("icons/user-cog.svg"); }
                        HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            max-height: 40px;
                            Button { text: @tr("Users and login"); icon: @image-url("icons/users.svg"); primary: root.admin-tab == 0; clicked => { root.admin-tab = 0; } }
                            Button { text: @tr("Event log"); icon: @image-url("icons/scroll-text.svg"); primary: root.admin-tab == 1; clicked => { root.admin-tab = 1; root.refresh-events(); } }
                            Button { text: @tr("Sessions"); icon: @image-url("icons/shield.svg"); primary: root.admin-tab == 2; clicked => { root.admin-tab = 2; root.refresh-sessions(); } }
                            Button { text: @tr("Access"); icon: @image-url("icons/key-round.svg"); primary: root.admin-tab == 3; clicked => { root.admin-tab = 3; root.refresh-memberships(); } }
                        }
                        if root.admin-tab == 0: VerticalLayout {
                            spacing: 10px;
                            if root.is-password: DataTable {
                                label: @tr("Users");
                                columns: [{ title: @tr("User"), horizontal-stretch: 2 }, { title: @tr("Name"), horizontal-stretch: 2 }, { title: @tr("Admin"), width: 78px, min-width: 78px }, { title: @tr("Status"), width: 80px, min-width: 80px }, { title: @tr("Last login"), horizontal-stretch: 3 }, { title: @tr("Sessions"), width: 98px, min-width: 98px }];
                                rows: root.user-rows;
                                selected: root.user-selected;
                                picked(i) => { root.pick-user(i); }
                            }
                            if !root.is-password: Text { text: @tr("Users come from the company identity provider. Manage them there."); color: Theme.graphite; wrap: word-wrap; }
                            if root.settings-known: Panel {
                                SectionTitle { text: @tr("Login"); }
                                Text {
                                    text: root.password-login-on ? "Password login is on. People can log in with a user name and password as well as with the company account." : "Password login is off. Everyone logs in with the company account.";
                                    color: Theme.ink;
                                    wrap: word-wrap;
                                    font-size: Theme.font-body;
                                }
                                if !root.company-login-available: Text {
                                    text: @tr("This server has no company login, so password login cannot be turned off.");
                                    color: Theme.graphite;
                                    wrap: word-wrap;
                                    font-size: Theme.font-label;
                                }
                                Button {
                                    text: root.password-login-on ? "Turn password login off" : "Turn password login on";
                                    icon: @image-url("icons/lock.svg");
                                    enabled: !root.password-login-on || root.company-login-available;
                                    clicked => {
                                        if (root.password-login-on) {
                                            root.confirm("password-login-off", "Turn password login off? Everyone with a password session is logged out now. Use the company account to log in.");
                                        } else {
                                            root.set-password-login(true);
                                        }
                                    }
                                }
                            }
                            if root.is-password && root.user-selected >= 0: HorizontalLayout {
                                spacing: 6px;
                                Button { text: root.selected-user-admin ? "Remove admin rights" : "Make admin"; icon: @image-url("icons/user-cog.svg"); clicked => { root.toggle-user-admin(); } }
                                Button { text: root.selected-user-disabled ? "Enable" : "Disable"; icon: @image-url("icons/lock.svg"); clicked => { root.toggle-user-disabled(); } }
                                Button { text: @tr("Set password"); icon: @image-url("icons/key-round.svg"); clicked => { root.ask("reset-password", "Set a new password", "New password (at least 10 characters)", ""); root.prompt-secret = true; } }
                                Button { text: @tr("Delete"); icon: @image-url("icons/trash-2.svg"); clicked => { root.confirm("delete-user", "Delete this user? Their sessions end."); } }
                            }
                            if root.is-password: Panel {
                                SectionTitle { text: @tr("Add a user"); }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { horizontal-stretch: 1; placeholder-text: @tr("user name"); text <=> root.new-user-name; accessible-label: @tr("New user name"); }
                                    LineEdit { horizontal-stretch: 2; placeholder-text: @tr("Full name"); text <=> root.new-user-display; accessible-label: @tr("Full name"); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { horizontal-stretch: 1; placeholder-text: @tr("First password (10+ characters)"); input-type: password; text <=> root.new-user-password; accessible-label: @tr("First password"); }
                                    CheckBox { text: @tr("Administrator"); checked <=> root.new-user-admin; }
                                    Button {
                                        text: @tr("Add user");
                                        icon: @image-url("icons/plus.svg");
                                        enabled: root.new-user-name != "" && root.new-user-password != "";
                                        clicked => {
                                            root.create-user(root.new-user-name, root.new-user-display, root.new-user-password, root.new-user-admin);
                                            root.new-user-password = "";
                                        }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                        if root.admin-tab == 1: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                Button { text: @tr("All"); primary: root.event-filter == 0; clicked => { root.set-event-filter(0); } }
                                Button { text: @tr("Logins"); primary: root.event-filter == 1; clicked => { root.set-event-filter(1); } }
                                Button { text: @tr("Exports"); primary: root.event-filter == 2; clicked => { root.set-event-filter(2); } }
                                Button { text: @tr("Admin actions"); primary: root.event-filter == 3; clicked => { root.set-event-filter(3); } }
                                Rectangle { horizontal-stretch: 1; }
                                Button { text: @tr("Refresh"); icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-events(); } }
                            }
                            DataTable {
                                label: @tr("Event log");
                                columns: [{ title: @tr("When"), horizontal-stretch: 4 }, { title: @tr("Who"), horizontal-stretch: 2 }, { title: @tr("What"), horizontal-stretch: 5 }, { title: @tr("About"), horizontal-stretch: 2 }];
                                rows: root.event-rows;
                                selected: -1;
                            }
                            if root.events-text != "": Text { text: root.events-text; color: Theme.graphite; wrap: word-wrap; font-size: Theme.font-body; }
                        }
                        if root.admin-tab == 2: VerticalLayout {
                            spacing: 8px;
                            if !root.is-password: Text { text: @tr("Sessions are managed by the company identity provider."); color: Theme.graphite; wrap: word-wrap; }
                            if root.is-password: HorizontalLayout {
                                spacing: 6px;
                                Text { text: @tr("Open password sessions, newest first. Ending one logs that device out at its next request."); color: Theme.graphite; wrap: word-wrap; font-size: Theme.font-body; horizontal-stretch: 1; }
                                Button { text: @tr("Refresh"); icon: @image-url("icons/refresh-cw.svg"); clicked => { root.refresh-sessions(); } }
                            }
                            if root.is-password: DataTable {
                                label: @tr("Sessions");
                                columns: [{ title: @tr("User"), horizontal-stretch: 2 }, { title: @tr("Device"), horizontal-stretch: 3 }, { title: @tr("Started (UTC)"), horizontal-stretch: 4 }, { title: @tr("Ends (UTC)"), horizontal-stretch: 4 }];
                                rows: root.session-rows;
                                selected: root.session-selected;
                                picked(i) => { root.pick-session(i); }
                            }
                            if root.is-password && root.session-selected >= 0: Button { text: @tr("End this session"); icon: @image-url("icons/log-out.svg"); clicked => { root.confirm("revoke-session", "End this session? That device is logged out at its next request."); } }
                            if root.is-password && root.sessions-text != "": Text { text: root.sessions-text; color: Theme.graphite; wrap: word-wrap; font-size: Theme.font-body; }
                        }
                        if root.admin-tab == 3: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: @tr("user:name or group:name");
                                    text <=> root.new-member;
                                    accessible-label: @tr("Member");
                                    accepted(t) => { root.add-membership(t, root.new-member-role); root.new-member = ""; }
                                }
                                ComboBox {
                                    width: 200px;
                                    model: ["Viewer", "Reviewer", "Analyst", "Project owner", "Methodology owner"];
                                    current-index <=> root.new-member-role;
                                    accessible-label: @tr("Role");
                                }
                                Button {
                                    text: @tr("Add member");
                                    icon: @image-url("icons/plus.svg");
                                    enabled: root.new-member != "";
                                    clicked => { root.add-membership(root.new-member, root.new-member-role); root.new-member = ""; }
                                }
                            }
                            if root.membership-error != "": FieldError { text: root.membership-error; }
                            DataTable {
                                label: @tr("Members");
                                columns: [{ title: @tr("Member"), horizontal-stretch: 2 }, { title: @tr("Role"), horizontal-stretch: 2 }];
                                rows: root.membership-rows;
                                selected: root.membership-selected;
                                picked(i) => { root.pick-membership(i); }
                            }
                            if root.membership-selected >= 0: HorizontalLayout {
                                spacing: 6px;
                                Text { text: @tr("Role"); color: Theme.graphite; }
                                ComboBox {
                                    width: 200px;
                                    model: ["Viewer", "Reviewer", "Analyst", "Project owner", "Methodology owner"];
                                    current-index: root.membership-role;
                                    accessible-label: @tr("Role");
                                    selected(v) => { root.set-membership-role(self.current-index); }
                                }
                                Button {
                                    text: @tr("Remove member");
                                    icon: @image-url("icons/trash-2.svg");
                                    clicked => { root.confirm-named("remove-member", "Remove " + root.selected-member-name + " from '" + root.project-name + "'?", "This cannot be undone from this session.", "Remove"); }
                                }
                            }
                            if root.memberships-text != "": Text { text: root.memberships-text; color: Theme.graphite; wrap: word-wrap; font-size: Theme.font-body; }
                        }
                    }
                    Panel {
                        width: 300px;
                        SectionTitle { text: @tr("This project"); }
                        Button { text: @tr("Check the audit chain"); icon: @image-url("icons/list-checks.svg"); clicked => { root.verify-audit(); } }
                        Button { text: @tr("Break the edit lock"); icon: @image-url("icons/unlink.svg"); enabled: root.band-kind == 1; clicked => { root.confirm("break-lock", "Break the edit lock? The other editor's unsaved changes are lost."); } }
                        Button { text: @tr("Delete project"); icon: @image-url("icons/trash-2.svg"); clicked => { root.confirm("delete-project", "Delete this project, its history and its baselines? This cannot be undone."); } }
                        if root.admin-text != "": Text { text: root.admin-text; color: Theme.ink; font-size: Theme.font-body; wrap: word-wrap; }
                        SectionTitle { text: @tr("License"); }
                        Text { text: root.license-text; color: Theme.ink; font-size: Theme.font-body; wrap: word-wrap; }
                        SectionTitle { text: @tr("Server"); }
                        Text { text: root.engine-text; color: Theme.graphite; font-size: Theme.font-label; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // ---- status bar ----
        Rectangle { height: 1px; background: Theme.rule; }
        Rectangle {
            height: 26px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Image {
                    source: @image-url("brand/AegisTARA_Stencil_Light.svg");
                    width: 15px;
                    height: 15px;
                    y: 5.5px;
                    colorize: Theme.accent;
                }
                Text {
                    text: root.engine-text;
                    color: Theme.graphite;
                    font-size: Theme.font-label;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Image { source: @image-url("icons/circle-user-round.svg"); width: 14px; height: 14px; y: 6px; colorize: Theme.graphite; }
                Text { text: root.user; color: Theme.graphite; font-size: Theme.font-label; vertical-alignment: center; }
                Text { text: root.gpu-renderer ? @tr("GPU renderer") : @tr("CPU renderer"); color: Theme.graphite; font-size: Theme.font-label; vertical-alignment: center; }
            }
        }
    }

    // ===================================================================
    // Notices and toasts: bottom centre of the work area, never over the
    // inspector (UI-10.9). Info toasts go after 8 s, or 8 s after the pointer
    // leaves; warnings and errors stay until dismissed (UI-10.11).
    // ===================================================================
    VerticalLayout {
        property <length> reserved: root.in-project ? root.inspector-width : 0px;
        width: max(200px, min(parent.width - self.reserved - 48px, 440px));
        x: max(24px, (parent.width - self.reserved - self.width) / 2);
        y: parent.height - self.preferred-height - 40px;
        spacing: 6px;
        for n in root.notices: Rectangle {
            background: n.severity == 2 ? (Theme.dark ? #2E1512 : #FDECEA) : (n.severity == 1 ? (Theme.dark ? #2E230E : #FFF4D6) : Theme.panel);
            border-width: 1px;
            border-color: n.severity == 2 ? Theme.high : (n.severity == 1 ? Theme.medium : Theme.rule);
            border-radius: Theme.radius-control;
            height: notice-text.preferred-height + 20px;
            accessible-role: text;
            accessible-label: n.text;
            accessible-live-region: polite;
            toast-hover := TouchArea {}
            Timer {
                interval: 8s;
                running: n.severity == 0 && !toast-hover.has-hover;
                triggered => { root.dismiss-notice(n.id); }
            }
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                notice-text := Text {
                    text: n.text;
                    wrap: word-wrap;
                    color: Theme.ink;
                    font-size: Theme.font-body;
                    horizontal-stretch: 1;
                }
                if n.action != 0: Button {
                    text: n.action == 1 ? @tr("Undo") : @tr("Redo");
                    clicked => {
                        root.dismiss-notice(n.id);
                        if (n.action == 1) { root.undo(); } else { root.redo(); }
                    }
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    accessible-role: button;
                    accessible-label: @tr("Dismiss");
                    accessible-action-default => { root.dismiss-notice(n.id); }
                    Image { source: @image-url("icons/x.svg"); width: 14px; height: 14px; colorize: Theme.ink; }
                    TouchArea { clicked => { root.dismiss-notice(n.id); } }
                }
            }
        }
    }

    // ===================================================================
    // Dialogs.
    // ===================================================================
    if root.prompt-open: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.prompt-open = false; } }
        Rectangle {
            width: min(parent.width - 48px, 480px);
            height: prompt-column.preferred-height + 40px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            TouchArea {}
            prompt-column := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: root.prompt-title; font-size: Theme.font-h1; font-weight: 700; color: Theme.ink; }
                SectionTitle { text: root.prompt-label; }
                prompt-edit := LineEdit {
                    text <=> root.prompt-text;
                    input-type: root.prompt-secret ? password : text;
                    accessible-label: root.prompt-label;
                    accepted(t) => { root.prompt-done(root.prompt-kind, t); }
                    init => { self.focus(); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.prompt-open = false; } }
                    Button { text: @tr("OK"); primary: true; enabled: root.prompt-text != ""; clicked => { root.prompt-done(root.prompt-kind, root.prompt-text); } }
                }
            }
        }
    }

    if root.confirm-open: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.confirm-open = false; } }
        // Escape cancels; focus starts on Cancel, so Enter never confirms (UI-12).
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.confirm-open = false; return accept; }
                reject
            }
            Rectangle {
                width: min(parent.width - 48px, 460px);
                height: confirm-column.preferred-height + 40px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.rule;
                border-radius: Theme.radius-panel;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #00000059;
                TouchArea {}
                confirm-column := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    if root.confirm-title != "": Text { text: root.confirm-title; font-size: Theme.font-h1; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                    if root.confirm-text != "": Text { text: root.confirm-text; font-size: Theme.font-h2; color: Theme.ink; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button {
                            text: @tr("Cancel");
                            clicked => { root.confirm-open = false; }
                            init => { self.focus(); }
                        }
                        DangerButton { text: root.confirm-action; clicked => { root.confirm-done(root.confirm-kind); } }
                    }
                }
            }
        }
    }

    if root.outline-open: Rectangle {
        background: #000000A0;
        Rectangle {
            width: min(parent.width - 48px, 760px);
            height: min(parent.height - 48px, 620px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: @tr("Edit the attack tree"); font-size: Theme.font-h1; font-weight: 700; color: Theme.ink; }
                Text {
                    text: @tr("One node per line; indent a child under its parent. Start a gate with OR, AND or SEQ (sequential AND); a step with - or nothing. Lines with the same text are the same node, which is how a step is shared. Nodes that keep their text keep their ratings and controls.");
                    color: Theme.graphite;
                    font-size: Theme.font-label;
                    wrap: word-wrap;
                }
                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.outline-draft;
                    font-family: root.mono-font-family;
                    font-size: Theme.font-body;
                    wrap: no-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.outline-open = false; } }
                    Button { text: @tr("Apply"); primary: true; clicked => { root.apply-outline(root.outline-draft); root.outline-open = false; } }
                }
            }
        }
    }

    if root.library-open: Rectangle {
        background: #000000A0;
        Rectangle {
            width: min(parent.width - 48px, 980px);
            height: min(parent.height - 48px, 640px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: @tr("Attack tree library"); font-size: Theme.font-h1; font-weight: 700; color: Theme.ink; }
                HorizontalLayout {
                    spacing: 8px;
                    lib-search := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: @tr("Search (English or Japanese)");
                        accessible-label: @tr("Search the library");
                        edited(t) => { root.library-query(t); }
                    }
                    ComboBox {
                        width: 260px;
                        model: root.library-facets;
                        current-index: -1;
                        accessible-label: @tr("Narrow by");
                        selected(v) => { root.library-facet(self.current-index); }
                    }
                    Button { text: @tr("Clear"); enabled: root.library-filter != ""; clicked => { root.library-clear-filters(); } }
                }
                Text { visible: root.library-filter != ""; text: @tr("Narrowed by ") + root.library-filter; color: Theme.graphite; font-size: Theme.font-label; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    DataTable {
                        horizontal-stretch: 1;
                        label: @tr("Library items");
                        columns: [{ title: @tr("Item"), horizontal-stretch: 1 }, { title: @tr("Kind"), width: 90px, min-width: 90px }];
                        rows: root.library-rows;
                        selected: root.library-selected;
                        picked(i) => { root.library-pick(i); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-width: 1px;
                        border-color: Theme.rule;
                        Text {
                            x: 8px; y: 8px;
                            width: parent.width - 16px;
                            text: root.library-preview == "" ? "Pick an item to see it here." : root.library-preview;
                            font-family: root.mono-font-family;
                            font-size: Theme.font-label;
                            color: Theme.ink;
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                            accessible-label: @tr("Preview");
                        }
                    }
                }
                SectionTitle { text: @tr("Catalogs (reference only)"); }
                HorizontalLayout {
                    spacing: 12px;
                    DataTable {
                        horizontal-stretch: 1;
                        label: @tr("Catalogs");
                        columns: [{ title: @tr("Catalog"), horizontal-stretch: 1 }, { title: @tr("Key"), width: 120px, min-width: 120px }];
                        rows: root.catalog-rows;
                        selected: root.catalog-selected;
                        picked(i) => { root.library-pick-catalog(i); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-width: 1px;
                        border-color: Theme.rule;
                        Text {
                            x: 8px; y: 8px;
                            width: parent.width - 16px;
                            text: root.catalog-preview == "" ? "Pick a catalog to see its source and terms." : root.catalog-preview;
                            font-size: Theme.font-label;
                            color: Theme.ink;
                            wrap: word-wrap;
                            accessible-role: AccessibleRole.text;
                            accessible-label: @tr("Catalog details");
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    ComboBox {
                        width: 250px;
                        model: ["As a new tree", "Under the selected gate", "In place of the selected step"];
                        current-index <=> root.library-mode;
                        accessible-label: @tr("Where to put it");
                    }
                    CheckBox { text: @tr("With the suggested ratings (marked for review)"); checked <=> root.library-ratings; }
                    CheckBox { text: @tr("Share steps the tree already has"); checked <=> root.library-share; }
                }
                Text {
                    visible: (root.library-mode == 1 && !root.library-can-gate) || (root.library-mode == 2 && !root.library-can-leaf);
                    text: root.library-mode == 1 ? "Select a gate of the tree on the canvas first." : "Select a step (not the root) of the tree on the canvas first.";
                    color: Theme.graphite;
                    font-size: Theme.font-label;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: @tr("Close"); clicked => { root.library-open = false; } }
                    Button {
                        text: @tr("Insert");
                        primary: true;
                        enabled: root.editing && root.library-selected >= 0 && (root.library-mode == 0 || (root.library-mode == 1 && root.library-can-gate) || (root.library-mode == 2 && root.library-can-leaf));
                        clicked => { root.library-insert(root.library-mode, root.library-ratings, root.library-share); root.library-open = false; }
                    }
                }
            }
            init => { lib-search.focus(); }
        }
    }

    if root.password-open: Rectangle {
        background: #000000A0;
        Rectangle {
            width: min(parent.width - 48px, 420px);
            height: pw-column.preferred-height + 40px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            pw-column := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: @tr("Change your password"); font-size: Theme.font-h1; font-weight: 700; color: Theme.ink; }
                Field { label: @tr("Current password"); LineEdit { input-type: password; text <=> root.pw-current; accessible-label: @tr("Current password"); } }
                Field { label: @tr("New password (at least 10 characters)"); LineEdit { input-type: password; text <=> root.pw-new; accessible-label: @tr("New password"); } }
                Field { label: @tr("New password again"); LineEdit { input-type: password; text <=> root.pw-repeat; accessible-label: @tr("New password again"); } }
                if root.pw-repeat != "" && root.pw-new != root.pw-repeat: FieldError { text: @tr("The two new passwords differ."); }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.password-open = false; } }
                    Button {
                        text: @tr("Change password");
                        primary: true;
                        enabled: root.pw-current != "" && root.pw-new != "" && root.pw-new == root.pw-repeat;
                        clicked => { root.change-password(root.pw-current, root.pw-new); root.password-open = false; root.pw-current = ""; root.pw-new = ""; root.pw-repeat = ""; }
                    }
                }
            }
        }
    }

    // Command palette: a transient popup. Escape closes it and focus returns
    // where it was (UI-01, job 081).
    if root.palette-open: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.close-palette(); } }
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.close-palette(); return accept; }
                if (!root.palette-shortcuts-open && root.palette-rows.length > 0) {
                    if (event.text == Key.DownArrow) {
                        root.palette-selected = root.palette-selected < 0
                            ? 0
                            : min(root.palette-selected + 1, root.palette-rows.length - 1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.palette-selected = root.palette-selected <= 0
                            ? 0
                            : root.palette-selected - 1;
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        root.run-palette-row(root.palette-selected);
                        return accept;
                    }
                }
                reject
            }
            Rectangle {
                width: min(parent.width - 48px, 640px);
                height: min(parent.height - 48px, 520px);
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.rule;
                border-radius: Theme.radius-panel;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: #00000059;
                TouchArea {}
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    palette-search := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: @tr("Search pages and commands");
                        text <=> root.palette-query;
                        accessible-label: @tr("Command palette");
                        edited(t) => { root.palette-query-changed(t); }
                        accepted(t) => { root.run-palette-row(root.palette-selected); }
                    }
                    if !root.palette-shortcuts-open: DataTable {
                        label: @tr("Commands");
                        columns: [{ title: @tr("Command"), horizontal-stretch: 2 }, { title: @tr("Shortcut"), width: 120px, min-width: 120px }];
                        rows: root.palette-rows;
                        selected: root.palette-selected;
                        picked(i) => { root.palette-pick(i); }
                    }
                    if root.palette-shortcuts-open: VerticalLayout {
                        Text { text: @tr("Keyboard shortcuts"); font-size: Theme.font-h1; font-weight: 700; color: Theme.ink; }
                        DataTable {
                            label: @tr("Keyboard shortcuts");
                            columns: [{ title: @tr("Action"), horizontal-stretch: 2 }, { title: @tr("Shortcut"), width: 140px, min-width: 140px }];
                            rows: root.shortcut-rows;
                            selected: -1;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: root.palette-shortcuts-open ? @tr("Back to commands") : @tr("Keyboard shortcuts");
                            clicked => { root.palette-show-shortcuts(); }
                        }
                        Button { text: @tr("Close"); clicked => { root.close-palette(); } }
                    }
                }
            }
            init => { palette-search.focus(); }
        }
    }

    // About: the Slint notice the license requires (decisions D7, D9).
    if root.show-about: Rectangle {
        background: #000000A0;
        TouchArea { clicked => { root.show-about = false; } }
        Rectangle {
            width: min(parent.width - 48px, 520px);
            height: about-splash.height + about-column.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.rule;
            border-radius: Theme.radius-panel;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                about-splash := SplashHeader {
                    banner-height: 148px;
                    status-text: @tr("CYBERSECURITY TARA");
                    status-color: Theme.crimson-bright;
                }
                about-column := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: @tr("Threat analysis and risk assessment for vehicle cybersecurity.");
                        color: Theme.ink;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: Theme.rule; }
                    AboutSlint { }
                    Text {
                        text: @tr("This application uses the Slint toolkit under the Slint Royalty-free License 2.0. Icons by Lucide (ISC license). Third-party licenses are listed in the release notices.");
                        color: Theme.graphite;
                        font-size: Theme.font-label;
                        wrap: word-wrap;
                    }
                    Button { text: @tr("Close"); clicked => { root.show-about = false; } }
                }
            }
        }
    }
}
