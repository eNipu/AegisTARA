// AegisTARA "Tactical Obsidian & Tungsten Crimson-Amber" color system.
// The canvas engine sends paint *tokens* (integers); this file turns them
// into colors, so switching between Tactical Obsidian (dark) and Brushed
// Platinum (light) is a palette switch here and costs the Rust side nothing.
// Tokens: aegis_canvas::Paint, see src/adapter.rs.
import { Palette } from "std-widgets.slint";

export global Theme {
    // Default to the signature Tactical Obsidian dark theme unless light mode
    // is explicitly selected.
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;

    // ---- Master Brand Tokens (always dark obsidian for splash/brand headers) ----
    // Obsidian Background: #14181D (center radial) -> #0B0D10 (outer edge)
    out property <color> obsidian-core: #14181D;
    out property <color> obsidian-edge: #0B0D10;
    out property <color> obsidian-wash: #1A2028;
    out property <color> obsidian-rule: #28313B;
    // "Aegis" & Telemetry Arcs (Brushed Platinum): #FFFFFF -> #E5E9F0 -> #B8C2CC
    out property <color> platinum-pure: #FFFFFF;
    out property <color> platinum: #E5E9F0;
    out property <color> platinum-dim: #B8C2CC;
    // "TARA" & Primary Reticle (Tungsten Crimson-Amber): #E04F26 -> #C83E1B -> #8F240C
    out property <color> crimson-bright: #E04F26;
    out property <color> crimson: #C83E1B;
    out property <color> crimson-deep: #8F240C;
    // Subtitle & Datum Lines (Tactical Slate): #CBD2D9 / #8C99A6
    out property <color> slate-light: #CBD2D9;
    out property <color> slate: #8C99A6;

    // ---- Adaptive Workspace Tokens ----
    out property <color> sheet: dark ? #0B0D10 : #EBEEF2;
    out property <color> panel: dark ? #14181D : #FFFFFF;
    out property <color> ink: dark ? #E5E9F0 : #14181D;
    out property <color> graphite: dark ? #8C99A6 : #5A6673;
    out property <color> rule: dark ? #28313B : #CBD2D9;
    out property <color> wash: dark ? #1C222B : #F2F4F7;
    out property <color> accent: dark ? #E04F26 : #C83E1B;
    out property <color> accent-wash: dark ? #2B1915 : #FCECE8;
    out property <color> band: dark ? #C83E1B : #14181D;
    out property <color> band-text: #FFFFFF;

    // Rating colors: Okabe-Ito based, high-contrast in both themes.
    out property <color> very-low: #009E73;
    out property <color> low: #56B4E9;
    out property <color> medium: #E69F00;
    out property <color> high: #D55E00;

    // ---- Typography System (Clean, Bold, High-Assurance Engineering) ----
    out property <length> font-display: 22px;
    out property <length> font-h1: 18px;
    out property <length> font-h2: 15px;
    out property <length> font-body: 13px;
    out property <length> font-label: 12px;
    out property <length> font-caption: 11px;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
    out property <int> weight-heavy: 800;
    out property <length> tracking-tight: -0.2px;
    out property <length> tracking-label: 0.3px;
    out property <length> tracking-header: 0.6px;

    // Paint tokens from the canvas engine (src/adapter.rs keeps the numbers).
    pure public function paint(token: int) -> color {
        if (token == 0) { return sheet; }
        if (token == 1) { return panel; }
        if (token == 2) { return ink; }
        if (token == 3) { return graphite; }
        if (token == 4) { return rule; }
        if (token == 5) { return wash; }
        if (token == 6) { return accent; }
        if (token == 7) { return accent-wash; }
        if (token == 9) { return very-low; }
        if (token == 10) { return low; }
        if (token == 11) { return medium; }
        if (token == 12) { return high; }
        // 8: not rated, and anything unknown.
        return rule;
    }

    // Rating buckets as used by the lists (0 = not rated, 1..4 = very low..high).
    pure public function tone(bucket: int) -> color {
        if (bucket == 1) { return very-low; }
        if (bucket == 2) { return low; }
        if (bucket == 3) { return medium; }
        if (bucket == 4) { return high; }
        return rule;
    }
}
