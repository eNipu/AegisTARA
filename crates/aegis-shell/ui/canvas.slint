// The attack tree canvas.
//
// It draws a display list from the canvas engine as it is: rectangles,
// paths, and text in screen coordinates. Pan and zoom are already applied in
// Rust, so nothing here transforms (Slint has no transforms, and needs none).
import { Theme } from "theme.slint";

export struct DrawItem {
    // 0 rectangle, 1 path, 2 text
    kind: int,
    x: length,
    y: length,
    w: length,
    h: length,
    // Paint tokens; -1 for none.
    fill: int,
    stroke: int,
    stroke-width: length,
    radius: length,
    // SVG path data for kind 1.
    commands: string,
    text: string,
    size: length,
    bold: bool,
    align-end: bool,
}

export component Canvas inherits Rectangle {
    in property <[DrawItem]> items;
    in property <string> accessible-summary;

    callback pointer-down(length, length);
    callback pointer-move(length, length);
    callback pointer-up(length, length);
    // x, y, scroll delta (positive = away from the user)
    callback scrolled(length, length, float);
    // key text, shift held; returns whether the key was used
    callback key(string, bool) -> bool;
    callback resized(length, length);

    background: Theme.sheet;
    clip: true;
    accessible-role: none;
    accessible-label: root.accessible-summary;

    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
    init => { root.resized(self.width, self.height); }

    // Edges first in the list, so they are drawn first (underneath).
    for item in root.items: Path {
        visible: item.kind == 1;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: item.kind == 1 ? item.commands : "";
        fill: transparent;
        stroke: item.stroke >= 0 ? Theme.paint(item.stroke) : transparent;
        stroke-width: item.stroke-width;
    }

    for item in root.items: Rectangle {
        visible: item.kind == 0;
        x: item.x;
        y: item.y;
        width: item.w;
        height: item.h;
        background: item.fill >= 0 ? Theme.paint(item.fill) : transparent;
        border-radius: item.radius;
        border-width: item.stroke >= 0 ? item.stroke-width : 0px;
        border-color: item.stroke >= 0 ? Theme.paint(item.stroke) : transparent;
    }

    for item in root.items: Text {
        visible: item.kind == 2;
        x: item.align-end ? item.x - 400px : item.x;
        // The engine gives the baseline; Slint places the top of the text.
        y: item.y - item.size * 0.95;
        width: 400px;
        height: item.size * 1.3;
        text: item.kind == 2 ? item.text : "";
        font-size: item.size;
        font-weight: item.bold ? 700 : 400;
        color: Theme.paint(item.fill);
        horizontal-alignment: item.align-end ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        vertical-alignment: top;
        overflow: clip;
        wrap: no-wrap;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (root.key(event.text, event.modifiers.shift)) {
                accept
            } else {
                reject
            }
        }
        TouchArea {
            pointer-event(e) => {
                if (e.button == PointerEventButton.left) {
                    if (e.kind == PointerEventKind.down) {
                        focus.focus();
                        root.pointer-down(self.mouse-x, self.mouse-y);
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        root.pointer-up(self.mouse-x, self.mouse-y);
                    }
                }
            }
            moved => { root.pointer-move(self.mouse-x, self.mouse-y); }
            scroll-event(e) => {
                root.scrolled(self.mouse-x, self.mouse-y, e.delta-y / 1px);
                accept
            }
        }
    }
}
